@using Microsoft.Extensions.Configuration
@using Microsoft.Graph;
@using TeszterLibrary.Components.Teszt

@inject IConfiguration Configuration
@inject NavigationManager MyNavigationManager
@inject QuestionServices qService
@inject SubjectServices sServive
@inject IToastService toastService
@inject ILogger<WelcomeTeacher> logger
@inject IJSRuntime _jsRuntime
@inject TeamsUserCredential teamsUserCredential

@if (isLoading)
{
	<div style="display: flex; justify-content: center; align-items: center; min-height: 100vh;">
		<FluentProgressRing/>
	</div>
}
else
{
	@*<div class="welcome page">
		<div class="narrow page-padding">*@
			<FluentTabs Orientation="Orientation.Vertical" Style="width: 90%; justify-content: space-between; margin: 1rem auto;" @bind-ActiveTabId="@activeTabId">
                <FluentTab Id="Questions" Style="font-size: 16px; min-height:36px;" Label="Kérdések">
                    <div hidden="@(!newOrEdit)">
                        @*<FluentAccordion>
        <FluentAccordionItem Heading="Szűrő">
             <QuestionFilter @bind-Questions="Questions" />
                        </FluentAccordionItem>
                        </FluentAccordion>*@
                        <TestQuestions UserId=Guid.Parse(UserId) questions="Questions" Delete="DeleteQuestion" Update="Update" AddTest="AddTestQ"></TestQuestions>
                        <button class="btn btn-outline-primary" @onclick=NewQuestion>Új kérdés</button>
                    </div>
                    <div hidden="@newOrEdit">
                        <QuestionNewEdit newQuestion="TempQuestion" subjects="Subjects" New=isNew Save="Save" SubjectsSave="SaveSubject" Cancel="()=>newOrEdit=true" />
                    </div>
                </FluentTab>
                    <FluentTab Id="newTeszt" Label="Teszt készítés">
                        @if (TestQuestion.Count > 0)
                        {
                            <FluentBadge Circular=true> @TestQuestion.Count</FluentBadge>
                        }
                        @if (publish)
                        {
							<PublicTestInTeams Teszt="newTest" UserId="@UserId" Published="@(() => { publish = false; activeTabId = "Questions"; })"></PublicTestInTeams>
                        }
                        else
                        {
                            <AddTest questions="Questions" subjects="Subjects" TesztQ="TestQuestion" UserId="@UserId" Publish="PublishTest" />
                        }
                    </FluentTab>
				<FluentTab Id="pub" Label="Közzététel" Disabled="@(!publish)">
					<FluentLabel>Ez a közzététel</FluentLabel>
				</FluentTab>
				<FluentTab Id="proba" Label="Próba">
					<FluentButton OnClick="Tabchange">Váltás</FluentButton>
					<FluentSwitch Value="@publish" ValueChanged="e=>Tabchange(e)"></FluentSwitch>
				</FluentTab>
                <FluentTab Id="Tesztek" Label="Tesztek" >
					<TestViewer UserId="@UserId"/>
                    </FluentTab>
                <FluentTab Id="gyak" Label="Matematika gyakorló">
                    <Deploy /><Publish />
                </FluentTab>
			</FluentTabs>
		@*</div>
	</div>*@
}

@code {
	[Parameter] public string UserId { get; set; }
	string errorMessage = string.Empty, activeTabId="Questions";
	bool isLoading = true, newOrEdit = true, isNew = false, showDelete = false, publish = false;
	public List<Question> Questions = new();
	private List<Subject> Subjects = new();
	Dictionary<string, string> valuePairs = new();
	private List<string> titles = new();
	private Question TempQuestion { get; set; } = new();
	private List<Question> TestQuestion = new();
	private readonly string _scope = "User.Read EduRoster.ReadBasic";
	Test newTest = new();
	GraphServiceClient GraphClient;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await RefreshQuestions();
			Subjects = await sServive.GetSubjects();
			isLoading = false;
			GraphClient = new GraphServiceClient(teamsUserCredential);
			await base.OnAfterRenderAsync(firstRender);
			StateHasChanged();
		}
	}
	private async Task RefreshQuestions()
	{
		if (UserId == null)
		{
			Questions = await qService.GetQuestions();
		}
		else Questions = await qService.GetQuestions(Guid.Parse(UserId));
		if (Questions == null)
		{
			toastService.ShowError($"Hiba történt: {qService.Error}");
			errorMessage = qService.Error;
			StateHasChanged();
		}
	}
	private void DeleteQuestion(Question question)
	{
		showDelete = true;
		TempQuestion = question;
		StateHasChanged();
	}
	private async Task DeleteQ()
	{
		try
		{
			await qService.DeleteQuestionAsync(TempQuestion);
			showDelete = false;
			toastService.ShowInfo($"A következő kérdés törlésre került: {TempQuestion.Text}");
			logger.LogInformation("A következő kérdés törlésre került: {TempQuestion.Text}",TempQuestion.Text);
			await RefreshQuestions();
		}
		catch (Exception ex)
		{
			logger.LogError(ex, ex.Message, ex.StackTrace);
		}
	}
	private void NewQuestion()
	{
		isNew = true;
		newOrEdit = false;
		TempQuestion = new();
	}
	private void Update(Question question)
	{
		isNew = false;
		newOrEdit = false;
		TempQuestion = question;
	}
	private void AddTestQ(Question question)
	{
		TestQuestion.Add(question);
	}
	private async Task Save(Question question)
	{
		if (isNew)
		{
			try
			{
				question.Id = Guid.NewGuid();
				question.CreatedBy = Guid.Parse(UserId);
				foreach (var item in question.Answers)
				{
					item.QuestionId = question.Id;
				}
				var q = await qService.AddQuestionAsync(question);
				if (q == null)
				{
					errorMessage = "Nem sikerült elmenteni a kérdést!";
				}
				else
				{
					Questions.Add(question);
					newOrEdit = true;
					errorMessage = "Kérdés mentése sikerült!";
				}
				logger.LogInformation(errorMessage);
			}
			catch (Exception ex)
			{
				toastService.ShowError($"Hiba történt: {ex.Message}");
				logger.LogError(ex, ex.Message, ex.StackTrace);
			}
		}
		else
		{
			try
			{
				var q = await qService.UpdateQuestionAsync(question);
				if (q == null)
				{
					toastService.ShowError("Nem sikerült elmenteni a módosításokat!");
					errorMessage = "Nem sikerült elmenteni a módosításokat!";
				}
				else
				{
					newOrEdit = true;
					toastService.ShowSuccess("Módosítások mentése sikerült!");
					errorMessage = "Módosítások mentése sikerült!";
				}
				logger.LogInformation(errorMessage);
			}
			catch (Exception ex)
			{
				toastService.ShowError($"Hiba történt: {ex.Message}");
				logger.LogError(ex, ex.Message, ex.StackTrace);
			}
		}
	}
	private async Task SaveSubject(string name)
	{
		try
		{
			var s = await sServive.AddSubjectsAsync(new Subject() { Name = name });
			if (s == null)
			{
				toastService.ShowError("Nem sikerült elmenteni a tantárgyat!");
				errorMessage = "Nem sikerült elmenteni a tantárgyat!";
			}
			else
			{
				Subjects.Add(s);
				TempQuestion.Subject = s.Name;
				toastService.ShowSuccess("Sikerült elmenteni a tantárgyat.");
			}
		}
		catch (Exception ex)
		{
			toastService.ShowError($"Hiba történt: {ex.Message}");
			logger.LogError(ex, ex.Message, ex.StackTrace);
		}
	}
	private void CloseModal()
	{
		errorMessage = string.Empty;
		showDelete = false;
		StateHasChanged();
	}
	private async void PublishTest(Test newT)
	{
		newTest = newT;
		if (newT is not null)
		{
			publish = true;
			StateHasChanged();
		}
		//await _jsRuntime.InvokeVoidAsync("open", "lesson", "_blank");
	}
	private void Tabchange()
	{
		activeTabId = "gyak";
	}
	private void Tabchange(bool value)
	{
		publish = value;
		StateHasChanged();
	}
}

