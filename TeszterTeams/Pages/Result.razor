@page "/Result"
@inject MathService mService
@inject NavigationManager NavigationManager
@inject TeamsUserCredential teamsUserCredential
@inject MicrosoftTeams MicrosoftTeams
@if(isLoading)
{
	<div style="display: flex; justify-content: center; align-items: center; min-height: 100vh;">
		<FluentProgressRing/>
	</div>
}
else
{
	<div style="padding:5px 0" hidden="@IsTaskView">
		<StudentResult studentViews="resultStudentViews" Click="ViewTask"></StudentResult>
	</div>
	<div style="padding:5px 0" hidden="@(!IsTaskView)">
		<TaskResult taskViews="resultTaskViews"></TaskResult>
		<button class="btn" @onclick="GoBack">Vissza...</button>
	</div>
}
@code {
	private List<ResultStudentView> resultStudentViews = new();
	private List<ResultTaskView> resultTaskViews = new();
	private Guid UserId;
	private bool IsTaskView = false, isLoading = true, isInTeams;
	private string message = "A kitüzött feladat: ", errorMessage = string.Empty, userName;
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			isInTeams = await MicrosoftTeams.IsInTeams();
			if (isInTeams)
			{
				var user = await teamsUserCredential.GetUserInfoAsync();
				userName = user.DisplayName;
				UserId = Guid.Parse(user.ObjectId);
				resultStudentViews.Clear();
				var response = await mService.ResultStudentViews(UserId.ToString());
				if (response != null)
				{
					resultStudentViews = response;
				}
				//await ViewTask(resultStudentViews[0].CompletTaskId);
			}
			else
			{
				errorMessage = "Not running in Microsoft Teams.";
			}

			isLoading = false;
			StateHasChanged();
		}
		return;
	}
	private async Task ViewTask(int taskId)
	{
		IsTaskView = true;
		resultTaskViews.Clear();
		var response = await mService.ResultTaskViews(taskId);
		if (response != null)
		{
			resultTaskViews = response;
		}
		StateHasChanged();
	}
	private void GoBack() => IsTaskView = false;
}
