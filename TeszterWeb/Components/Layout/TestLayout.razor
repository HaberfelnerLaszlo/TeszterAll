@inherits LayoutComponentBase
<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Content">
        <div class="content">
            @Body
        </div>
    </FluentLayoutItem>
</FluentLayout>
<FluentProviders />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
