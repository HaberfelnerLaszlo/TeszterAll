@rendermode InteractiveServer

<nav>
    <FluentNav Width="250px" aria-label="Teszter menü">
        <FluentNavItem Href="/home" Match="NavLinkMatch.All" IconRest="@Icon.FromImageUrl("/images/home.svg")">Kezdőlap</FluentNavItem>
        <AuthorizeView Roles="Teacher">
            <FluentDivider Style="width: 100%;" />
            <FluentNavItem Href="/newtest" Match="NavLinkMatch.All" IconRest="@Icon.FromImageUrl("/images/test_new.svg")" Tooltip="Új">Új teszt</FluentNavItem>
            <FluentNavItem Href="/active" Match="NavLinkMatch.All" IconRest="@Icon.FromImageUrl("/images/test_open.svg")" Tooltip="Aktív">Aktív teszt</FluentNavItem>
            <FluentNavItem Href="/closed" Match="NavLinkMatch.All" IconRest="@Icon.FromImageUrl("/images/test_closed.svg")" Tooltip="Befejezett">Befejezett teszt</FluentNavItem>
            <FluentNavItem Href="/draft" Match="NavLinkMatch.All" IconRest="@Icon.FromImageUrl("/images/test_draft.svg")" Tooltip="Piszkozat">Piszkozat teszt</FluentNavItem>
            <FluentNavItem Href="/usermanagment">Manage_User</FluentNavItem>
            @*<FluentNavItem Href="/question" Match="NavLinkMatch.All" IconRest="@Icon.FromImageUrl("/images/subject.svg")" Tooltip="Tantárgy">Tantárgyak</FluentNavItem>*@
            <FluentDivider Style="width: 100%;" />
        </AuthorizeView>
        <AuthorizeView Roles="Student">
            <FluentNavItem Href="/studenttests" IconRest="@Icon.FromImageUrl("/images/test_open.svg")" Tooltip="Tesztjeim">Tesztjeim</FluentNavItem>
            <FluentNavItem Href="/student/testsResult" IconRest="@Icon.FromImageUrl("/images/test_closed.svg")" Tooltip="Eredmények">Tesztek eredményei</FluentNavItem>
            <FluentDivider Style="width: 100%;" />
            <FluentNavItem Href="/student/math" IconRest="@Icon.FromImageUrl("/images/math-gyak.svg")" Tooltip="Matematika gyakorló program">Matematika gyakorló</FluentNavItem>
        </AuthorizeView>
    </FluentNav>
</nav>
