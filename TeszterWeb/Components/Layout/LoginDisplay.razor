@using Microsoft.Graph.Models
@inject Microsoft.Graph.GraphServiceClient GraphServiceClient
@inject EduUserServices uService
@inject IToastService ToastService
@inject TeszterWeb.Data.GlobalData data
@inject ILogger<LoginDisplay> logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <FluentProfileMenu ImageInitials="@Initials(DisplayName(context))" Title="Felhasználói menü">
            <div class="profile-card">
                <FluentAvatar Name="@DisplayName(context)" Initials="@Initials(DisplayName(context))" Size="AvatarSize.Size48" />
                <div class="profile-card__id">
                    <FluentText Weight="TextWeight.Semibold">@DisplayName(context)</FluentText>
                    <FluentText Size="TextSize.Size200" Class="profile-card__mail">@context.User.Identity?.Name</FluentText>
                </div>
            </div>
            <div class="profile-card__actions">
                <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.PersonCircle())" OnClick="@(() => Navigation.NavigateTo("/profile"))">Profilom</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.SignOut())" OnClick="SignOut">Kijelentkezés</FluentButton>
            </div>
        </FluentProfileMenu>
    </Authorized>
    <NotAuthorized>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SignIn">Belépés</FluentButton>
    </NotAuthorized>
</AuthorizeView>
@code{
    // Megjelenített név: Graph-ból kapott név → a token "name" claimje → bejelentkezési név (UPN).
    private string DisplayName(AuthenticationState context) =>
        !string.IsNullOrEmpty(Nev) ? Nev
        : context.User.FindFirst("name")?.Value ?? context.User.Identity?.Name ?? string.Empty;

    // Monogram a megjelenített névből (pl. "Kovács Anna" → "KA").
    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    private void SignOut() => Navigation.NavigateTo("MicrosoftIdentity/Account/SignOut", forceLoad: true);
    private void SignIn() => Navigation.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);

    EducationUser? user;
    private bool isAuthenticated;

    private string Nev = string.Empty;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || string.IsNullOrEmpty(Nev))
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState is null)
            {
                return;
            }
            isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
            Nev = data.UserName ?? string.Empty;
            if (!string.IsNullOrEmpty(Nev))
            {
                StateHasChanged();
            }
            else if(isAuthenticated)
            {
                try
                {
                    if (user is not null)
                    {
                        if (user.Id is null)
                        {
                            ToastService.ShowError("Nem található felhasználó azonosító!");
                            logger.LogError("Nem található felhasználó azonosító!");
                            return;
                        }
                        data.UserId = user.Id;
                        data.UserName = user.DisplayName;
                        Nev = user.DisplayName ?? string.Empty;
                        if (data.UserGuid is Guid userGuid && !(await uService.UserExits(userGuid)))
                        {
                            if (string.IsNullOrEmpty(uService.ErrorMessage))
                            {
                                await uService.AddUser(new EduUser() { DisplayName = user.DisplayName ?? "NoName", Id = userGuid, Role = user.PrimaryRole.Value.ToString() ?? EducationUserRole.Student.ToString() });
                            }
                        }
                        StateHasChanged();
                    }
                }
                catch (Exception ex)
                {
                    ToastService.ShowError("Hiba történt a felhasználó lekérdezésekor.");
                    logger.LogError(ex, "Hiba történt a felhasználó lekérdezésekor.");
                    return;
                }
            }

        }
    }
}
