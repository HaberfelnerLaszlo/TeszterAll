@inherits LayoutComponentBase
@inject IToastService toastService
@inject TeszterApiService apiService
@inject GlobalData data
<FluentLayout>
    <FluentHeader>
        @data.Title
        <FluentStack HorizontalAlignment="HorizontalAlignment.End" Width="95%">
            <LoginDisplay />
        </FluentStack>
    </FluentHeader>
    <FluentStack Class="main" Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" Width="100%">
        <NavMenu />
        <FluentBodyContent>
            <div class="content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>
    <FluentFooter>
        <div id="version">
            <span>
                Verzió: 0.8.6
            </span>
            <FluentTooltip Anchor="version">
                2026.01.25
            </FluentTooltip>
        </div>
    </FluentFooter>
</FluentLayout>
<FluentDialogProvider />
<FluentToastProvider MaxToastCount="10" Position="ToastPosition.BottomRight"/>
<FluentTooltipProvider />
<FluentMenuProvider />
<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
@code{
    private string Title = string.Empty;
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender || string.IsNullOrEmpty(Title)) {
            Title = data.Title ?? string.Empty;
            if (apiService != null)
            {
                apiService.OnMessageReceived += OnMessageReceived;
            }
        }
        base.OnAfterRender(firstRender);
    }
    private void OnMessageReceived(object? sender, MessageEvent e)
    {
            // Show the message in a toast notification
            toastService?.ShowError(e.Message);
    }
    // private void Dispose()
    // {
    //     if (apiService != null)
    //     {
    //         apiService.OnMessageReceived -= OnMessageReceived;
    //     }
    // }
}
