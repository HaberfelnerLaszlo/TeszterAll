@inherits LayoutComponentBase
@inject IToastService toastService
@inject TeszterApiService apiService
@inject GlobalData data
<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <div class="app-header">
            @* v5: 768px alatt a navigáció rejtett, a hamburger gomb nyitja meg *@
            <FluentLayoutHamburger PanelHeader="Teszter" />
            <a class="app-brand" href="/home">
                <FluentIcon Value="@(new Icons.Regular.Size24.ClipboardCheckmark())" />
                <span>Teszter</span>
            </a>
            @if (!string.IsNullOrEmpty(data.Title))
            {
                <span class="app-header__title">· @data.Title</span>
            }
            <FluentSpacer />
            <span class="app-header__action"><ThemeToggle /></span>
            <LoginDisplay />
        </div>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Navigation" Width="260px">
        <NavMenu />
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content">
        <main class="content">
            @Body
        </main>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Footer">
        <div class="app-footer">
            <span id="version">Verzió 0.9.0</span>
            <FluentTooltip Anchor="version">2026.11.22</FluentTooltip>
        </div>
    </FluentLayoutItem>
</FluentLayout>
<FluentProviders />
<div id="blazor-error-ui">
    Váratlan hiba történt.
    <a href="" class="reload">Újratöltés</a>
    <a class="dismiss">🗙</a>
</div>
@code{
    private string Title = string.Empty;
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender || string.IsNullOrEmpty(Title)) {
            Title = data.Title ?? string.Empty;
            if (apiService != null)
            {
                apiService.OnMessageReceived += OnMessageReceived;
            }
        }
        base.OnAfterRender(firstRender);
    }
    private void OnMessageReceived(object? sender, MessageEvent e)
    {
            // Show the message in a toast notification
            toastService?.ShowError(e.Message);
    }
    // private void Dispose()
    // {
    //     if (apiService != null)
    //     {
    //         apiService.OnMessageReceived -= OnMessageReceived;
    //     }
    // }
}
