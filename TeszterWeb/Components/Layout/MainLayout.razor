@inherits LayoutComponentBase
@inject GlobalData data
<FluentLayout>
    <FluentHeader>
        @data.Title
        <FluentStack HorizontalAlignment="HorizontalAlignment.End" Width="70%">
            <LoginDisplay />
        </FluentStack>
    </FluentHeader>
    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        <NavMenu />
        <FluentBodyContent>
            <div class="content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>
    <FluentFooter>
        <div id="version">
            <span>
                Verzió: 0.5.1
            </span>
            <FluentTooltip Anchor="version">
                2025.01.22
            </FluentTooltip>
        </div>
    </FluentFooter>
</FluentLayout>
<FluentDialogProvider />
<FluentToastProvider MaxToastCount="10" />
<FluentTooltipProvider />
<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
