@inherits LayoutComponentBase
@inject IToastService toastService
@inject TeszterApiService apiService
@inject GlobalData data
<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        @data.Title
        <FluentSpacer />
        <LoginDisplay />
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Navigation" Width="250px">
        <NavMenu />
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content">
        <div class="content">
            @Body
        </div>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Footer">
        <div id="version">
            <span>
                Verzió: 0.8.6
            </span>
            <FluentTooltip Anchor="version">
                2026.01.25
            </FluentTooltip>
        </div>
    </FluentLayoutItem>
</FluentLayout>
<FluentProviders />
<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
@code{
    private string Title = string.Empty;
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender || string.IsNullOrEmpty(Title)) {
            Title = data.Title ?? string.Empty;
            if (apiService != null)
            {
                apiService.OnMessageReceived += OnMessageReceived;
            }
        }
        base.OnAfterRender(firstRender);
    }
    private void OnMessageReceived(object? sender, MessageEvent e)
    {
            // Show the message in a toast notification
            toastService?.ShowError(e.Message);
    }
    // private void Dispose()
    // {
    //     if (apiService != null)
    //     {
    //         apiService.OnMessageReceived -= OnMessageReceived;
    //     }
    // }
}
