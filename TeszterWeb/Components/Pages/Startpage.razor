@page "/start/{number}"
@using Microsoft.AspNetCore.Components
@using Microsoft.Identity.Web
@using Microsoft.Graph.Models
@inject Microsoft.Graph.GraphServiceClient GraphServiceClient
@inject MicrosoftIdentityConsentAndConditionalAccessHandler ConsentHandler
@inject EduUserServices uService
@inject TestServices tService
@inject GlobalData data
@inject IToastService toastService
@inject NavigationManager NavigationManager
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Teszt kezdete</PageTitle>
<AuthorizeView>
    <Authorized>
        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
            <h4>Üdvözöllek @(user?.DisplayName ?? "Ismeretlen")!</h4>
            <hr />
            <FluentLabel>@(test?.Subject ?? string.Empty) tantárgyból egy tesztet készítettek Neked!</FluentLabel>
        </FluentStack>
</Authorized>
    <NotAuthorized>
        Nincs bejelentkezve!
        <TeszterWeb.Components.Layout.LoginDisplay />
    </NotAuthorized>
</AuthorizeView>
@code{
    [Parameter] public string Number { get; set; } = string.Empty;
    EducationUser? user;
    Test? test = new();
    int testId = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            data.Title = "Teszt kezdete";
            //var sz = Number.Remove(Number.Length - 4);
            var testId = int.Parse(Number);
            if (testId > 0)
            {
                test = await tService.GetTest(testId);
            }
        else
                {
                    toastService.ShowError($"Nincs ilyen teszt! Azonosító: {Number}");
                
                    return;
                }
            if (test is null || test.EndTime < DateTime.Today)
            {
                toastService.ShowWarning("Nincs ilyen teszt vagy lejárt!");
                return;
            }
            data.Test = test;
            user = await GraphServiceClient.Education.Me.GetAsync();
            if (user is not null)
            {
                data.UserId = user.Id ?? Guid.Empty.ToString();
                if (!(await uService.UserExits(Guid.Parse(data.UserId))))
                {
                    if (string.IsNullOrEmpty(uService.ErrorMessage))
                    {
                        await uService.AddUser(new EduUser() { DisplayName = user.DisplayName ?? "NoName", Id = Guid.Parse(data.UserId), Role = user.PrimaryRole.Value.ToString() ?? EducationUserRole.Student.ToString() });
                    }
                }
                var id = test.TestUsers.FirstOrDefault(t => t.UserId.ToString() == user.Id)?.Id ?? 0;
                if (id > 0)
                {
                    NavigationManager.NavigateTo($"/runtest/{id}");
                }
                else
                {
                    toastService.ShowError("A teszthez nincs hozzáférése!");
                    await Task.Delay(5000);
                    NavigationManager.NavigateTo("/home");
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ConsentHandler.HandleException(ex);
        }
    }
}