@page "/start/{number:int}"
@using Microsoft.AspNetCore.Components
@using Microsoft.Identity.Web
@using Microsoft.Graph.Models
@inject Microsoft.Graph.GraphServiceClient GraphServiceClient
@inject MicrosoftIdentityConsentAndConditionalAccessHandler ConsentHandler
@inject EduUserServices uService
@inject TestLoader loader
@inject GlobalData data
@inject IToastService toastService
@inject NavigationManager NavigationManager
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Teszt kezdete</PageTitle>
<AuthorizeView>
    <Authorized>
        <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
            <h4>Üdvözöllek @(user?.DisplayName ?? "Ismeretlen")!</h4>
            <hr />
            <FluentText Block="true">@(view?.Subject ?? string.Empty) tantárgyból egy tesztet készítettek Neked!</FluentText>
        </FluentStack>
</Authorized>
    <NotAuthorized>
        Nincs bejelentkezve!
        <TeszterWeb.Components.Layout.LoginDisplay />
    </NotAuthorized>
</AuthorizeView>
@code{
    [Parameter] public int Number { get; set; }   // :int megkötés: nem szám útvonalra 404, nem kivétel
    EducationUser? user;
    TestView? view;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            data.Title = "Teszt kezdete";
            user = await GraphServiceClient.Education.Me.GetAsync();
            if (user is not null)
            {
                data.UserId = user.Id ?? Guid.Empty.ToString();
                if (data.UserGuid is Guid userGuid && !(await uService.UserExits(userGuid)))
                {
                    if (string.IsNullOrEmpty(uService.ErrorMessage))
                    {
                        await uService.AddUser(new EduUser() { DisplayName = user.DisplayName ?? "NoName", Id = userGuid, Role = user.PrimaryRole!.Value.ToString() ?? EducationUserRole.Student.ToString() });
                    }
                }
                // A diák saját tesztlistájából (nem a teljes tesztből, amely a társai azonosítóit is tartalmazta).
                var found = await loader.FindStudentTestAsync(Number, DateTime.Today);
                view = found.Value;
                if (found.Ok)
                {
                    NavigationManager.NavigateTo($"/runtest/{found.Value!.TestUserId}");
                }
                else
                {
                    toastService.ShowError(found.Error!);
                    await Task.Delay(5000);
                    NavigationManager.NavigateTo("/home");
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ConsentHandler.HandleException(ex);
        }
    }
}