@page "/counter"
@using Blazored.TextEditor
@inject IToastService ToastService
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<AuthorizeView>
    <PageTitle>Counter</PageTitle>

    <h1>Counter</h1>

    <p role="status">Current count: <FluentBadge Appearance="Appearance.Neutral">@currentCount</FluentBadge></p>
    <p>@uzenet</p>
    <FluentButton Appearance="Appearance.Accent" @onclick="IncrementCount">Click me</FluentButton>
</AuthorizeView>
<DragAndDropTest />
<RichTextEditorWithImage Context="Ez egy példa mondat." />
<BlazoredTextEditor @ref="textEditor" Placeholder="Ide írd a szöveget...">
    <ToolbarContent>
        <span class="ql-formats">
            <button class="ql-bold"></button>
            <button class="ql-italic"></button>
            <button class="ql-underline"></button>
            @*<button class="ql-image"></button>*@
        </span>
    </ToolbarContent>
    <EditorContent>
        <span>@((MarkupString)body)</span>
        <h4>This Toolbar works with HTML</h4>
        <a href="http://BlazorHelpWebsite.com">
            BlazorHelpWebsite.com
        </a>
    </EditorContent>
</BlazoredTextEditor>

<NavigationLock ConfirmExternalNavigation="true" OnBeforeInternalNavigation="ConfirmNav" />
@code {
    private BlazoredTextEditor textEditor=new();

    private int currentCount = 0;
    string body = """"Ez egy példa mondat."""";
    string uzenet = string.Empty;
    private void IncrementCount()
    {
        currentCount++;
    }
    void ConfirmNav(LocationChangingContext context)
    {
        uzenet = context.TargetLocation;
        ToastService.ShowInfo(uzenet);
        ToastService.ShowToast(ToastIntent.Info, uzenet, 5000);
        Task.Delay(5000);
    }
}