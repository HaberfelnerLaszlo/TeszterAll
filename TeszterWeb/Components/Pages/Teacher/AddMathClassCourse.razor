@page "/AddClassCourse"
@inject NavigationManager NavigationManager
@inject GraphService graphService
@inject GlobalData data
@inject MathService mService
@inject EduUserServices uService
@inject GroupsService gService
@inject IToastService ToastService
@inject ILogger<AddMathClassCourse> _logger
<PageHeader Title="Matek gyakorlás osztálynak" Description="Válassz osztályt, majd add meg, melyik témakörből és mértékegységből hány feladatot kapjanak a tanulók." />

@if (loading)
{
    <LoadingState Text="Osztályok betöltése..." />
}
else if (Groups is null || Groups.Count == 0)
{
    <EmptyState Title="Nincsenek osztályaid" Message="Csak a Teamsben hozzád rendelt osztályoknak adhatsz ki feladatot." Icon="@(new Icons.Regular.Size24.PeopleTeam())">
        <FluentButton OnClick="@(() => NavigationManager.NavigateTo("/home"))">Vissza a kezdőlapra</FluentButton>
    </EmptyState>
}
else
{
    <FluentCard Class="section">
        <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Bottom" Wrap="true">
            <FluentSelect TOption="Microsoft.Graph.Models.EducationClass" TValue="string" Items="Groups" Label="Osztály"
                          OptionText="@(i => i?.DisplayName ?? string.Empty)" OptionValue="@(i => i?.Id)"
                          ValueChanged="@((string? id) => SelectGroup(id ?? string.Empty))" Placeholder="Válassz osztályt..." Width="280px" />
            <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.DatabaseArrowUp())" OnClick="AddGroupDb" Disabled="@(ClassId == Guid.Empty)"
                          Title="Az osztály felvétele/frissítése az adatbázisban">Osztály felvétele</FluentButton>
        </FluentStack>
    </FluentCard>

    @if (ClassId == Guid.Empty)
    {
        <EmptyState Title="Válassz osztályt" Message="Az osztály kiválasztása után itt állíthatod be a feladatokat." Icon="@(new Icons.Regular.Size24.PeopleTeam())" />
    }
    else
    {
        <AddClassLesson ClassId="ClassId" Lessons="Lessons" SaveTask="SaveClass" />
    }
}

@code {
    private List<Microsoft.Graph.Models.EducationClass>? Groups = new List<Microsoft.Graph.Models.EducationClass>();
    private List<TeszterLibrary.Model.ClassLesson> Lessons = new();
    private string SelectGroupId = string.Empty;
    private bool BtnDidabled = false, IsCompletMember = false, IsClass = false;
    private Guid ClassId;
    private bool loading = true;
    protected override void OnInitialized() => data.Title = "Matek gyakorlás osztálynak";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (string.IsNullOrEmpty(data.UserId))
            {
                try
                {
                    var user = await graphService.GetMe();
                    if (user is not null)
                    {
                        data.UserId = user.Id.ToString(); // ??= throw new ArgumentNullException(nameof(user));
                    }
                }
                catch (Exception ex)
                {
                    ToastService.ShowError($"Hiba történt a UserId lekérésekor: {ex.Message}");
                    _logger.LogError(ex, "Hiba történt a UserId lekérésekor: {ex.Message}", ex.Message);
                }

            }
            Groups = await graphService.GetClasses(data.UserId!); //Az osztályok lekérése
            if (Groups is null || Groups.Count == 0)
            {
                _logger.LogWarning("Nincsenek osztályai a tanárnak.");
                loading = false;
                StateHasChanged();
                return;
            }
            // Egymás után (nem ForEach(async ...)-kal, ami async void volt, és párhuzamosan írt az adatbázisba).
            foreach (var g in Groups)
            {
                if (Guid.TryParse(g.Id, out var groupId))
                {
                    await gService.EnsureGroupAsync(new Group(groupId, g.DisplayName ?? string.Empty, g.Description));
                }
            }
            loading = false;
            StateHasChanged();
        }
    }
    private async Task SelectGroup(string id)
    {
        if (id.ToGuidOrNull() is Guid classId)
        {
            SelectGroupId = id;
            ClassId = classId;
            Lessons.Clear();
            Lessons = await mService.GetClassLessons(ClassId);
        }
        else
        {
            ToastService.ShowError("Hiba történt az azonosító null értéket vett fel.");
            _logger.LogError("Hiba történt az azonosító null értéket vett fel.");
            return;
        }
        StateHasChanged();
    }
    private async Task SaveClass(List<TeszterLibrary.Model.ClassLesson> lessons)
    {
        var resp = await mService.SetClassLessons(lessons);
        if (resp.Count > 0)
        {
            ToastService.ShowInfo("A feladatok mentése sikerült!");
            await gService.SetHasLessonsAsync(ClassId);
            Lessons.Clear();
            Lessons = resp.ToList();
        }
    }
    private async Task AddGroupDb()
    {
        try
        {
            var name = Groups?.FirstOrDefault(g => g.Id == SelectGroupId)?.DisplayName ?? string.Empty;
            await gService.EnsureGroupAsync(new Group(ClassId, name, ""));
            await gService.SetHasLessonsAsync(ClassId);
            ToastService.ShowInfo("A csoport mentve.");
        }
        catch (Exception e)
        {
            ToastService.ShowError($"Hiba: {e.Message}");
        }
    }
}