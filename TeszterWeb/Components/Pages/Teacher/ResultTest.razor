@page "/resultTest/{TestId:int}"
@inject TestLoader loader
@inject TestQuestionUserServices tquService
@inject IToastService ToastService
@if (noError)
{
    <h3>@teszt.Title teszt eredményei</h3>
    <UsersResultView UserResults="@userResults" TestQuestions="@teszt.TestQuestions" Update="UpdateScore"></UsersResultView>
}
else
{
    <FluentLabel Typo="Typography.Header" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Error">@errorMessage</FluentLabel>
}

@code {
    // A teszt azonosítója az URL-ben van; régen a GlobalData-ból jött, így frissítés után üres oldal lett.
    [Parameter] public int TestId { get; set; }
    private Test teszt = new();
    List<UserResultToTeacher>? userResults = new();
    bool noError = true;
    string errorMessage = string.Empty;
    protected override async Task OnParametersSetAsync()
    {
        var loaded = await loader.LoadTestForTeacherAsync(TestId, withQuestions: true);
        if (!loaded.Ok)
        {
            errorMessage = loaded.Error!;
            noError = false;
            return;
        }
        teszt = loaded.Value!;
        userResults = await tquService.UsersResult(teszt.Id);
        if (userResults is null)
        {
            errorMessage = tquService.errorMessage;
            noError = false;
            return;
        }
        noError = true;
    }
    async Task UpdateScore(QuestionResult questionResult)
    {
        var response = await tquService.UpdateScore(questionResult.Id,questionResult.Score);
        if (response)
        {
            ToastService.ShowInfo($"Módosítás sikerült!");
        }
        else
        {
            ToastService.ShowError($"Módosításnál hiba történt {tquService.errorMessage}");
        }
    }
}
