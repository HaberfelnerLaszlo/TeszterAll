@page "/newTest"
@using Microsoft.Graph.Models
@inject Microsoft.Graph.GraphServiceClient GraphServiceClient
@inject GlobalData data
@inject NavigationManager navi
@inject QuestionServices qService
@inject SubjectServices sService
@inject ILogger<NewTest> _logger
<h3>Új teszt készítése</h3>
@if (Questions.Count>0)
{
    if (data.Questions.Count > 0)
    {
       <AddTest questions="@Questions" subjects="Subjects" UserId="@data.UserId" TesztQ=data.Questions.ToList() Publish="PublishTest"></AddTest>
    }
    else
    {
       <AddTest questions="@Questions" subjects="Subjects" UserId="@data.UserId" Publish="PublishTest"></AddTest>
    }
}
@code {
    private List<Question> Questions = new();
    private List<Subject> Subjects = new();
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (String.IsNullOrEmpty(data.UserId))
            {
                var user = await GraphServiceClient.Me.GetAsync();
                data.UserId = user.Id.ToString();
                _logger.LogInformation($"Kértem új Id-t {data.UserId}");
            }
            Questions = await qService.GetQuestions(Guid.Parse(data.UserId));
            if (data.Questions.Count > 0 && Questions.Count > 0)
            {
                foreach (var item in data.Questions)
                {
                    Questions.Remove(item);
                }
            }
            Subjects = await sService.GetSubjects();
        }
        catch (Exception e)
        {
            _logger.LogError("Hiba történt: " + e.Message);
            throw;
        }
    }
    private void PublishTest(Test newTest)
    {
        data.Test = newTest;
        navi.NavigateTo("publish");
    }
}
