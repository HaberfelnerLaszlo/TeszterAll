@page "/Question/{userid}"
@page "/Question"
@inject QuestionServices qService
@inject SubjectServices sService
@inject ILogger<QuestionView> logger 
@inject GlobalData data
@inject NavigationManager navi
@inject IToastService toastService 
@*<Modal Accept="CloseModal" AcceptButtom="Rendben" Show="errorMessage!=string.Empty">
	<HeaderContent>
		<p>Figyelmeztetés!</p>
	</HeaderContent>
	<BodyContent>
		<h4>@errorMessage</h4>
