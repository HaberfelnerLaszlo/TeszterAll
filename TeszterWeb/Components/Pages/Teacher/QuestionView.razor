<ListQuestions Questions="questions" Refresh="RefreshQuestions" Delete="DeleteQ" New="SaveNew" Updete="Update" SaveSubject="SaveSubject" UserId="@UserId" Subjects="Subjects" CreateTest="CreateTest">

</ListQuestions>
@code {
	[Parameter] public string UserId { get; set; }
	string errorMessage = string.Empty;
	bool isLoading = true;
	public List<Question> questions = new();
	private List<Subject> Subjects = new();
	protected override async Task OnInitializedAsync()
	{
		data.Title = "Kérdések";
		await RefreshQuestions();
		Subjects = await sService.GetSubjects();
		isLoading = false;
		StateHasChanged();
	}
	private async Task RefreshQuestions()
	{
		if (UserId == null)
		{
			questions = await qService.GetQuestions();
		}
		else questions = await qService.GetQuestions(Guid.Parse(UserId));

		if (questions == null)
		{
			errorMessage = qService.Error;
			toastService.ShowError(errorMessage);
			logger.LogError(errorMessage);
		}
		StateHasChanged();
	}
	private async Task DeleteQ(Question question)
	{
		try
		{
			await qService.DeleteQuestionAsync(question);
			toastService.ShowSuccess($"A következő kérdés törlésre került: { question.Text}");
			logger.LogInformation($"A következő kérdés törlésre került: {question.Text}", question);
			await RefreshQuestions();
		}
		catch (Exception ex)
		{
			logger.LogError(ex, ex.Message, ex.StackTrace);
		}
	}
	private void CreateTest(List<Question> questions)
	{
		foreach (var q in questions)
		{
			data.Questions.Add(new() { Question = q, QuestionId = q.Id, Score = q.Score, Time = q.Time });
		}
		navi.NavigateTo("newtest");
	}
	private async Task SaveNew(Question question)
	{
		try
		{
			question.Id = Guid.NewGuid();
			question.CreatedBy = Guid.Parse(UserId);
			foreach (var item in question.Answers)
			{
				item.QuestionId = question.Id;
			}
			var q = await qService.AddQuestionAsync(question);
			if (q == null)
			{
				errorMessage = "Nem sikerült elmenteni a kérdést! "+ qService.Error;
				toastService.ShowWarning(errorMessage);
				logger.LogWarning(errorMessage);
			}
			else
			{
				questions.Add(question);
				errorMessage = "Kérdés mentése sikerült!";
				toastService.ShowSuccess(errorMessage);
				await RefreshQuestions();
				logger.LogInformation(errorMessage);
				StateHasChanged();
			}

		}
		catch (Exception ex)
		{
			logger.LogError(ex, ex.Message, ex.StackTrace);
		}
	}
	private async Task Update(Question question)
	{

		try
		{
			var q = await qService.UpdateQuestionAsync(question);
			if (q == null)
			{
				errorMessage = "Nem sikerült elmenteni a módosításokat!";
				toastService.ShowWarning(errorMessage);
				logger.LogWarning(errorMessage);
			}
			else
			{
				errorMessage = "Módosítások mentése sikerült!";
				toastService.ShowSuccess(errorMessage);
				logger.LogInformation(errorMessage);
			}

		}
		catch (Exception ex)
		{
			logger.LogError(ex, ex.Message, ex.StackTrace);
		}
	}
	private async Task SaveSubject(string name)
	{
		try
		{
			var s = await sService.AddSubjectsAsync(new Subject() { Name = name });
			if (s == null)
			{
				errorMessage = "Nem sikerült elmenteni a tantárgyat!";
				toastService.ShowWarning(errorMessage);
				logger.LogWarning(errorMessage);
			}
			else Subjects.Add(s);
		}
		catch (Exception ex)
		{
			logger.LogError(ex, ex.Message, ex.StackTrace);
		}
	}
	private void CloseModal()
	{
		errorMessage = string.Empty;
		StateHasChanged();
	}

}
