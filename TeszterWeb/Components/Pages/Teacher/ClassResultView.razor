@page "/ClassResult"
@inject NavigationManager NavigationManager
@inject GraphService graphService
@inject GlobalData data
@inject MathService mService
@inject PageHistoryState PageHistoryState
@inject IToastService toastService
@inject ILogger<ClassResultView> _logger
<h4>Csoport eredményeinek áttekintése</h4>
<FluentSelect Items="Groups" OptionText="i=>i.DisplayName" OptionValue="i=>i.Id" ValueChanged="SelectGroup"></FluentSelect>
<FluentButton Appearance="Appearance.Outline" OnClick="ViewResult" Disabled="ResultMembers.Count==0">Eredmények megtekintése</FluentButton>

@if (Members.Count > 0 || ResultMembers.Count > 0)
{
    <FluentGrid Justify="JustifyContent.FlexStart" Spacing="3">
        <FluentGridItem xs="12" sm="5" Style="max-height:400px; overflow-y:auto;">
            <h5>Csoport tagjai</h5>
            <FluentSortableList Id="shared1" Class="darker" Group="sharedLists" OnUpdate="@SortListOne" OnRemove="@ListOneRemove" Items="@Members" ItemFilter="@(i=>i.Style.Equals("NoLesson"))" Context="member">
                <ItemTemplate>
                    @member.DisplayName
                </ItemTemplate>
            </FluentSortableList>
        </FluentGridItem>
        <FluentGridItem sm="2" HiddenWhen="GridItemHidden.MdAndDown">
            <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical" VerticalAlignment="VerticalAlignment.Center" VerticalGap="30" HorizontalAlignment="HorizontalAlignment.Center">
                <FluentButton Appearance="Appearance.Accent" OnClick="All" Disabled="BtnDidabled">Mindenki</FluentButton>
                <FluentButton Appearance="Appearance.Accent" OnClick="Reverse" Disabled="!BtnDidabled">Senki sem</FluentButton>
            </FluentStack>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="5">
            <h5>Eredményét kérem</h5>
            <FluentSortableList Id="shared2" Group="sharedLists" OnUpdate="@SortListTwo" OnRemove="@ListTwoRemove" Items="@ResultMembers" Context="resultmember">
                <ItemTemplate>
                    @resultmember.DisplayName
                </ItemTemplate>
            </FluentSortableList>
        </FluentGridItem>
    </FluentGrid>
}
@if (resultClassViews.Count > 0)
{
    <ClassResult classViews="resultClassViews" Click="ViewStudent"></ClassResult>
}
@code {
    private List<Microsoft.Graph.Models.EducationClass> Groups = new List<Microsoft.Graph.Models.EducationClass>();
    private string UserId;
    private string SelectGroupId = string.Empty, StudentName;
    private List<Student> Members = new List<Student>();
    private List<Student> ResultMembers = new List<Student>();
    private List<HasLesson> hasLessons = new();
    private Student lastdropped { get; set; }
    private bool BtnDidabled = false;
    private List<ResultClassView> resultClassViews = new();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (string.IsNullOrEmpty(data.UserId))
            {
                try
                {
                    var user = await graphService.GetMe();
                    if (user is not null)
                    {
                        data.UserId = user.Id.ToString(); // ??= throw new ArgumentNullException(nameof(user));
                    }
                }
                catch (Exception ex)
                {
                    toastService.ShowError($"Hiba történt a UserId lekérésekor: {ex.Message}");
                    _logger.LogError(ex, "Hiba történt a UserId lekérésekor: {ex.Message}", ex.Message);
                }

            }
            UserId = data.UserId;
            Groups = await graphService.GetClasses(UserId);
            StateHasChanged();
        }
    }
    private async Task SelectGroup(string id)
    {
        Members.Clear();
        SelectGroupId = id;
        if (id != null)
        {
            var members = await graphService.GetStudents(id);
            foreach (var item in members)
            {
                Members.Add(new Student() { DisplayName = item.DisplayName, Id = Guid.Parse(item.Id) });
                hasLessons.Add(new() { StudentId = Guid.Parse(item.Id), HasCourse = false });
            }
            hasLessons = await mService.HasLessons(hasLessons);
            foreach (var item in hasLessons.Where(l => l.HasCourse).ToList())
            {
                Members.First(m => m.Id == item.StudentId).Style = "HasLesson";
            }
        }
        else return;
    }
    private void All()
    {
        ResultMembers.AddRange(Members);
        Members.Clear();
        BtnDidabled = true;
    }
    private void Reverse()
    {
        Members.AddRange(ResultMembers);
        ResultMembers.Clear();
        BtnDidabled = false;
    }
    private async Task ViewResult()
    {
        string ids = string.Empty;
        resultClassViews.Clear();
        foreach (var item in ResultMembers)
        {
            ids = ids + item.Id.ToString() + "&";
        }
        ids = ids.Substring(0, ids.Length - 1);
        var response = await mService.ResultClassView(ids);
        if (response != null)
        {
            resultClassViews = response;
        }
    }
    private void ViewStudent(Guid studentId)
    {
        PageHistoryState.AddPageToHistory("/ClassResult");
        var name = resultClassViews.Find(c => c.StudentId == studentId).StudentName;
        NavigationManager.NavigateTo($"/StudentResult/{studentId.ToString()}/{name}");
    }
    private record Student()
    {
        public Guid Id { get; set; }
        public string DisplayName { get; set; }
        public string Style { get; set; } = "NoLesson";
    }
    private void ListOneRemove(FluentSortableListEventArgs args)
    {
        if (args is null)
        {
            return;
        }

        // get the item at the old index in list 1
        var item = Members[args.OldIndex];

        // add it to the new index in list 2
        ResultMembers.Insert(args.NewIndex, item);

        // remove the item from the old index in list 1
        Members.Remove(Members[args.OldIndex]);
    }

    private void ListTwoRemove(FluentSortableListEventArgs args)
    {
        if (args is null)
        {
            return;
        }
        // get the item at the old index in list 2
        var item = ResultMembers[args.OldIndex];

        // add it to the new index in list 1
        Members.Insert(args.NewIndex, item);

        // remove the item from the old index in list 2
        ResultMembers.Remove(ResultMembers[args.OldIndex]);
    }
    private void SortListOne(FluentSortableListEventArgs args)
    {
        if (args is null || args.OldIndex == args.NewIndex)
        {
            return;
        }

        var oldIndex = args.OldIndex;
        var newIndex = args.NewIndex;

        var items = this.Members;
        var itemToMove = items[oldIndex];
        items.RemoveAt(oldIndex);

        if (newIndex < items.Count)
        {
            items.Insert(newIndex, itemToMove);
        }
        else
        {
            items.Add(itemToMove);
        }
    }

    private void SortListTwo(FluentSortableListEventArgs args)
    {
        if (args is null || args.OldIndex == args.NewIndex)
        {
            return;
        }

        var oldIndex = args.OldIndex;
        var newIndex = args.NewIndex;

        var items = this.ResultMembers;
        var itemToMove = items[oldIndex];
        items.RemoveAt(oldIndex);

        if (newIndex < items.Count)
        {
            items.Insert(newIndex, itemToMove);
        }
        else
        {
            items.Add(itemToMove);
        }
    }

}
