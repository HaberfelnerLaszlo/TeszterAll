@page "/Closed"
@inject GlobalData data
@inject NavigationManager navi
@inject GraphService gService
@inject TestServices tService
@inject TestQuestionServices tqService
<PageHeader Title="Befejezett tesztek" Description="Lezárt tesztek, kitöltési adatok és kiértékelés." />

@if (loading)
{
    <LoadingState Text="Tesztek betöltése..." />
}
else if (!noError)
{
    <FluentMessageBar Intent="MessageBarIntent.Error">@errorMessage</FluentMessageBar>
}
else if (tests is { Count: > 0 })
{
    <div class="card-grid card-grid--wide">
        @foreach (var item in tests)
        {
            <ClosedTestCard TestItem="item" Result="TestResult" />
        }
    </div>
}
else
{
    <EmptyState Title="Még nincs befejezett teszt" Message="A lezárt tesztek eredményei itt jelennek meg." Icon="@(new Icons.Regular.Size24.DocumentCheckmark())" />
}

@code {
    List<TestResultToTeacher>? tests = new();
    bool noError = true;
    string errorMessage = string.Empty;

    protected override void OnParametersSet()
    {
        data.Title = "Befejezett tesztek";
        StateHasChanged();
        base.OnParametersSet();
    }
    bool loading = true;   // amíg az első betöltés tart, LoadingState látszik

    protected override async Task OnInitializedAsync()
    {
        try { await LoadAsync(); }
        finally { loading = false; }
    }

    private async Task LoadAsync()
    {
        // Közvetlen betöltéskor/frissítéskor a GlobalData még üres: lekérjük a felhasználót (mint a DraftTest).
        if (string.IsNullOrEmpty(data.UserId) && await gService.GetMe() is { } me)
        {
            data.UserId = me.Id.ToString();
        }
        if (data.UserGuid is not Guid userGuid)
        {
            noError = false;
            errorMessage = "Nincs bejelentkezve a felhasználó!";
            return;
        }
        tests = await tService.GetClosedTests(userGuid);
    }
    private void TestResult(TestResultToTeacher test) => navi.NavigateTo($"resultTest/{test.TestId}");   // a ResultTest az azonosító alapján tölt
}
