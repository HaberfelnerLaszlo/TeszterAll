@page "/Closed"
@inject GlobalData data
@inject NavigationManager navi
@inject TestServices tService
@inject TestQuestionServices tqService
@if (noError)
{
    @if (tests is null)
    {
        <p>Tesztek betöltése folyamatban...</p>
        <Waiting />
    }
    else
    {
        <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" Wrap="true" HorizontalAlignment="HorizontalAlignment.Center">
            @foreach (var item in tests)
            {
                <FluentCard Width="48%" Style="min-width:400px">
                    <ClosedTestCard TestItem="item" Result="TestResult" />
                </FluentCard>
            }
        </FluentStack>
    }
}
else
{
    <FluentLabel Typo="Typography.Header" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Error">@errorMessage</FluentLabel>
}
@code {
    List<TestResultToTeacher>? tests = new();
    bool noError = true;
    string errorMessage = string.Empty;

    protected override void OnParametersSet()
    {
        data.Title = "Lezárt tesztek";
        StateHasChanged();
        base.OnParametersSet();
    }
    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(data.UserId))
        {
            noError = false;
            errorMessage = "Nincs bejelentkezve a felhasználó!";
            return;
        }
        tests = await tService.GetClosedTests(Guid.Parse(data.UserId));
    }
    private async void TestResult(TestResultToTeacher test)
    {
        List<TestQuestion>? questions = await tqService.GetTestQuestions(test.TestId);
        if (questions is null)
        {
            return;
        }
        data.Test = new() { Id = test.TestId, Title = test.Title, EndTime = test.EndTime, TestQuestions = questions };
        navi.NavigateTo("resultTest");
    }
}
