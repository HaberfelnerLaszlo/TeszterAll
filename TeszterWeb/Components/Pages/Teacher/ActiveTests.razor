@page "/active"

@inject NavigationManager navi
@inject Microsoft.Graph.GraphServiceClient GraphServiceClient
@inject GlobalData data
@inject TestServices tService
@inject TestQuestionServices tqService
@inject ILogger<ActiveTests> _logger
@inject IToastService toastService

<PageHeader Title="Aktív tesztek" Description="A diákok által éppen kitölthető tesztek és a kitöltések állása.">
    <Actions>
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.DocumentAdd())" OnClick="@(() => navi.NavigateTo("newtest_w"))">Új teszt</FluentButton>
    </Actions>
</PageHeader>

@if (loading)
{
    <LoadingState Text="Tesztek betöltése..." />
}
else if (tests is { Count: > 0 })
{
    <div class="card-grid card-grid--wide">
        @foreach (var item in tests)
        {
            <TestCard TestItem="item" Result="@ViewResult" />
        }
    </div>
}
else
{
    <EmptyState Title="Nincs aktív teszt" Message="@(string.IsNullOrEmpty(errorMessage) ? "Tegyél közzé egy tesztet a piszkozatok közül, vagy készíts újat." : errorMessage)" Icon="@(new Icons.Regular.Size24.DocumentQueue())">
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => navi.NavigateTo("draft"))">Piszkozatok</FluentButton>
    </EmptyState>
}

@code {
    private List<ActiveTestView> tests = new();
    bool noError = true;
    string errorMessage = string.Empty;
    protected override void OnParametersSet()
    {
        data.Title = "Aktív tesztek";
        StateHasChanged();
        base.OnParametersSet();
    }

    bool loading = true;   // amíg az első betöltés tart, LoadingState látszik

    protected override async Task OnInitializedAsync()
    {
        try { await LoadAsync(); }
        finally { loading = false; }
    }

    private async Task LoadAsync()
    {
        data.Title = "Aktív tesztek";
        if (String.IsNullOrEmpty(data.UserId))
        {
            var user = await GraphServiceClient.Me.GetAsync();
            data.UserId = user.Id.ToString();
            _logger.LogInformation($"Kértem új Id-t {data.UserId}");
        }

        if (data.UserGuid is not Guid userGuid)
        {
            toastService.ShowError("Nem sikerült azonosítani a felhasználót. Jelentkezz be újra!");
            return;
        }
        tests = await tService.GetActiveTests(userGuid);
        if (tests is null)
        {
            noError = false;
            errorMessage = tService.ErrorMessage;
        }
        StateHasChanged();
    }
    void ViewResult(Test test) => navi.NavigateTo($"resultTest/{test.Id}");   // a ResultTest az azonosító alapján tölt
}
