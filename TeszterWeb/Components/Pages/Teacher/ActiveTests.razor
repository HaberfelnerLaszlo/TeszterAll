@page "/active"

@inject NavigationManager navi
@inject Microsoft.Graph.GraphServiceClient GraphServiceClient
@inject GlobalData data
@inject TestServices tService
@inject TestQuestionServices tqService
@inject ILogger<ActiveTests> _logger
@inject IToastService toastService

@if (tests != null && tests.Count > 0)
{
    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" Wrap="true">
        @foreach (var item in tests)
        {
            <FluentCard Width="450px">
                <TestCard TestItem="item" Result="@ViewResult" />
            </FluentCard>
        }
    </FluentStack>
}
else if (noError)
{
    <div>
        <p>Tesztek betöltése...</p>
    </div>
}
else
{
    <p>@errorMessage</p>
}
@code {
    private List<ActiveTestView> tests = new();
    bool noError = true;
    string errorMessage = string.Empty;
    protected override void OnParametersSet()
    {
        data.Title = "Aktív tesztek";
        StateHasChanged();
        base.OnParametersSet();
    }

    protected override async Task OnInitializedAsync()
    {
        data.Title = "Aktív tesztek";
        if (String.IsNullOrEmpty(data.UserId))
        {
            var user = await GraphServiceClient.Me.GetAsync();
            data.UserId = user.Id.ToString();
            _logger.LogInformation($"Kértem új Id-t {data.UserId}");
        }

        tests = await tService.GetActiveTests(Guid.Parse(data.UserId));
        if (tests is null)
        {
            noError = false;
            errorMessage = tService.ErrorMessage;
            toastService.ShowInfo(errorMessage);
        }
        StateHasChanged();
    }
    async Task ViewResult(Test test)
    {
        List<TestQuestion> questions = await tqService.GetTestQuestions(test.Id);
        if (questions is null)
        {
            noError = false;
            errorMessage = tqService.ErrorMessage;
            toastService.ShowError(errorMessage);
            _logger.LogError("Teszt kérdések letültésénél: {errorMessage}", errorMessage);
            return;
        }
        data.Test = new() { Id = test.Id, Title = test.Title, EndTime = test.EndTime, TestQuestions = questions };
        navi.NavigateTo("resultTest");

    }
}
