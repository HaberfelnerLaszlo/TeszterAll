@page "/draft"
@inject TestServices tService
@inject GraphService gService
@inject NavigationManager navi
@inject GlobalData data
@inject IToastService toastService
<PageHeader Title="Piszkozatok" Description="Elkészült, de még közzé nem tett tesztek. Innen szerkesztheted vagy kiadhatod őket.">
    <Actions>
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.DocumentAdd())" OnClick="@(() => navi.NavigateTo("newtest_w"))">Új teszt</FluentButton>
    </Actions>
</PageHeader>

@if (loading)
{
    <LoadingState Text="Piszkozatok betöltése..." />
}
else if (tests is { Count: > 0 })
{
    <div class="card-grid card-grid--wide">
        @foreach (var item in tests)
        {
            <NoPublishTestCard TestItem="item" Publish="PublishTest" Edit="EditTest" Delete="DeleteTest" />
        }
    </div>
}
else
{
    <EmptyState Title="Nincs piszkozat" Message="@(string.IsNullOrEmpty(errorMesage) ? "Készíts új tesztet a varázslóval." : errorMesage)" Icon="@(new Icons.Regular.Size24.DocumentEdit())">
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => navi.NavigateTo("newtest_w"))">Új teszt</FluentButton>
    </EmptyState>
}

@code {
    private List<Test>? tests = new();
    private Test test = new();
    bool ispublish = false;
    string userId = string.Empty, errorMesage = string.Empty;
    protected override void OnParametersSet()
    {
        data.Title = "Piszkozatok";
        StateHasChanged();
        base.OnParametersSet();
    }

    bool loading = true;   // amíg az első betöltés tart, LoadingState látszik

    protected override async Task OnInitializedAsync()
    {
        try { await LoadAsync(); }
        finally { loading = false; }
    }

    private async Task LoadAsync()
    {
        data.Title = "Piszkozatok";
        if (String.IsNullOrEmpty(data.UserId))
        {
            var me = await gService.GetMe();
            if (me is null)
            {
                toastService.ShowError("Hiba a felhasználó adatainak lekérésekor.");
                return;
            }
            data.UserId = me.Id.ToString();
        }
        userId = data.UserId;
        if (data.UserGuid is not Guid userGuid)
        {
            toastService.ShowError("Nem sikerült azonosítani a felhasználót. Jelentkezz be újra!");
            return;
        }
        tests = await tService.GetNoPublished(userGuid);
        if (tests is null)
        {
            errorMesage = tService.ErrorMessage;
        }
        StateHasChanged();
    }
    private void PublishTest(Test test)
    {
        navi.NavigateTo($"publish/{test.Id}");   // a TestPublish az azonosító alapján tölt
        //ispublish = true;
        //StateHasChanged();
    }
    private void EditTest(Test test)
    {
        navi.NavigateTo($"newtest_w/{test.Id}");
    }
    private async Task DeleteTest(Test test)
    {
        if (await tService.DeleteTestAsync(test.Id))
        {
            if (tests is null) {
                tests = new List<Test>();
                toastService.ShowInfo("A teszt null értéket vett fel törölve lett.");
                return; }
            tests.Remove(test);
            toastService.ShowInfo("A teszt törölve lett.");
        }
        else
        {
            toastService.ShowWarning("A teszt törlése nem sikerült");
        }
    }
}
