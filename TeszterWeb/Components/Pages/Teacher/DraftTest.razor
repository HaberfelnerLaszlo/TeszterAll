@page "/draft"
@inject TestServices tService
@inject GraphService gService
@inject NavigationManager navi
@inject GlobalData data
@inject IToastService toastService
<h3>Piszkozat tesztek</h3>

@if (tests is not null && tests.Count>0)
{
    <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="20" VerticalGap="20">
        @foreach (var item in tests)
        {
            <NoPublishTestCard TestItem="item" Publish="PublishTest" Edit="EditTest" Delete="DeleteTest"/>
        }
    </FluentStack>
}
else { <FluentLabel>@errorMesage</FluentLabel>}

@code {
    private List<Test> tests = new();
    private Test test = new();
    bool ispublish = false;
    string userId = string.Empty,errorMesage=string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (String.IsNullOrEmpty(data.UserId))
        {
            var me=await gService.GetMe();
            data.UserId = me.Id.ToString();
        }
        userId = data.UserId;
        tests = await tService.GetNoPublished(Guid.Parse(data.UserId));
        if (tests is null)
        {
            errorMesage = tService.ErrorMessage;
            toastService.ShowInfo(tService.ErrorMessage);
        }
    }
    private void PublishTest(Test test)
    {
        data.Test = test;
        navi.NavigateTo("publish");
        //ispublish = true;
        //StateHasChanged();
    }
    private void EditTest(Test test)
    {
        data.Test = test;
        navi.NavigateTo($"newtest/{test.Id}");
    }
    private async Task DeleteTest(Test test)
    {
        if(await tService.DeleteTestAsync(test.Id))
        {
            tests.Remove(test);
            toastService.ShowInfo("A teszt törölve lett.");
        }
        else
        {
            toastService.ShowWarning("A teszt törlése nem sikerült");
        }
    }
}
