@page "/home"
@using Microsoft.AspNetCore.Components
@using Microsoft.Identity.Web
@using Microsoft.Graph.Models
@inject Microsoft.Graph.GraphServiceClient GraphServiceClient
@inject MicrosoftIdentityConsentAndConditionalAccessHandler ConsentHandler
@inject EduUserServices uService
@inject PontServices pService
@inject GlobalData data
@inject IToastService ToastService
@inject ILogger<Home> logger
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<PageTitle>Kezdőlap</PageTitle>

<AuthorizeView Roles="Teacher">
    <FluentGrid Style="margin:10px 0px">
        <NavLink class="nav-doboz" href="newtest_w">Új teszt készítése</NavLink>
        <NavLink class="nav-doboz" href="draft">Nem aktívált tesztek</NavLink>
        <NavLink class="nav-doboz" href="active">Aktív tesztek</NavLink>
        <NavLink class="nav-doboz" href="closed">Befejezett tesztek</NavLink>
        <NavLink class="nav-doboz" href="counter">Archivált tesztek</NavLink>
        <NavLink class="nav-doboz" href="subject">Tantárgyak</NavLink>
        <NavLink class="nav-doboz" href=@qHref>Kérdések</NavLink>
        <NavLink class="nav-doboz" href="addclasscourse">Matek gyakorlás osztálynak</NavLink>
        <NavLink class="nav-doboz" href="addcourse">Matek gyakorlás tanulónak</NavLink>
        <NavLink class="nav-doboz" href="classResult">Matek gyakorlás eredményei</NavLink>
    </FluentGrid>
</AuthorizeView>
<AuthorizeView Roles="Student">
    @if (tanuloData is not null)
    {
        <FluentCard MinimalStyle="false">
            <FluentLabel Typo="Typography.H1">Aktuális pontszámod: @tanuloData.PontSzam</FluentLabel>
            <FluentLabel Typo="Typography.H2">Az osztályod átlaga: @tanuloData.Atlag.ToString("F2")</FluentLabel>
            <FluentLabel Typo="Typography.H3">Az osztályban @tanuloData.Min és @tanuloData.Max pontok között vannak a társaid.</FluentLabel>
            @if (tanuloData.Max == tanuloData.PontSzam)
            {
                <FluentLabel Typo="Typography.H3">Gratulálok! Te vagy a legjobb! </FluentLabel>
            }
            else if (tanuloData.PontSzam >= 0.9 * tanuloData.Max)
            { <FluentLabel Typo="Typography.H3">Gratulálok! A legjobbak között vagy! </FluentLabel>
            }
        </FluentCard>
        <FluentLabel Typo="Typography.H4" Style="margin: 10px">Az utolsó pontjaid (maximum 20 darab): </FluentLabel>
        <FluentCard MinimalStyle="true">
            <FluentDataGrid Items="@pontok" AutoItemsPerPage="true">
                <PropertyColumn Property="@(p=>p.Datum)" Title="Dátum" />
                <PropertyColumn Property="@(p=>p.PontTipus)" Title="Pont fajtája" Tooltip="true" HeaderTooltip="Lecke,Pótlás,Szorgalmi,Szaktanári,Gyakorló,-50,-100,Kvíz,Javítás,Mértékváltás, " />
                <PropertyColumn Property="@(p=>p.PontSzam)" Title="Pontszám" />
            </FluentDataGrid>
        </FluentCard>
    }
    <nav class="d-flex flex-row w-100">
        <NavLink class="nav-doboz nav-link" href="studenttests">Tesztjeim</NavLink>
        <NavLink class="nav-doboz nav-link" href="student/testsResult">Tesztek eredményei</NavLink>
        <NavLink class="nav-doboz nav-link" href="student/math">Matematika gyakorló</NavLink>
    </nav>

</AuthorizeView>
@code{
    EducationUser? user;
    TanuloData? tanuloData = new();
    IQueryable<Pont>? pontok;
    string qHref = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            user = await GraphServiceClient.Education.Me.GetAsync();
            if (user is not null)
            {
                if (user.Id is null)
                {
                    ToastService.ShowError("Nem található felhasználó azonosító!");
                    logger.LogError("Nem található felhasználó azonosító! {user}",user);
                    return;
                }
                data.UserId = user.Id;
                data.UserName = user.DisplayName;
                qHref = $"question/{user.Id}";
                if (user.PrimaryRole != EducationUserRole.Teacher)
                {
                    tanuloData = await pService.GetTanuloData(user.Id);
                    if (tanuloData is not null)
                    {
                        pontok = tanuloData.Pontok.AsQueryable();
                    }
                }
                if (!(await uService.UserExits(Guid.Parse(data.UserId))))
                {
                    if (string.IsNullOrEmpty(uService.ErrorMessage))
                    {
                        await uService.AddUser(new EduUser() { DisplayName = user.DisplayName ?? "NoName", Id = Guid.Parse(data.UserId), Role = user.PrimaryRole!.Value.ToString() ?? EducationUserRole.Student.ToString() });
                    }
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Kivétel történt.");
            ConsentHandler.HandleException(ex);
        }
    }
}
