@* </AuthorizeView> *@
@code{
    EducationUser? user;
    string qHref = string.Empty, selectedValue = "54885fe6-e6cc-4d9e-aed1-0edf7fd6d036";
    protected override async Task OnInitializedAsync()
    {
        try
        {
            user = await GraphServiceClient.Education.Me.GetAsync();
            if (user is not null)
            {
                data.UserId = user.Id ?? Guid.Empty.ToString();
                qHref = $"question/{user.Id}";
                if (!(await uService.UserExits(Guid.Parse(data.UserId))))
                {
                    if (string.IsNullOrEmpty(uService.ErrorMessage))
                    {
                        await uService.AddUser(new EduUser() { DisplayName = user.DisplayName ?? "NoName", Id = Guid.Parse(data.UserId), Role = user.PrimaryRole.Value.ToString() });
                    }
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ConsentHandler.HandleException(ex);
        }
    }
    void SelectedChange(string value)
    {
        selectedValue = value;
        data.UserId = value;
        //StateHasChanged();
    }
}