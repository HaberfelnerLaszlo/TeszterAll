@page "/home"
@using Microsoft.AspNetCore.Components
@using Microsoft.Identity.Web
@using Microsoft.Graph.Models
@inject Microsoft.Graph.GraphServiceClient GraphServiceClient
@inject MicrosoftIdentityConsentAndConditionalAccessHandler ConsentHandler
@inject EduUserServices uService
@inject GlobalData data
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<PageTitle>Kezdőlap</PageTitle>
@data.UserId;
<AuthorizeView Roles="Teacher">
    <FluentGrid Style="margin:10px 0px">
        <NavLink class="nav-doboz" href="newtest_w">Új teszt készítése</NavLink>
        <NavLink class="nav-doboz" href="draft">Nem aktívált tesztek</NavLink>
        <NavLink class="nav-doboz" href="active">Aktív tesztek</NavLink>
        <NavLink class="nav-doboz" href="closed">Befejezett tesztek</NavLink>
        <NavLink class="nav-doboz" href="counter">Archivált tesztek</NavLink>
        <NavLink class="nav-doboz" href="subject">Tantárgyak</NavLink>
        <NavLink class="nav-doboz" href=@qHref>Kérdések</NavLink>
        <NavLink class="nav-doboz" href="addclasscourse">Matek gyakorlás osztálynak</NavLink>
        <NavLink class="nav-doboz" href="addcourse">Matek gyakorlás tanulónak</NavLink>
        <NavLink class="nav-doboz" href="classResult">Matek gyakorlás eredményei</NavLink>
    </FluentGrid>
</AuthorizeView>
