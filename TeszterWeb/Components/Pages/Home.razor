@page "/home"
@using Microsoft.AspNetCore.Components
@using Microsoft.Identity.Web
@using Microsoft.Graph.Models
@inject Microsoft.Graph.GraphServiceClient GraphServiceClient
@inject MicrosoftIdentityConsentAndConditionalAccessHandler ConsentHandler
@inject EduUserServices uService
@inject PontServices pService
@inject GlobalData data
@inject IToastService ToastService
@inject ILogger<Home> logger
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<AuthorizeView Roles="Teacher">
    <PageHeader Title="@(string.IsNullOrEmpty(FirstName) ? "Üdv!" : $"Üdv, {FirstName}!")" Description="Válaszd ki, mivel szeretnél foglalkozni." />

    <section class="section">
        <FluentText As="TextTag.H2" Size="TextSize.Size500" Weight="TextWeight.Semibold" Class="section__title">Tesztek</FluentText>
        <div class="card-grid">
            <NavTile Href="newtest_w" Title="Új teszt" Description="Teszt összeállítása varázslóval" Icon="@(new Icons.Regular.Size24.DocumentAdd())" />
            <NavTile Href="draft" Title="Piszkozatok" Description="Még nem aktivált tesztek" Icon="@(new Icons.Regular.Size24.DocumentEdit())" />
            <NavTile Href="active" Title="Aktív tesztek" Description="Folyamatban lévő tesztek, eredmények" Icon="@(new Icons.Regular.Size24.DocumentQueue())" />
            <NavTile Href="closed" Title="Befejezett tesztek" Description="Lezárt tesztek és kiértékelésük" Icon="@(new Icons.Regular.Size24.DocumentCheckmark())" />
            <NavTile Href="@qHref" Title="Kérdésbank" Description="Saját kérdések szerkesztése" Icon="@(new Icons.Regular.Size24.BookQuestionMark())" />
            <NavTile Href="subject" Title="Tantárgyak" Description="Tantárgyak és témakörök" Icon="@(new Icons.Regular.Size24.Library())" />
        </div>
    </section>

    <section class="section">
        <FluentText As="TextTag.H2" Size="TextSize.Size500" Weight="TextWeight.Semibold" Class="section__title">Matek gyakorlás</FluentText>
        <div class="card-grid">
            <NavTile Href="AddClassCourse" Title="Osztálynak" Description="Gyakorló feladatok kiadása egy osztálynak" Icon="@(new Icons.Regular.Size24.PeopleTeam())" />
            <NavTile Href="AddCourse" Title="Tanulónak" Description="Egyéni gyakorlás egy tanulónak" Icon="@(new Icons.Regular.Size24.PersonCircle())" />
            <NavTile Href="teacher/class-lesson" Title="Órai nézet" Description="Közös órai gyakorlás vezetése" Icon="@(new Icons.Regular.Size24.PersonBoard())" />
            <NavTile Href="ClassResult" Title="Eredmények" Description="Osztályok és tanulók haladása" Icon="@(new Icons.Regular.Size24.ChartMultiple())" />
            <NavTile Href="TaskList" Title="Témák szerkesztése" Description="Feladatgenerátor beállításai" Icon="@(new Icons.Regular.Size24.TextBulletListSquareEdit())" />
        </div>
    </section>

    <section class="section">
        <FluentText As="TextTag.H2" Size="TextSize.Size500" Weight="TextWeight.Semibold" Class="section__title">Pontok és feladatok</FluentText>
        <div class="card-grid">
            <NavTile Href="feladat/tanulokpont" Title="Tanulók pontjai" Description="Pontszámok áttekintése és módosítása" Icon="@(new Icons.Regular.Size24.Trophy())" />
            <NavTile Href="teacher/add-assignment" Title="Feladat kiadása" Description="Új feladat kiosztása" Icon="@(new Icons.Regular.Size24.ClipboardTaskListLtr())" />
        </div>
    </section>
</AuthorizeView>

<AuthorizeView Roles="Student">
    <PageHeader Title="@(string.IsNullOrEmpty(FirstName) ? "Szia!" : $"Szia, {FirstName}!")" Description="Itt látod a pontjaidat és a feladataidat." />

    @if (tanuloData is not null)
    {
        @if (tanuloData.Max == tanuloData.PontSzam)
        {
            <FluentMessageBar Intent="MessageBarIntent.Success" Title="Gratulálok!" Class="section">Te vagy a legjobb az osztályban!</FluentMessageBar>
        }
        else if (tanuloData.PontSzam >= 0.9 * tanuloData.Max)
        {
            <FluentMessageBar Intent="MessageBarIntent.Success" Title="Gratulálok!" Class="section">A legjobbak között vagy!</FluentMessageBar>
        }

        <section class="section card-grid">
            <StatCard Value="@tanuloData.PontSzam.ToString()" Label="Aktuális pontszámod" Icon="@(new Icons.Regular.Size24.Trophy())" />
            <StatCard Value="@tanuloData.Atlag.ToString("F2")" Label="Az osztályod átlaga" Icon="@(new Icons.Regular.Size24.PeopleTeam())" />
            <StatCard Value="@($"{tanuloData.Min} – {tanuloData.Max}")" Label="Az osztály pontjai" Hint="legkevesebb – legtöbb" Icon="@(new Icons.Regular.Size24.DataBarVertical())" />
        </section>

        <section class="section">
            <FluentText As="TextTag.H2" Size="TextSize.Size500" Weight="TextWeight.Semibold" Class="section__title">Gyors elérés</FluentText>
            <div class="card-grid">
                <NavTile Href="studentTests" Title="Tesztjeim" Description="Kitöltendő tesztek" Icon="@(new Icons.Regular.Size24.ClipboardTaskListLtr())" />
                <NavTile Href="student/testsResult" Title="Eredményeim" Description="Megírt tesztek eredményei" Icon="@(new Icons.Regular.Size24.DataBarVertical())" />
                <NavTile Href="student/Math" Title="Matematika gyakorló" Description="Gyakorló feladatok" Icon="@(new Icons.Regular.Size24.BookOpen())" />
            </div>
        </section>

        @if (datas.Count > 0)
        {
            <section class="section">
                <FluentCard>
                    <ApexChart TItem="PontData" Title="Az utolsó 20 pont alakulása" Height="300" Width="@("100%")" XAxisType="XAxisType.Datetime">
                        <ApexPointSeries TItem="PontData"
                                         Items="datas"
                                         Name="Pontszámok"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(e => e.Datum)"
                                         YAggregate="@(e => e.Sum(e=>e.Pontszam))" />
                    </ApexChart>
                </FluentCard>
            </section>
        }

        <section class="section">
            <FluentText As="TextTag.H2" Size="TextSize.Size500" Weight="TextWeight.Semibold" Class="section__title">Az utolsó pontjaid (legfeljebb 20)</FluentText>
            <FluentCard>
                <FluentDataGrid Items="@pontok" AutoItemsPerPage="true">
                    <PropertyColumn Property="@(p=>p.Datum)" Title="Dátum" />
                    <PropertyColumn Property="@(p=>p.PontTipus)" Title="Pont fajtája" Tooltip="true" HeaderTooltip="Lecke,Pótlás,Szorgalmi,Szaktanári,Gyakorló,-50,-100,Kvíz,Javítás,Mértékváltás, " />
                    <PropertyColumn Property="@(p=>p.PontSzam)" Title="Pontszám" />
                </FluentDataGrid>
            </FluentCard>
        </section>
    }
    else
    {
        <EmptyState Title="Nem elérhetők a pontjaid" Message="Próbáld újra később, vagy szólj a tanárodnak." Icon="@(new Icons.Regular.Size48.Trophy())" />
    }
</AuthorizeView>
@code{
    EducationUser? user;
    TanuloData? tanuloData = new();
    List<PontData> datas = new();
    IQueryable<Pont>? pontok;
    string qHref = "Question";
    // A megszólításhoz a keresztnév (magyar névsorrend: vezetéknév keresztnév).
    string FirstName => (user?.GivenName ?? user?.DisplayName?.Split(' ').LastOrDefault() ?? string.Empty).Trim();
    protected override async Task OnInitializedAsync()
    {
        data.Title = "Kezdőlap";
        try
        {
            user = await GraphServiceClient.Education.Me.GetAsync();
            if (user is not null)
            {
                if (user.Id is null)
                {
                    ToastService.ShowError("Nem található felhasználó azonosító!");
                    logger.LogError("Nem található felhasználó azonosító! {user}", user);
                    return;
                }
                data.UserId = user.Id;
                data.UserName = user.DisplayName;
                qHref = $"question/{user.Id}";
                if (user.PrimaryRole != EducationUserRole.Teacher)
                {
                    tanuloData = await pService.GetTanuloData(user.Id);
                    if (tanuloData is not null)
                    {
                        //Teszthez
                        //if (tanuloData.Pontok.Count == 0)
                        //{
                        //    tanuloData.Pontok.Add(new() { Datum = DateTime.Parse("2025.09.20 15:29"), PontSzam = 2, Id = 1, PontTipus = PontTipus.Lecke });
                        //    tanuloData.Pontok.Add(new() { Datum = DateTime.Parse("2025.09.21 14:00"), PontSzam = 2, Id = 2, PontTipus = PontTipus.Lecke });
                        //    tanuloData.Pontok.Add(new() { Datum = DateTime.Parse("2025.09.22 5:55"), PontSzam = -2, Id = 3, PontTipus = PontTipus.Lecke });
                        //    tanuloData.Pontok.Add(new() { Datum = DateTime.Parse("2025.09.23 6:20"), PontSzam = 2, Id = 4, PontTipus = PontTipus.Lecke });
                        //    tanuloData.Pontok.Add(new() { Datum = DateTime.Parse("2025.09.23 6:23"), PontSzam = 1, Id = 5, PontTipus = PontTipus.Pótlás });
                        //    tanuloData.Pontok.Add(new() { Datum = DateTime.Parse("2025.09.24 6:44"), PontSzam = 2, Id = 6, PontTipus = PontTipus.Lecke });
                        //    tanuloData.Pontok.Add(new() { Datum = DateTime.Parse("2025.09.24 12:24"), PontSzam = 3, Id = 7, PontTipus = PontTipus.Szorgalmi });
                        //}
                        pontok = tanuloData.Pontok.AsQueryable();
                        MakeData();
                    }
                }
                else if (!string.IsNullOrEmpty(user.Id))
                {
                    tanuloData = await pService.GetTanuloData(user.Id);
                    if (tanuloData is not null)
                    {
                        pontok = tanuloData.Pontok.AsQueryable();
                        MakeData();
                    }
                    else
                    {
                        return;   // tanárnak általában nincs pontja – nem jelzünk hibát
                    }
                }
                if (data.UserGuid is Guid userGuid && !(await uService.UserExits(userGuid)))
                {
                    if (string.IsNullOrEmpty(uService.ErrorMessage))
                    {
                        await uService.AddUser(new EduUser() { DisplayName = user.DisplayName ?? "NoName", Id = userGuid, Role = user.PrimaryRole!.Value.ToString() ?? EducationUserRole.Student.ToString() });
                    }
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Kivétel történt.");
            ConsentHandler.HandleException(ex);
        }
    }
    private void MakeData()
    {
        datas.Clear();
        int aktualpont = tanuloData?.PontSzam ?? 0;
        tanuloData?.Pontok.Reverse();
        tanuloData?.Pontok.ForEach(p => { datas.Add(new PontData() { Datum = p.Datum, Pontszam = aktualpont }); aktualpont -= p.PontSzam; });
    }
    public class PontData()
    {
        public DateTime Datum { get; set; }
        public int Pontszam { get; set; }
    }
}