@code{
    /// <summary>
    /// {"id":"6392352e-69b8-42ac-8f9c-3f92297e54c8","displayName":"Próba Diák"},{"id":"ad23c929-7c72-4512-93d1-1877fe290b8a","displayName":"Peterfy's Diák"}]
    /// </summary>
    /// <returns></returns>

    EducationUser? user;
    string qHref=string.Empty,selectedValue= "54885fe6-e6cc-4d9e-aed1-0edf7fd6d036";
    protected override async Task OnInitializedAsync()
    {
        try
        {
            user = await GraphServiceClient.Education.Me.GetAsync();
            if (user is not null)
            {
                data.UserId = user.Id??string.Empty;
                qHref = $"question/{user.Id}";
                if (!(await uService.UserExits(Guid.Parse(user.Id))))
                {
                    if (string.IsNullOrEmpty(uService.ErrorMessage))
                    {
                        await uService.AddUser(new EduUser() { DisplayName = user.DisplayName, Id = Guid.Parse(user.Id), Role = user.PrimaryRole.Value.ToString() });
                    }
                }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ConsentHandler.HandleException(ex);
        }
    }
    void SelectedChange(string value)
    {
        selectedValue = value;
        data.UserId = value;
        //StateHasChanged();
    }
}