@page "/usermanagment"
@using Microsoft.Identity.Web
@inject EduUserServices userServices
@inject IToastService toastService
@inject GlobalData data
@attribute [Authorize(Roles = "Teacher")]
<PageHeader Title="Felhasználók" Description="Az alkalmazásba már belépett tanárok és diákok." />
@if (loading)
{
    <LoadingState Text="Felhasználók betöltése..." />
}
else if (users is { Count: > 0 })
{
    <FluentCard>
        <FluentDataGrid Items="@users.AsQueryable()" ShowHover="true">
            <PropertyColumn Property="@(u => u.DisplayName)" Title="Név" Sortable="true" />
            <TemplateColumn Title="Szerepkör" Sortable="true" SortBy="@(GridSort<EduUser>.ByAscending(u => u.Role))">
                <FluentBadge Appearance="BadgeAppearance.Tint" Color="@(context.Role == "Teacher" ? BadgeColor.Brand : BadgeColor.Informative)"
                             Content="@(context.Role == "Teacher" ? "Tanár" : context.Role == "Student" ? "Diák" : context.Role)" />
            </TemplateColumn>
        </FluentDataGrid>
    </FluentCard>
}
else
{
    <EmptyState Title="Nincs felhasználó" Message="@(string.IsNullOrEmpty(userServices.ErrorMessage) ? "Még senki nem lépett be az alkalmazásba." : userServices.ErrorMessage)" Icon="@(new Icons.Regular.Size24.PeopleSettings())" />
}

@code {
    List<EduUser>? users;
    bool loading = true;
    protected override async Task OnInitializedAsync()
    {
        data.Title = "Felhasználók";
        try
        {
            users = await userServices.GetAllEduUsers();
        }
        finally
        {
            loading = false;
        }
    }
}
