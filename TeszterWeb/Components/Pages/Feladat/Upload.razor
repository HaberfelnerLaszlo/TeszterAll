@page "/feladat/upload"
@inject TeszterLibrary.Services.Feladat.FeladatApiService FeladatService
@inject IToastService toastService
@inject GlobalData data
<PageHeader Title="Feladat feltöltése" Description="Tölts fel egy feladatfájlt; a feldolgozás eredményéről értesítést kapsz." />
<FluentInputFile @ref="@myFileByBuffer"
                 AnchorId="MyUploadBuffer"
                 DragDropZoneVisible="false"
                 Mode="InputFileMode.Stream"
                 Multiple="false"
                 MaximumFileSize="@(1000 * 1024 * 1024)"
                 OnFileUploaded="@OnCompleted" />


<FluentCard>
    <div class="upload-box">
        <FluentIcon Value="@(new Icons.Regular.Size24.ArrowUpload())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Primary" />
        <FluentText>Válaszd ki a feltöltendő fájlt.</FluentText>
        <FluentButton Appearance="ButtonAppearance.Primary" Id="MyUploadBuffer">Fájl kiválasztása</FluentButton>
    </div>
</FluentCard>

@code {
    FluentInputFile? myFileByBuffer = default!;
    protected override void OnInitialized() => data.Title = "Feladat feltöltése";
    async Task OnCompleted(FluentInputFileEventArgs file)
    {
        if (file.Stream is null)
        {
            toastService.ShowError($"File {file.Name} nem olvasható.");
            return;
        }
        var resp = await FeladatService.PostFileAsync(file.Stream, file.Name);
        if (resp)
        {
            toastService.ShowSuccess($"File {file.Name} sikeresen feltöltve.");
        }
        else
        {
            toastService.ShowError($"File {file.Name} feltöltése sikertelen.");
        }
    }
}