@page "/"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@* Nyilvános (kivetítős) órai nézet. A bejelentkezett felhasználó a Kezdőlapra kerül; a tanári vezérlés a /teacher/class-lesson oldalon van. *@
@if (isAnonymous)
{
    <ClassLessonHost IsTeacher="false" />
}
@code {
    private bool isAnonymous;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/home", replace: true);
            return;
        }
        isAnonymous = true;
    }
}
