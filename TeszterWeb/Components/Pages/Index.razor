@page "/"
@inject MathService mService
@inject IToastService toastService 
<h3>Válasz osztályt!</h3>
<FluentSelect ValueChanged="@(e => SelectedClass(e))" TOption="string">
    <FluentOption Value="">Válasz egy csoportot...</FluentOption>
    <FluentOption Value="8048b263-4106-4925-a316-ffdee54a91a2">6. első csoport</FluentOption>
    <FluentOption Value="b02dc50d-d531-43fb-9c6b-e6a39a1beb8e">6. második csoport</FluentOption>
    <FluentOption Value="f9a0b4d6-86fb-4eed-947d-503796575f99">7. első csoport</FluentOption>
    <FluentOption Value="df78676d-0f83-457a-8047-337088de4e0d">8. első csoport</FluentOption>
    <FluentOption Value="6c9e754f-f21c-469e-b58c-ba073a995a5c">8. második csoport</FluentOption>
</FluentSelect>
@if (!string.IsNullOrEmpty(selectClass) && taskView.Operations is not null)
{
    <AuthorizeView>
        <Authorized>
            <ClassLesson TaskView="taskView" Recives="recives" Send="CheckClass" IsChecked=IsChecked Next="NextClass"></ClassLesson>
        </Authorized>
        <NotAuthorized>
            <ClassLesson TaskView="taskView" Recives="recives" IsChecked=IsChecked></ClassLesson>
        </NotAuthorized>
    </AuthorizeView>
}
else if (!string.IsNullOrEmpty(selectClass))
{
    <h5>Adatok betöltése...</h5>
    <FluentProgressRing />
}
@code {
    string selectClass = string.Empty;
    public TaskView taskView = new();
    private OperationView currentOperation = new() { OperationId = 0 };
    private Guid UserId, ClassId;
    private bool IsChecked = false;
    private TaskRecive taskRecive = new();
    //private string message = string.Empty;
    private List<ClassRecive> recives = new();

    private async Task CheckClass(List<ClassRecive> _recives)
    {
        recives = await mService.ClassResult(_recives);
        IsChecked = true;
        StateHasChanged();
    }
    private async void SelectedClass(string arg)
    {
        selectClass = arg;
        await NextClass();
    }
    private async Task NextClass()
    {
        try
        {
            taskView = await mService.ClassLesson(Guid.Parse(selectClass));
            recives.Clear();
            IsChecked = false;
            if (taskView.Operations.Count>0)
            {
                foreach (var item in taskView.Operations)
                {
                    recives.Add(new ClassRecive { OperationId = item.OperationId, ClassId = ClassId, StudentId = UserId });
                }
            }
            else
            {
                toastService.ShowInfo("Nem található művelet");
            }
            StateHasChanged();
        }
        catch (Exception e)
        {
            toastService.ShowError(e.Message);
            throw;
        }
    }
}
