@page "/subject"
@using TeszterLibrary.Components

@inject SubjectServices sService
@inject IToastService tService
@inject IDialogService dService
<h3>Tárolt tantárgyak</h3>
<FluentDataGrid Items="@subjects.AsQueryable()">
    <PropertyColumn Property="c=>c.Name" Title="Tantárgy neve"></PropertyColumn>
    <TemplateColumn Title="Műveletek">
        <FluentButton Appearance="ButtonAppearance.Default" BackgroundColor="#009973" Color="white" OnClick="()=>Edit(context)">Szerkesztés</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Default" BackgroundColor="#ff1a1a" Color="white" OnClick="()=>Delete(context)">Törlés</FluentButton>
    </TemplateColumn>
</FluentDataGrid>
<FluentStack>
    <FluentTextInput @bind-Value="@newSubject" Placeholder="Új tantárgy neve..." />
    <FluentButton OnClick="Add">Új</FluentButton>
</FluentStack>
@code {
    List<Subject> subjects = new();
    bool noError = true;
    string errorMessage = string.Empty, newSubject = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        var loaded = await sService.GetSubjects();
        if (loaded is null)
        {
            // A lista üres marad: régen null lett, és a táblázat renderelése kivétellel elszállt.
            noError = false;
            errorMessage = "Nincs tantárgy";
            tService.ShowInfo(errorMessage);
            return;
        }
        subjects = loaded.OfType<Subject>().ToList();
    }
    async Task Add()
    {
        var subject = await sService.AddSubjectsAsync(new() { Name = newSubject });
        if (subject is null)
        {
            noError = false;
            errorMessage = $"Nem sikerült menteni a {newSubject} tantárgyat";
            tService.ShowError(errorMessage);
            return;
        }
        subjects.Add(subject);
        tService.ShowInfo($"{subject.Name} tantárgy mentésre került.");
        newSubject = string.Empty;
        StateHasChanged();
    }
    async Task Edit(Subject subject)
    {
        var data = new Subject();
        data = subject;
        var result = await dService.ShowDialogAsync<EditSubjectDialog>(options =>
        {
            options.Height = "240px";
            options.Header.Title = $"{subject.Id}.tantárgy módosítása";
            options.Header.CloseAction.Visible = true;
            options.Parameters.Add("Content", data);
        });

        if (!result.Cancelled && result.Value != null)
        {
            data = await sService.UpdateSubjectAsync((Subject)result.Value);
            if (data is null)
            {
                noError = false;
                errorMessage = $"Nem sikerült módosítani a {subject} tantárgyat";
                tService.ShowError(errorMessage);
                return;
            }
            StateHasChanged();
        }

    }
    async Task Delete(Subject subject)
    {
        // Csak akkor tűnik el a listából, ha az API valóban törölte (régen hiba esetén is eltűnt).
        if (await sService.DeleteSubjectAsync(subject))
        {
            subjects.Remove(subject);
            tService.ShowInfo($"{subject.Name} tantárgy törölve.");
        }
        else
        {
            tService.ShowError($"Nem sikerült törölni a(z) {subject.Name} tantárgyat. {sService.ErrorMessage}");
        }
    }
    }
