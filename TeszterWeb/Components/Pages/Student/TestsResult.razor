@page "/student/testsResult"
@using TeszterLibrary.ViewModel.Test
@using Microsoft.Identity.Web
@using Microsoft.Graph.Models
@inject GlobalData data
@inject NavigationManager navi
@inject TestUserServices tuService
@inject Microsoft.Graph.GraphServiceClient GraphServiceClient
@inject MicrosoftIdentityConsentAndConditionalAccessHandler ConsentHandler

<PageHeader Title="Eredményeim" Description="A már lezárult tesztjeid és az elért pontszámaid." />

@if (loading)
{
    <LoadingState Text="Eredmények betöltése..." />
}
else if (noError && tests is { Count: > 0 })
{
    <div class="card-grid card-grid--wide">
        @foreach (var test in tests)
        {
            <TestResultToStudentCard TestResult="test" Open="OpenResult" />
        }
    </div>
}
else
{
    <EmptyState Title="Még nincs eredményed" Message="@(string.IsNullOrEmpty(errorMessage) ? "A lezárt tesztek eredményei itt jelennek meg." : errorMessage)" Icon="@(new Icons.Regular.Size24.DataBarVertical())" />
}

@code {
    List<TestResultToStudent>? tests = new();
    bool noError = true;
    string errorMessage = string.Empty;

    bool loading = true;   // amíg az első betöltés tart, LoadingState látszik

    protected override async Task OnInitializedAsync()
    {
        try { await LoadAsync(); }
        finally { loading = false; }
    }

    private async Task LoadAsync()
    {
        data.Title = "Eredményeim";
        if (string.IsNullOrEmpty(data.UserId))
        {
            try
            {
                var user = await GraphServiceClient.Education.Me.GetAsync();
                if (user is not null)
                {
                    data.UserId = user.Id ?? throw new ArgumentNullException(nameof(user));
                }
            }
            catch (Exception ex)
            {
                ConsentHandler.HandleException(ex);
            }

        }
        if (data.UserGuid is not Guid userGuid)
        {
            noError = false;
            errorMessage = "Nem sikerült azonosítani a felhasználót. Jelentkezz be újra!";
            return;
        }
        tests = await tuService.GetReadyTests(userGuid);
        if (tests is null)
        {
            noError = false;
            errorMessage = "Nincs még befejezett teszted!";
        }
    }
    private void OpenResult(int tUserId)
    {
        navi.NavigateTo($"student/testresult/{tUserId}");
    }

}
