@page "/student/Math"
@implements IDisposable
@using TeszterLibrary.Services;
@using TeszterLibrary.ViewModel
@inject MathService mService
@inject GraphService graphService
@inject GlobalData data
@inject IToastService toastService
@inject ILogger<MathCourse> _logger

<h3>Kitűzött matematika feladat</h3>
<a class="btn btn-outline-primary challengeLink" href="/student/challenge">Időre menő kihívás</a>
<div class="gameRow">
    <StudentProgress Progress="progress" />
    <Leaderboard @ref="leaderboard" />
</div>
@if (IsClass)
{
    <ClassLesson TaskView="taskView" Recives="recives" Send="CheckClass" IsChecked=IsChecked Next="NextClass"></ClassLesson>
}
@if (currentOperation is not null && currentOperation.OperationId != 0)
{
    <p>Azonosító = @currentOperation.OperationId Feladat ID: @taskView.TaskId</p>
    <MathLesson Assignment="currentOperation" Send="@Next" IsChecked="IsChecked" IsCorrect="taskRecive.IsTipp" IsFraction="taskView.IsFraction" />
    @if (IsChecked && taskRecive.Score > 0)
    {
        <span class="xpGain">+@taskRecive.Score XP</span>
    }

}
else
{<h4>@message</h4>}

@code {
    public TaskView taskView = new();
    private OperationView currentOperation = new() { OperationId = 0 };
    private Guid UserId, ClassId;
    private bool IsChecked = false, IsError = false, IsClass = false, ShowModal = false;
    private TaskRecive taskRecive = new();
    System.Timers.Timer timer = new System.Timers.Timer();
    private int time = 0, allTime = 0;
    private string message = "Betöltés...";
    private List<ClassRecive> recives = new();
    private StudentProgressView? progress;
    private Leaderboard? leaderboard;

    /// <summary>A haladás frissítése; az újonnan megszerzett jelvényeket felugró üzenet jelzi.</summary>
    private async Task RefreshProgress()
    {
        var earnedBefore = progress?.Badges.Where(b => b.Earned).Select(b => b.Code).ToHashSet();
        var fresh = await mService.GetProgress(UserId);
        if (fresh is null) return;
        if (earnedBefore is not null)
        {
            foreach (var badge in fresh.Badges.Where(b => b.Earned && !earnedBefore.Contains(b.Code)))
                toastService.ShowSuccess($"Új jelvény: {badge.Name}!");
            if (fresh.Level > progress!.Level)
                toastService.ShowSuccess($"Szintet léptél: {fresh.Level}. szint!");
        }
        progress = fresh;
    }

    protected override void OnInitialized()
    {
        // Egyszer állítjuk be (régen minden első rendereléskor, a Start() után).
        timer.Interval = 1000;
        timer.Elapsed += (s, e) => { Interlocked.Increment(ref time); Interlocked.Increment(ref allTime); };
    }

    public void Dispose()
    {
        // Enélkül az időzítő elnavigálás után is futna, és életben tartaná a komponenst.
        timer.Stop();
        timer.Dispose();
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (string.IsNullOrEmpty(data.UserId))
            {
                try
                {
                    var user = await graphService.GetMe();
                    if (user is not null)
                    {
                        data.UserId = user.Id.ToString(); // ??= throw new ArgumentNullException(nameof(user));
                    }
                }
                catch (Exception ex)
                {
                    toastService.ShowError($"Hiba történt a UserId lekérésekor: {ex.Message}");
                    _logger.LogError(ex, "Hiba történt a UserId lekérésekor: {ex.Message}", ex.Message);
                }

            }
            if (data.UserGuid is not Guid userGuid)
            {
                toastService.ShowError("Nem sikerült azonosítani a felhasználót. Jelentkezz be újra!");
                return;
            }
            UserId = userGuid;
            await RefreshProgress();
            var first = await mService.Start(UserId);
            if (first is not null && first.Operations.Count > 0)
            {
                taskView = first;
                currentOperation = taskView.Operations[0];
                StateHasChanged();
                time = 0;
                timer.Start();
            }
            else
            {
                message = "Nincs kiadva újabb feladat számodra.";
                StateHasChanged();
            }
        }
    }
    private async Task Next(OperationView operation)
    {
        timer.Stop();
        TaskRecive recive = new() { OperationId = operation.OperationId, IsTipp = false, Result = operation.Result, Step = 0, StudentId = UserId, Time = time, TaskId = taskView.TaskId };
        var response = await mService.Result(recive);
        if (response is null)
        {
            // A szerver csak a neki kiadott, még megválaszolatlan feladatra fogad választ (pl. egy másik lapon már
            // továbbléptél, vagy frissítés volt): friss feladatsort kérünk, hogy ne ragadjon be ugyanarra.
            toastService.ShowWarning("Ezt a feladatot már nem lehet beküldeni, új feladatot kapsz.");
            var fresh = await mService.Start(UserId);
            if (fresh is not null && fresh.Operations.Count > 0)
            {
                taskView = fresh;
                currentOperation = taskView.Operations[0];
            }
            time = 0;
            timer.Start();
            return;
        }
        taskRecive = response;
        IsChecked = true;
        StateHasChanged();
        if (taskRecive.Step > 0 || taskRecive.Score > 0)
        {
            await RefreshProgress();
            if (leaderboard is not null) await leaderboard.RefreshAsync();
        }
        await Task.Delay(3000);
        taskView.Operations.Remove(operation);
        // Lépett (tovább/vissza), vagy elfogytak a feladatok: a szerver adja a következőket
        // (lépés nélkül ugyanazt a leckét folytatva). Régen üres listánál Operations[0] miatt összeomlott.
        if (taskRecive.Step > 0 || taskView.Operations.Count == 0)
        {
            var next = await mService.Start(UserId);
            if (next is null || next.Operations.Count == 0)
            {
                currentOperation = new() { OperationId = 0 };
                message = "Nagyon ügyes voltál, végeztél az összes feladattal!";
                IsChecked = false;
                return;
            }
            taskView = next;
        }
        currentOperation = taskView.Operations[0];
        time = 0;
        timer.Start();
        IsChecked = false;
    }
    private async Task NewUserId(ChangeEventArgs e)
    {
        if (e.Value?.ToString() == "57da251f-9472-46f2-b8ac-3b6aaeaece1c")
        {
            ClassId = Guid.Parse("57da251f-9472-46f2-b8ac-3b6aaeaece1c");   // a feltétel épp ezt az értéket ellenőrizte
            taskView = await mService.ClassLesson(ClassId);
            recives.Clear();
            IsChecked = false;
            foreach (var item in taskView.Operations)
            {
                recives.Add(new ClassRecive { OperationId = item.OperationId, ClassId = ClassId, StudentId = UserId });
            }
            time = 0;
            timer.Start();
            IsClass = true;
        }
        else
        {
            if (e.Value?.ToString().ToGuidOrNull() is not Guid selected)
            {
                toastService.ShowError("Érvénytelen felhasználó azonosító.");
                return;
            }
            UserId = selected;
            taskView = await mService.Start(UserId);

            if (taskView is not null)
            {
                currentOperation = taskView.Operations[0];
                StateHasChanged();
                time = 0;
                timer.Start();
                //timer.Elapsed += (s, e) =>	{time += 1;};
            }
            else
            {
                currentOperation = null;
            }
        }
    }
    private async Task CheckClass(List<ClassRecive> _recives)
    {
        timer.Stop();
        var avgTime = time / _recives.Count;
        foreach (var item in _recives)
        {
            item.Time = avgTime;
        }
        recives = await mService.ClassResult(_recives);
        IsChecked = true;
        StateHasChanged();
    }
    private async Task NextClass()
    {
        taskView = await mService.ClassLesson(ClassId);
        recives.Clear();
        IsChecked = false;
        foreach (var item in taskView.Operations)
        {
            recives.Add(new ClassRecive { OperationId = item.OperationId, ClassId = ClassId, StudentId = UserId });
        }
        time = 0;
        timer.Start();
    }
}
