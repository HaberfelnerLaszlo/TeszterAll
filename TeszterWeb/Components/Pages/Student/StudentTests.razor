@page "/studentTests"
@using Microsoft.Graph.Models
@inject Microsoft.Graph.GraphServiceClient GraphServiceClient
@inject ILogger<StudentTests> _logger
@inject IToastService toastService
@inject GlobalData data
@inject NavigationManager navi
@inject TestUserServices tuService
@inject IToastService toastService

<h5 hidden="@noError">@errorMessage</h5>
@if (tests != null && tests.Any())
{
    <FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Horizontal" Wrap="true" HorizontalGap="20" VerticalGap="20">
        @foreach (var item in tests)
        {
            <FluentCard Width="450px">
                <TestViewCard TestItem="@item" Start="@TestStart" Results="@TestResults" />
            </FluentCard>
        }
    </FluentStack>
}
else
{
    <FluentOverlay @bind-Visible=@noError
                   Opacity="0.4"
                   Alignment="Microsoft.FluentUI.AspNetCore.Components.Align.Center"
                   Justification="@JustifyContent.Center">
        <FluentProgressRing />
    </FluentOverlay>
}
@code {
    private List<TestView>? tests = new();
    bool noError = true;
    string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        data.Title = "Tesztek";
        if (String.IsNullOrEmpty(data.UserId))
        {
            var user = await GraphServiceClient.Me.GetAsync();
            if (user is null || user.Id is null)
            {
                toastService.ShowWarning("Hiba lépet fel a user.Id lekérdezésekor.");
                _logger.LogWarning("A userId lekérdezésénél hiba lépet fel.");
                return;
            }
            data.UserId = user.Id.ToString();
            _logger.LogInformation($"Newtest: Kértem új Id-t {data.UserId}");
        }
        tests = await tuService.GetTests(Guid.Parse(data.UserId));
        if (tests == null)
        {
            noError = false;
            if (tuService.ErrorMessage.Equals("Nincs eredmény."))
            {
                errorMessage = "Nincs már aktív teszted!";
            }
            errorMessage = tuService.ErrorMessage;
            toastService.ShowError(errorMessage);
            return;
        }
    }
    void TestStart(TestView test)
    {
        data.Test = new() { IsCheck = test.IsCheck, IsPractice = test.IsPractice, IsTimer = test.IsTimer, ShuffleQuestion = test.ShuffleQuestion, Title = test.Title, Time = test.Time };
        navi.NavigateTo($"runtest/{test.TestUserId}");
    }
    async void TestResults(string testUserId)
    {
        data.TestResults= await tuService.GetTestQuestions(int.Parse(testUserId)) ?? new();
        navi.NavigateTo($"student/testResult/{testUserId}");//Eredmények megtekintésére lehet tovább menni.
    }
}
