@layout TeszterWeb.Components.Layout.TestLayout
@page "/runtest/{id:int}"
@inject TestLoader loader
@inject NavigationManager navi
@inject TestUserServices tuService

@if (noError)
{
    if (testStart)
    {
        <ViewQinTest Id="@Id" IsTimer="@test.IsTimer" Title="@test.Title" IsCheck="test.IsCheck" IsShuffle="test.ShuffleQuestion" TestEnd="EndTest"></ViewQinTest>
    }
    else if (testEnd)
    {
        <div class="test-screen">
            <FluentCard>
                <div class="test-screen__body">
                    <FluentIcon Value="@(new Icons.Filled.Size24.CheckmarkCircle())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Success" Class="test-screen__icon" />
                    <FluentText As="TextTag.H1" Size="TextSize.Size700" Weight="TextWeight.Semibold">Nagyszerű!</FluentText>
                    <FluentText Size="TextSize.Size400">Sikerült megoldanod a tesztet.</FluentText>
                    <div class="test-screen__actions">
                        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.DataBarVertical())" OnClick="ResultView">Eredmény megtekintése</FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Default" OnClick="@(() => navi.NavigateTo("/home"))">Vissza a kezdőlapra</FluentButton>
                    </div>
                </div>
            </FluentCard>
        </div>
    }
    else
    {
        <div class="test-screen">
            <FluentCard>
                <div class="test-screen__body">
                    <FluentIcon Value="@(new Icons.Regular.Size24.ClipboardTaskListLtr())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Primary" Class="test-screen__icon" />
                    <FluentText Size="TextSize.Size300" Class="test-screen__kicker">A következő teszt</FluentText>
                    <FluentText As="TextTag.H1" Size="TextSize.Size700" Weight="TextWeight.Semibold">@test.Title</FluentText>
                    <ul class="test-screen__facts">
                        @if (test.IsTimer)
                        {
                            <li><FluentIcon Value="@(new Icons.Regular.Size20.Timer())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Primary" /> Időkorlátos: <strong>@test.Time.ToTime()</strong> áll rendelkezésedre.</li>
                        }
                        @if (test.IsPractice)
                        {
                            <li><FluentIcon Value="@(new Icons.Regular.Size20.CalligraphyPenQuestionMark())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Primary" /> Gyakorló teszt.</li>
                        }
                        @if (test.IsCheck)
                        {
                            <li><FluentIcon Value="@(new Icons.Regular.Size20.CheckmarkCircle())" Color="Microsoft.FluentUI.AspNetCore.Components.Color.Primary" /> Kitöltés közben ellenőrizheted a válaszaidat.</li>
                        }
                    </ul>
                    <div class="test-screen__actions">
                        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Play())" OnClick="StartTest">A teszt elkezdése</FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Default" OnClick="@(() => navi.NavigateTo("/home"))">Vissza a kezdőlapra</FluentButton>
                    </div>
                </div>
            </FluentCard>
        </div>
    }
}
else
{
    <div class="test-screen">
        <FluentMessageBar Intent="MessageBarIntent.Error">@errorMessage</FluentMessageBar>
    </div>
}

@code {
    [Parameter] public int Id { get; set; } //TestUserId
    bool noError = false, testStart = false, testEnd = false;
    string errorMessage = "A teszt betöltése folyamatban...";
    Test test = new();

    // A beállításokat (időzítő, ellenőrzés, keverés) az azonosító alapján töltjük be, így frissítés után is megvannak.
    // Régen a GlobalData-ból jöttek: F5 után üres teszt lett, időzítő nélkül.
    protected override async Task OnParametersSetAsync()
    {
        var loaded = await loader.LoadTestForStudentAsync(Id);
        noError = loaded.Ok;
        errorMessage = loaded.Error ?? string.Empty;
        test = loaded.Value ?? new();
    }
    void StartTest()
    {
        testStart = true;
        StateHasChanged();
    }
    void EndTest(List<QuestionView> questions)
    {
        testStart = false;
        testEnd = true;
    }
    void ResultView()
    {
        navi.NavigateTo($"student/testResult/{Id}");//Eredmények megtekintésére lehet tovább menni.
    }
}
