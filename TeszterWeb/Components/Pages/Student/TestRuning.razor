@layout TeszterWeb.Components.Layout.TestLayout
@page "/runtest/{id:int}"
@inject TestLoader loader
@inject NavigationManager navi
@inject TestUserServices tuService

@if (noError)
{
    if (testStart)
    {
        <ViewQinTest Id="@Id" IsTimer="@test.IsTimer" Title="@test.Title" IsCheck="test.IsCheck" IsShuffle="test.ShuffleQuestion" TestEnd="EndTest"></ViewQinTest>
    }
    else if (testEnd)
    {
        <h3>Nagyszerű!</h3><h4> Sikerült megoldanod a tesztet!</h4>
        <FluentButton OnClick="ResultView">Eredmény megtekintése</FluentButton>
    }
    else
    {
        <h4>A @test.Title teszt megírása következik.</h4> <hr/>
       <h6>
            @if (test.IsTimer)
            {
                <span>A tesztet <b> @test.Time.ToTime() </b> alatt kell megírnod. </span>
            }
            @if (test.IsPractice)
            {
                <span> A teszt gyakorlásra szolgál.</span>
            }
            @if (test.IsCheck)
            {
                <span> A teszt kitöltése közben a kérdések helyessége lekérdezhető.</span>
            }
        </h6>
        <hr />
<FluentButton Appearance="Appearance.Accent" Color="yellow" OnClick="StartTest">A teszt elkezdése</FluentButton>
        <FluentButton Appearance="Appearance.Neutral" OnClick="@(() => navi.NavigateTo("/home"))">Vissza a főoldalra</FluentButton>
    }

}
else
{
    <h5>@errorMessage</h5>
}
@code {
    [Parameter] public int Id { get; set; } //TestUserId
    bool noError = false, testStart = false, testEnd = false;
    string errorMessage = "A teszt betöltése folyamatban...";
    Test test = new();

    // A beállításokat (időzítő, ellenőrzés, keverés) az azonosító alapján töltjük be, így frissítés után is megvannak.
    // Régen a GlobalData-ból jöttek: F5 után üres teszt lett, időzítő nélkül.
    protected override async Task OnParametersSetAsync()
    {
        var loaded = await loader.LoadTestForStudentAsync(Id);
        noError = loaded.Ok;
        errorMessage = loaded.Error ?? string.Empty;
        test = loaded.Value ?? new();
    }
    void StartTest()
    {
        testStart = true;
        StateHasChanged();
    }
    void EndTest(List<QuestionView> questions)
    {
        testStart = false;
        testEnd = true;
    }
    void ResultView()
    {
        navi.NavigateTo($"student/testResult/{Id}");//Eredmények megtekintésére lehet tovább menni.
    }
}
