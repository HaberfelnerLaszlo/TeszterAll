@page "/Student/testResult"
@page "/Student/testResult/{i:int}"
@inject GlobalData data
@inject TestQuestionUserServices tquService
@inject NavigationManager navi
@inject IToastService toastService
@inject ILogger<TestResult> logger

<h4>Teszt eredménye</h4>
@if (noError)
{
    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Start">
        @foreach (var j in tabs)
        {
            if (actual == j) { apperance = Appearance.Accent; }
            else { apperance = Appearance.Neutral; }
            <FluentButton OnClick="@(() => ActualChanged(j))" Appearance="apperance">@j</FluentButton>
        }
    </FluentStack>
    <hr/>
    foreach (var actualq in questions)
    {
        <FluentCard>
            @if (actualq.QuestionType == QuestionType.Comp)
            {
                <FluentLabel>Egészítsd ki a szöveget!</FluentLabel>
            }
            else
            {
                <FluentLabel Typo="Typography.Subject">@((MarkupString)actualq.QuestionText)</FluentLabel>
            }

            <FluentLabel>Kapott pontok: @actualq.Score pont</FluentLabel>
            @switch (actualq.QuestionType)
            {
                case QuestionType.SC:
                    <Test_choise Type="@("radio")" Answers="actualq.Answers" IsCheck="false" IsChecked="true" />
                    break;
                case QuestionType.MC:
                    <Test_choise Type="@("checkbox")" Answers="actualq.Answers" IsCheck="false" IsChecked="true" />
                    break;
                case QuestionType.TF:
                    <Test_TF Answers="actualq.Answers" IsCheck="false" IsChecked="true" />
                    break;
                case QuestionType.Open:
                    <Test_open Answers="actualq.Answers" IsCheck="false" IsChecked="true" />
                    break;
                case QuestionType.Seq:
                    <Test_sequence Answers="actualq.Answers" IsCheck="false" IsChecked="true" />
                    break;
                case QuestionType.Pair:
                    <Test_pair Answers="actualq.Answers" IsCheck="false" IsChecked="true" />
                    break;
                case QuestionType.Comp:
                    <Test_comp Answers="actualq.Answers" Texts="@actualq.QuestionText" IsCheck="false" IsChecked="true" />
                    break;
                default:
        <p>Nem tudom mi történt! </p>@actualq.QuestionType.ToString()
                    break;
            }
        </FluentCard>
        <br />
    }
    @if (i == 0)
    {
        <FluentButton Appearance="Appearance.Accent" OnClick="@(()=>navi.NavigateTo("/"))">Bezár</FluentButton>
    }
    else
    {
        <FluentButton Appearance="Appearance.Accent" OnClick="@(()=>navi.NavigateTo("student/testsResult"))">Bezár</FluentButton>
    }
}
else
{
    <p>@errorMessage</p>
}
@code {
    [Parameter] public int i { get; set; } = 0; //TestUserId
    List<QuestionView> questions = new();
    List<TestQuestionUser> testQuestionUsers = new();
    bool noError = true;
    int max = 1, actual=1;
    int[] tabs = {1};
    string errorMessage = string.Empty;
    Appearance apperance= Appearance.Neutral;

    protected override async void OnInitialized()
    {
        questions = data.TestResults.ToList();
        if (questions is null || questions.Count==0)
        {
            noError = false;
            errorMessage = "Nincsenek teszt kérdés eredményeid!";
            toastService.ShowWarning(errorMessage);
            logger.LogWarning(errorMessage);

            return;
        }
        else
        {
            testQuestionUsers = await tquService.GetTestQuestionUsers(i);
            if (testQuestionUsers is null)
            {
                errorMessage = "Nem lehetet lekérni az eredményidet!";
                toastService.ShowWarning(errorMessage);
                logger.LogWarning(errorMessage);
                return;
            }
            else
            {
                max = testQuestionUsers.LastOrDefault()?.ReplacedNumber??1;
                tabs = new int[max];
                for (int i = 0; i < max; i++)
                {
                    tabs[i]=i + 1;
                }
                ActualQuestion(max);
                actual = max;
            }
            StateHasChanged();
        }
    }
    void ActualChanged(int i)
    {
        ActualQuestion(i);
        actual = i;
        StateHasChanged();
    }
    void ActualQuestion(int i)
    {
        if (testQuestionUsers.Count > 0)
        {
            foreach (var tqu in testQuestionUsers.Where(t => t.ReplacedNumber == i))
            {
                var actualQ = questions.First(q => q.TestQuestionId == tqu.TestQuestionId);
                tqu.Answers.ForEach(tqa =>
                {
                    var actualA = actualQ.Answers.First(a => a.AnswerId == tqa.AnswerId);
                    actualA.Result = tqa.Result;
                    actualA.Sequence = tqa.Sequence;
                    actualA.Sign = tqa.Sign;
                    actualA.Text = tqa.Text;
                });
            }
        }
    }
}
