@inject NavigationManager Navigation

@code {
    // Belépés után a felhasználó oda tér vissza, ahová eredetileg tartott (csak helyi útvonal engedélyezett).
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"MicrosoftIdentity/Account/SignIn?redirectUri={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
