@page "/Closedtest/{id}"
@inject TestServices tService
<h3>Lezárt Tesztek</h3>
@if (tests is null)
{
    <p>Tesztek betöltése folyamatban...</p>
    <Waiting/>
}
else
{
    <div class="flex-lg-row">
    @foreach (var item in tests)
    {
        <TestViewCard Test="item">

        </TestViewCard>
    }

    </div>
}
@code {
    [Parameter] public string Id { get; set; }
    List<Test> tests = new();
    protected override async Task OnInitializedAsync()
    {
        tests = await tService.GetClosedTests(Guid.Parse(Id));
        //return base.OnInitializedAsync();
    }
}
