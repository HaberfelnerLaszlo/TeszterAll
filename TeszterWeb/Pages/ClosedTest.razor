@page "/Closed"
@inject GlobalData data
@inject NavigationManager navi
@inject TestServices tService
<h3>Lezárt Tesztek</h3>
@if (tests is null)
{
    <p>Tesztek betöltése folyamatban...</p>
    <Waiting/>
}
else
{
    <div class="d-flex flex-wrap">
    @foreach (var item in tests)
    {
        <TestViewCard Test="item" BtnText="Eredmények" Edit="TestResult"/>
    }
    </div>
}
@code {
    List<Test> tests = new();
    protected override async Task OnInitializedAsync()
    {
        tests = await tService.GetClosedTests(Guid.Parse(data.UserId));
        //return base.OnInitializedAsync();
    }
    private void TestResult(Test test)
    {
        data.Test = test;
    }
}
