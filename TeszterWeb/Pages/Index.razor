@page "/"
@using Microsoft.AspNetCore.Components
@using Microsoft.Identity.Web
@using Microsoft.Graph.Models
@inject Microsoft.Graph.GraphServiceClient GraphServiceClient
@inject MicrosoftIdentityConsentAndConditionalAccessHandler ConsentHandler
@inject EduUserServices uService
@inject GlobalData data
<PageTitle>Kezdőlap</PageTitle>
<SurveyPrompt Title="How is Blazor working for you?" />
<AuthorizeView Roles="Teacher">
    Tanárok látják.
    <nav class="d-flex flex-row w-100">
        <div class="nav-doboz"><NavLink class="nav-link" href="newtest">Új teszt készítése</NavLink></div>
        <div class="nav-doboz"><NavLink class="nav-link" href="draft">Nem aktívált tesztek</NavLink></div>
        <div class="nav-doboz"><NavLink class="nav-link" href="active">Aktív tesztek</NavLink></div>
        <div class="nav-doboz"><NavLink class="nav-link" href="closed">Befejezett tesztek</NavLink></div>
        <div class="nav-doboz"><NavLink class="nav-link" href="counter">Archivált tesztek</NavLink></div>
        <div class="nav-doboz"><NavLink class="nav-link" href=@qHref>Kérdések</NavLink></div>
    </nav>
</AuthorizeView>
@code{
    EducationUser? user;
    string closedHref=string.Empty, qHref=string.Empty;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                user = await GraphServiceClient.Education.Me.GetAsync();
                if (user is not null)
                {
                    data.UserId = user.Id;
                    closedHref=$"closedtest/{user.Id}";
                    qHref = $"question/{user.Id}";
                    if (!(await uService.UserExits(Guid.Parse(user.Id))))
                    {
                        await uService.AddUser(new EduUser() { DisplayName = user.DisplayName, Id = Guid.Parse(user.Id), Role=user.PrimaryRole.Value.ToString()});
                    }
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                ConsentHandler.HandleException(ex);
            }
        }
    }
}