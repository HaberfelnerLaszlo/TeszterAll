@using Microsoft.Graph.Models
@using Microsoft.Graph;
@using Microsoft.Kiota.Abstractions.Authentication;
@using TeszterLibrary.Services;
@inject GraphService gService
@inject TestServices tService
@inject TestUserServices tuService
@inject EduUserServices uService
<EditForm Model="@Teszt" OnValidSubmit="Publish">
	<div class="form-group">
		<label for="Title">Teszt címe: </label>
		<InputText id="Title" @bind-Value="@Teszt.Title"></InputText>
	</div>
	<hr />
	<div class="form-group">
		<label for="StartTime">Teszt kezdete: </label>
		<input type="datetime-local" id="StartTime" format-value="{0:yyyy.MM.dd hh:mm}" @bind-value="@Teszt.StartTime" />
		<label for="EndTime">Teszt zárása: </label>
		<input type="datetime-local" id="EndTime" format-value="{0:yyyy.MM.dd hh:mm}" @bind-value="@Teszt.EndTime" />
	</div>
	<hr />
	<div class="form-group">
		<label class="m-1" for="praktise">Gyakorlás? </label>
		<InputCheckbox id="praktise" class="m-1" @bind-Value="Teszt.IsPractice"></InputCheckbox>
		<label class="m-1" for="praktise">Tanuló ellenőrizheti? </label>
		<InputCheckbox id="praktise" class="m-1" @bind-Value="Teszt.IsCheck"></InputCheckbox>
		<label class="m-1" for="timer">Válasz időre megy? </label>
		<InputCheckbox id="timer" class="m-1" @bind-Value="Teszt.IsTimer"></InputCheckbox>
		<label class="m-1" for="Replace">Hányszor ismételhető? </label>
		<InputNumber id="Replace" class="m-1" @bind-Value="Teszt.ReplaceNumber"></InputNumber>
	</div>
	<div style="margin-top: 1rem">
		<label>Kérdések keverése </label>
		<FluentSwitch CheckedMessage="Kérdések keverése" Value=@Teszt.ShuffleQuestion Style="margin-bottom: 20px" />
	</div>
	<hr />
    <InputSelect class="m-1 m-lg-2" TValue="string" Value="SelectGroupId" ValueExpression="@(()=>SelectGroupId)" ValueChanged="SelectGroup">
		<option value="">Válasz csoportot...</option>
		@foreach (var item in Groups)
		{
			<option value="@item.Id">@item.DisplayName</option>
		}
        </InputSelect>
 	<hr />
	@if (Members.Count > 0 || TestMembers.Count > 0)
	{
		<div class="row">

			<div class="col-lg-4 bg-dark text-white text-center">
				Csoport tagjai
			</div>
			<div class="col-4 offset-2 bg-success text-center">
				Tesztet ír
			</div>
		</div>
		<div class="row">
			<Plk.Blazor.DragDrop.Dropzone Class="col-lg-4 bg-light" TItem="EducationUser" Items="Members" Context="member" OnItemDrop="@((i)=>lastdropped = i)">
				<div class="p-1" style="border: 2px solid black;">
					<!--!-->
					@member.DisplayName
				</div>
			</Plk.Blazor.DragDrop.Dropzone>
			<div class="col-2 bg-white text-center">
				<button class="btn btn-block" @onclick="All" disabled="@BtnDidabled">Mindenki</button>
				<button class="btn btn-block" @onclick="Reverse" disabled="@(!BtnDidabled)">Senki sem</button>
			</div>

			<Plk.Blazor.DragDrop.Dropzone Class="col-4 bg-light" TItem="EducationUser" Items="TestMembers" Context="testmember" OnItemDrop="@((i)=>lastdropped = i)">

				<div class="p-1" style="border: 2px solid black;">
					<!--!-->
					@testmember.DisplayName
				</div>
			</Plk.Blazor.DragDrop.Dropzone>
		</div>

	}
    <div class="m-2 row justify-content-center">
        <button class="btn btn-group-vertical" type="submit" >Közzététel</button>
    </div>
</EditForm>
<div class="d-flex center">
	<p>@message</p>
</div>

@code {
	[Parameter] public Test Teszt { get; set; } = new();
	[Parameter] public string UserId { get; set; }
	[Parameter] public EventCallback Published { get; set; }

	public List<EducationClass> Groups { get; set; } = new();
	private List<EducationUser> Members = new List<EducationUser>();
	private List<EducationUser> TestMembers = new List<EducationUser>();
	private string SelectGroupId = string.Empty;
	private EducationUser lastdropped { get; set; }
	private bool BtnDidabled = false;
	private GraphServiceClient? graph;
	string message = string.Empty;
	protected override async Task OnParametersSetAsync()
	{
		Groups = await gService.GetClasses(UserId);
		Teszt.StartTime = DateTime.Now;
		Teszt.EndTime =Teszt.StartTime.AddDays(1);
	}
	private async Task SelectGroup(string id)
	{
		Members.Clear();
		SelectGroupId = id;
		if (id != null)
		{
			var members = await gService.GetStudents(id);
			foreach (var item in members)
			{
				if (item.PrimaryRole is null)
				{
					Members.Add(new () { DisplayName = item.DisplayName, Id = item.Id, PrimaryRole = EducationUserRole.Student});
				}
				else if (item.PrimaryRole.Value == EducationUserRole.Student)
				{
					Members.Add(new () { DisplayName = item.DisplayName, Id = item.Id, PrimaryRole = item.PrimaryRole.Value});
				}
			}
		}
	}

	private void All()
	{
		TestMembers.AddRange(Members);
		Members.Clear();
		BtnDidabled = true;
	}
	private void Reverse()
	{
		Members.AddRange(TestMembers);
		TestMembers.Clear();
		BtnDidabled = false;
	}
	private async Task Publish(EditContext context)
	{
		bool active = true;
		message = "Mentést elkezdtem";
		Teszt.IsPublished = true;
		if (DateTime.Compare(Teszt.StartTime,Teszt.EndTime)<0)
		{
			var temp = Teszt.StartTime;
			Teszt.StartTime = Teszt.EndTime;
			Teszt.EndTime = temp;
		}
		if (Teszt.StartTime > DateTime.Now)
		{
			active = false;
		}
		foreach (var item in TestMembers)
		{
			await tuService.AddTestUser(new TestUser() { TestId = Teszt.Id, UserId = Guid.Parse(item.Id), ReplaceNumber = 0, IsActive = active, EndTime = Teszt.EndTime, Test = null });
			var HasUser = await uService.UserExits(Guid.Parse(item.Id));
			if (!HasUser)
			{
				await uService.AddUser(new EduUser() { DisplayName = item.DisplayName, Id = Guid.Parse(item.Id), Role = item.PrimaryRole.Value.ToString() });
			}
		}
		Teszt.TestQuestions = null;
		Teszt.TestUsers = null;
		Teszt.IsPublished = true;
		var response= await tService.UpdateTestAsync(Teszt);
		if (response !=null)
		{
			message = "Elmentve";
			await Published.InvokeAsync();
		}
		else
		{
			message = "Mentés nem sikerült! "+tService.ErrorMessage;
		}
	}
}
