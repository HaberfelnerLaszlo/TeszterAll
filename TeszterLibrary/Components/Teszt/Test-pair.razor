@using TeszterLibrary.Extensions;
@inject IToastService toastService
@inject ILogger<Test_pair> logger
@if (Answers is not null)
{
    <FluentDragContainer TItem="string"
                         OnDropEnd="@(e => HandleDropEnd(e.Source.Id,e.Target.Id))">
        <FluentStack Orientation="Orientation.Horizontal">
            <FluentStack Orientation="Orientation.Vertical">
                @foreach (var item in Answers)
                {
                    @if (item.Sign)
                    {
                        var text = pairs.GetValueOrDefault(item.Sequence);
                        @if (text is null)
                        {
                            toastService.ShowError("Hiba történt a kérdés megjelenítése során!");
                            logger.LogError("Hiba történt a kérdés megjelenítése során!");
                            return;
                        }
                        <FluentStack Orientation="Orientation.Horizontal">
                            <div style="width:1fr; background-color:khaki;margin:10px; padding:5px;">
                                @item.Text
                            </div>
                            <FluentDropZone Id="@item.AnswerId.ToString()" Draggable="false" Droppable="true">
                                <div style="border: 2px dotted red; width:1fr; background-color:lightblue;margin:10px;padding:5px;">
                                    @text
                                </div>
                            </FluentDropZone>
                            @if (!text.Equals("Ide kerül a párja..."))
                            {
                                <FluentButton IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Delete())" OnClick="@(()=>BackList(item.Sequence))" />
                            }
                        </FluentStack>
                    }
                    @if (IsChecked && !item.Sign)
                    {
                        <span hidden="@item.Result"><FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Dismiss())" Color="@Color.Error" /></span>
                        <span style="color:green" hidden="@(!item.Result)"><FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Checkmark())" /></span>
                    }
                    <FluentDivider Orientation="Orientation.Horizontal" Role="DividerRole.Separator"></FluentDivider>
                }
            </FluentStack>
            <FluentStack Orientation="Orientation.Vertical">
                @foreach (var item in selectList)
                {
                    <FluentDropZone Id="@item.AnswerId.ToString()" Draggable="true" Droppable="false">
                        <div style="width:1fr;margin:10px; padding:5px;">
                            @item.Text
                        </div>
                    </FluentDropZone>
                }
            </FluentStack>
        </FluentStack>
    </FluentDragContainer> <div class="container">
    </div>
    <div class="container text-center">
        @if (IsCheck)
        {
            <FluentButton OnClick="@((async)=> CallCheck.InvokeAsync(Answers))">Ellenőrzés</FluentButton>
        }
        @if (Next.HasDelegate)
        {
            <FluentButton OnClick="@((async)=> Send())">Következő</FluentButton>
        }
    </div>
}
@code {
    [Parameter] public List<AnswerView> Answers { get; set; } = new();
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> Next { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> CallCheck { get; set; }
    List<AnswerView> selectList = new();
    List<AnswerView> tempList = new();
    Dictionary<int, string> pairs = new();
    protected override void OnAfterRender(bool firstRender)
    {
        //if (firstRender)
        //{
        foreach (var item in Answers)
        {
            if (IsChecked)
            {
                if (!item.Sign)
                {
                    pairs.Add(item.Sequence, item.Text);
                }
            }
            else
            {
                if (item.Sequence == -1)
                {
                    selectList.Add(item);
                }
                else
                {
                    pairs.Add(item.Sequence, "Ide kerül a párja...");
                }
            }
        }
        if (selectList.Any())
        {
            selectList.Shuffle();
        }
        //}
    }
    void Send()
    {
        if (selectList.Count == 0)
        {
            Next.InvokeAsync(Answers);
        }
    }
    void HandleDropEnd(string source, string target)
    {
        var masol = selectList.Find(j => j.AnswerId == Convert.ToInt32(source));
        var cel = Answers.FirstOrDefault(l => l.AnswerId == Convert.ToInt32(target));
        if (masol is null || cel is null)
        {
            toastService.ShowError("Hiba történt a sorbarendezés során!");
            logger.LogError("Hiba történt a sorbarendezés során!");
            return;
        }
        pairs[cel.Sequence] = masol.Text;
        masol.Sequence = cel.Sequence;
        tempList.Add(masol);
        selectList.Remove(masol);
    }
    void BackList(int sequence)
    {
        var temp = tempList.FirstOrDefault(i => i.Sequence == sequence);
        if (temp is null)
        {
            return;
        }
        selectList.Add(temp);
        tempList.Remove(temp);
        pairs[sequence] = "Ide kerül a párja...";
    }
}
