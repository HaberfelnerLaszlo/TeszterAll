@inject IDialogService DialogService
<FluentMultiSplitter Orientation="Orientation.Horizontal">
    <FluentMultiSplitterPane Min="20%">
        <div style="padding: 10px; border: 1px solid #ccc; margin: 10px;">
            @SafeHtml.Markup(Texts)
        </div>
    </FluentMultiSplitterPane>
    <FluentMultiSplitterPane Min="50%">
            @if (Answers.Count > 0)
            {
                <FluentTabs>
                    @foreach (var answer in Answers) 
                    {
                        var seq = answer.Sequence;
                        <FluentTab @key="@seq" Header="@($"{seq}. feladat {answer.Score} pont")" Id="@($"tab-{seq}")" Data="@answer">
                            <div style="padding: 10px; border: 1px solid #ccc;margin: 10px;">
                                @SafeHtml.Markup(answer.Text)
                            </div>
                        <FluentTextInput @bind-Value="answer.AnswerText" Placeholder="Írd ide a válaszod!" Label="Válaszod"/>
                            @if(answer.AnswerHelpers?.Count > 0)
                            {
                                <FluentText Block="true">Válasz segítők: </FluentText>
                                @foreach (var item in answer.AnswerHelpers) 
                                {
                                    <FluentButton Title="@item.Sequence.ToString()" IconEnd="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Info())" OnClick="@(async () => await DialogService.ShowInfoAsync(item.Text, $"{item.Sequence}. segítség", "Bezár"))" />
                                }
                            }
                        </FluentTab> 
                    }
                </FluentTabs>
            }
    </FluentMultiSplitterPane>
</FluentMultiSplitter>
<div class="container text-center">
    @if (IsCheck)
    {
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => CallCheck.InvokeAsync(Answers))">
            Ellenőrzés
        </FluentButton>
    }
    @if (Next.HasDelegate)
    {
        <FluentButton OnClick="@(() => Next.InvokeAsync(Answers))">
            Következő
        </FluentButton>
    }
</div>

@code {
[Parameter]
    public string Texts { get; set; } = "";
    [Parameter]
    public List<AnswerView> Answers { get; set; } = new();
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> Next { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> CallCheck { get; set; }
}
