@implements IDialogContentComponent<Question>
@using System.Numerics;

@* Header *@
<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(new Icons.Regular.Size24.WindowApps())" />
        <FluentLabel Typo="Typography.PaneHeader">
            @Dialog.Instance.Parameters.Title
        </FluentLabel>
    </FluentStack>
    <FluentStack>
        <FluentNumberField style="width:60px" @bind-Value="Content.Score">Pontszám:</FluentNumberField>
        <FluentNumberField style="width:70px" @bind-Value="Content.Time">Idő:</FluentNumberField>
    </FluentStack>
</FluentDialogHeader>

@* Footer *@
<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Accent" OnClick="@(()=>Check(null))">Ellenőrzés</FluentButton>
    <FluentButton Appearance="Appearance.Neutral" OnClick="@CancelAsync">Bezárás</FluentButton>
</FluentDialogFooter>

@* Body *@
<FluentDialogBody>
    <EditForm Model="@Content">
        @if (Content.QType == QuestionType.Comp)
        {
            <FluentLabel>Egészítsd ki a szöveget!</FluentLabel>
        }
        else
        {
            <FluentLabel Typo="Typography.Subject">@((MarkupString)questionView.QuestionText)</FluentLabel>
        }
        <hr />
        @switch (Content.QType)
        {
            case QuestionType.SC:
                <Test_choise Type="@("radio")" Answers="questionView.Answers" IsCheck="true" IsChecked="IsChecking" CallCheck="Check" />
                break;
            case QuestionType.MC:
                <Test_choise Type="@("checkbox")" Answers="questionView.Answers" IsCheck="true" IsChecked="IsChecking" CallCheck="Check" />
                break;
            case QuestionType.TF:
                <Test_TF Answers="questionView.Answers" IsCheck="true" IsChecked="IsChecking" CallCheck="Check" />
                break;
            case QuestionType.Open:
                <Test_open Answers="questionView.Answers" IsCheck="true" IsChecked="IsChecking" CallCheck="Check" />
                break;
            case QuestionType.Seq:
                <Test_sequence Answers="questionView.Answers" IsCheck="true" IsChecked="IsChecking" CallCheck="Check"></Test_sequence>
                break;
            case QuestionType.Pair:
                <Test_pair Answers="questionView.Answers" IsCheck="true" CallCheck="Check" IsChecked="IsChecking" />
                break;
            case QuestionType.Comp:
                <Test_comp Answers="questionView.Answers" Texts="@questionView.QuestionText" IsCheck="true" IsChecked="IsChecking" CallCheck="Check" />
                break;
            default:
                <p>Nem tudom mi történt!  @Content.QType.ToString()</p>
                break;
        }
    </EditForm>
</FluentDialogBody>

@code {
    [Parameter]
    public Question Content { get; set; } = default!;

    [CascadingParameter]
    public FluentDialog Dialog { get; set; } = default!;
    [Parameter]
    public EventCallback<Question> Delete { get; set; }

    private List<AnswerView> answers = new List<AnswerView>();
    private bool IsChecking = false;//,IsWrong = true, IsRight = true;
    QuestionView questionView = new() { Answers=new(), QuestionText=string.Empty};

    protected override Task OnInitializedAsync()
    {
        questionView.QuestionText = Content.Text;

        if (Content.QType == QuestionType.Pair)
        {
            foreach (var item in Content.Answers)
            {
                if (!item.Right)
                {
                    questionView.Answers!.Add(new()
                    {
                        AnswerId = item.Id,
                        Result = false,
                        Sequence = -1,
                        Sign = false,
                        Text = item.Text
                    });
                } else
                    questionView.Answers!.Add(new()
                    {
                        AnswerId = item.Id,
                        Result = false,
                        Sequence = item.Sequence,
                        Sign = true,
                        Text = item.Text
                    });
            }
        }
        else
        {
            foreach (var item in Content.Answers)
            {
                questionView.Answers!.Add(new() { AnswerId = item.Id, Result = false, Sequence = item.Sequence, Sign = false, Text = item.Text });
            }
        }
        //else
        //{
        //    foreach (var item in Content.Answers)
        //    {
        //        // originAnswer.Add(item.Id, item.Right);
        //        answers.Add(new() { AnswerId = item.Id, Result = false, Sequence = item.Sequence, Sign = false, Text = item.Text });
        //        questionView.Answers = answers;
        //    }
        //}
        return base.OnInitializedAsync();
    }
    private async Task SaveAsync()
    {
        await Dialog.CloseAsync(Content);
    }

    private async Task CancelAsync()
    {
        await Dialog.CancelAsync();
    }
    private void Check(List<AnswerView>? answerViews)
    {
        if (answerViews != null)
        {
            answers = answerViews;
        }
        IsChecking = true;
        switch (Content.QType)
        {
            case QuestionType.SC:
                foreach (var item in answers)
                {
                    item.Result = (item.Sign == Content.Answers.FirstOrDefault(a => a.Id == item.AnswerId)!.Right) ? true : false;
                }
                break;
            case QuestionType.MC:
                {
                    foreach (var item in answers)
                    {
                        item.Result = (item.Sign == Content.Answers.FirstOrDefault(a => a.Id == item.AnswerId)!.Right) ? true : false;
                    }
                }
                break;
            case QuestionType.TF:
                {
                    foreach (var item in answers)
                    {
                        item.Result = (item.Sign == Content.Answers.FirstOrDefault(a => a.Id == item.AnswerId)!.Right) ? true : false;
                    }
                }
                break;
            case QuestionType.Open:
                {
                    foreach (var item in answers)
                    {
                        if (item.Text.Equals(Content.Answers.FirstOrDefault(a => a.Id == item.AnswerId)!.Text))
                        { item.Result = true; }
                    }
                }
                break;
            case QuestionType.Seq:
                {
                    foreach (var item in answers)
                    {
                        if (item.Sequence == Content.Answers.FirstOrDefault(a=>a.Id==item.AnswerId)!.Sequence)
                        { item.Result = true; }
                    }
                }
                break;
            case QuestionType.Pair: //CheckPair() megoldva.
                foreach (var item in answers)
                {
                    item.Result = Content.Answers!.FirstOrDefault(a => a.Id == item.AnswerId)!.Sequence == item.Sequence ? true : false;
                }
                break;
            case QuestionType.Comp:
                {
                    foreach (var item in answers)
                    {
                        if (item.Text.Equals(Content.Answers.FirstOrDefault(a => a.Id == item.AnswerId).Text))
                        {
                            item.Result = true;
                        }
                    }
                }
                break;
            default:
                break;
        }
    }
}
