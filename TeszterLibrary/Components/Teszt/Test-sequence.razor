@using TeszterLibrary.Extensions;
@if (QView is not null)
{
    <div class="container-fluid text-center">
        <textarea class="form-control-lg d-flex d-sm-flex justify-content-sm-center align-items-sm-start" id="question" autocomplete="off" readonly name="question">@QView.QuestionText</textarea>
    </div>
    <FluentDragContainer TItem="string"
                         OnDropEnd="@(e => HandleDropEnd(e.Source.Id,e.Target.Id))">
        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center">
            @foreach (var item in Items.OrderBy(i => i.Sequence))
            {
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                    <FluentDropZone Id="@item.AnswerId.ToString()" Draggable="true" Droppable="true">
                        <div style=" margin-bottom: 5px; margin-top: 5px; border-radius: 10px; background: rgba(150,239,223,0.31); border-color: rgb(8,42,77); box-shadow: 1px 1px; padding: 10px; ">
                            @item.Text
                        </div>
                    </FluentDropZone>
                    @if (IsChecked)
                    {
                        <span hidden="@item.Result"><FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Color="@Color.Error" /></span>
                        <span style="color:green" hidden="@(!item.Result)"><FluentIcon Value="@(new Icons.Regular.Size16.Checkmark())" /></span>
                    }
                </FluentStack>
            }
        </FluentStack>
    </FluentDragContainer>

    <div class="container text-center">
        @if (IsCheck)
        {
            <FluentButton Appearance="Appearance.Accent" OnClick="@(()=>CallCheck.InvokeAsync(QView))">
                Ellenőrzés
            </FluentButton>
        }
        @if (Next.HasDelegate)
        {
            <button class="btn btn-primary" id="send" type="button" @onclick="@Send">
                Következő
            </button>
        }
    </div>
}
@code {
    [Parameter] public QuestionView? QView{ get; set; }
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<QuestionView> Next { get; set; }
    [Parameter] public EventCallback<QuestionView> CallCheck { get; set; }
    bool first = true;
    string row = string.Empty;
    void Send() => Next.InvokeAsync(QView);
    List<AnswerView> Items = new();
    protected override void OnInitialized()
    {
        if (first)
        {
            if (QView is not null)
            {
                if (QView.Answers is not null)
                {
                    QView.Answers.Shuffle();
                    for (int i = 0; i < QView.Answers.Count; i++)
                    {
                        QView.Answers[i].Sequence = i + 1;
                    }
                    Items = QView.Answers;
                }
            }
            first = false;
        }
        base.OnInitialized();
    }
    void Up(int id)
    {
        row = "Fel: " + id.ToString();
        if (id > 1)
        {
            Items[id - 1].Sequence = id - 1;
            Items[id - 2].Sequence = id;
            Items = Items.OrderBy(i => i.Sequence).ToList();
        }
        StateHasChanged();
    }
    void Down(int id)
    {
        row = "Le: " + id.ToString();
        if (id < Items.Count)
        {
            Items[id - 1].Sequence = id + 1;
            Items[id].Sequence = id;
            Items = Items.OrderBy(i => i.Sequence).ToList();
        }
        StateHasChanged();
    }
    void HandleDropEnd(string source, string target)
    {
        var forras = Items.Find(j => j.AnswerId == Convert.ToInt32(source));
        var cel = Items.Find(j => j.AnswerId == Convert.ToInt32(target));
        if (forras !=null && cel!=null)
        {
            var hely = forras.Sequence;
            forras.Sequence = cel.Sequence;
            cel.Sequence = hely;
        }
    }
