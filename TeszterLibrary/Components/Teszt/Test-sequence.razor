@using TeszterLibrary.Extensions;
@if (Answers is not null)
{
    <FluentDragContainer TItem="string"
                         OnDropEnd="@(e => HandleDropEnd(e.Source.Id,e.Target.Id))">
        <FluentText Size="TextSize.Size200" Class="answer-hint">Húzd a válaszokat a helyes sorrendbe.</FluentText>
        <div class="answer-list">
            @foreach (var item in Items.OrderBy(i => i.Sequence))
            {
                <div class="seq-row">
                    <FluentDropZone Id="@item.AnswerId.ToString()" Draggable="true" Droppable="true" Class="seq-row__zone">
                        <div class="seq-item">
                            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.ReOrderDotsVertical())" Color="Color.Neutral" />
                            <span>@item.Text</span>
                        </div>
                    </FluentDropZone>
                    @if (IsChecked)
                    {
                        <AnswerResult Correct="item.Result" />
                    }
                </div>
            }
        </div>
    </FluentDragContainer>

    <QuestionActions ShowCheck="IsCheck" OnCheck="@(() => CallCheck.InvokeAsync(Items))" OnNext="@(Next.HasDelegate ? EventCallback.Factory.Create(this, () => Next.InvokeAsync(Items)) : default)" />
}
@code {
    [Parameter] public List<AnswerView> Answers { get; set; } = new();
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> Next { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> CallCheck { get; set; }
    bool first = true;
    string row = string.Empty;
    int maxLenght = 0;
    //void Send() => Next.InvokeAsync(QView);
    List<AnswerView> Items = new();
    protected override void OnParametersSet()
    {
        maxLenght = 10;
        foreach (var item in Answers)
        {
            if (maxLenght < item.Text.Length)
            {
                maxLenght = item.Text.Length;
            }
        }
        maxLenght = maxLenght * 15;
        base.OnParametersSet();
    }
    protected override void OnInitialized()
    {
        if (first)
        {
            //if (QView is not null)
            //{
            if (Answers is not null)
            {
                Answers.Shuffle();
                for (int i = 0; i < Answers.Count; i++)
                {
                    Answers[i].Sequence = i + 1;
                }
                Items = Answers;
            }
            //}
            first = false;
        }
        base.OnInitialized();
    }
    void Up(int id)
    {
        row = "Fel: " + id.ToString();
        if (id > 1)
        {
            Items[id - 1].Sequence = id - 1;
            Items[id - 2].Sequence = id;
            Items = Items.OrderBy(i => i.Sequence).ToList();
        }
        StateHasChanged();
    }
    void Down(int id)
    {
        row = "Le: " + id.ToString();
        if (id < Items.Count)
        {
            Items[id - 1].Sequence = id + 1;
            Items[id].Sequence = id;
            Items = Items.OrderBy(i => i.Sequence).ToList();
        }
        StateHasChanged();
    }
    void HandleDropEnd(string source, string target)
    {
        var sourceId = source.ToIntOrNull();
        var targetId = target.ToIntOrNull();
        var forras = sourceId is null ? null : Items.Find(j => j.AnswerId == sourceId);
        var cel = targetId is null ? null : Items.Find(j => j.AnswerId == targetId);
        if (forras !=null && cel!=null)
        {
            var hely = forras.Sequence;
            forras.Sequence = cel.Sequence;
            cel.Sequence = hely;
        }
    }
