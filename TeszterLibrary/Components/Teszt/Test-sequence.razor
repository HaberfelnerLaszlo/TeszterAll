@using TeszterLibrary.Extensions;
@if (Answers is not null)
{
    <FluentDragContainer TItem="string"
                         OnDropEnd="@(e => HandleDropEnd(e.Source.Id,e.Target.Id))">
        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center">
            @foreach (var item in Items.OrderBy(i => i.Sequence))
            {
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="HorizontalAlignment.Center">
                    <FluentDropZone Id="@item.AnswerId.ToString()" Draggable="true" Droppable="true">
                        <div class="answer" style="width: @(maxLenght+20)px; text-align: center; font-size: 2vw;">
                            @item.Text
                        </div>
                    </FluentDropZone>
                    @if (IsChecked)
                    {
                        <span hidden="@item.Result"><FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Dismiss())" Color="@Color.Error" /></span>
                        <span style="color:green" hidden="@(!item.Result)"><FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Checkmark())" /></span>
                    }
                </FluentStack>
            }
        </FluentStack>
    </FluentDragContainer>

    <div class="container text-center" style="margin:10px">
        @if (IsCheck)
        {
            <FluentButton Appearance="Appearance.Accent" OnClick="@(()=>CallCheck.InvokeAsync(Items))">
                Ellenőrzés
            </FluentButton>
        }
        @if (Next.HasDelegate)
        {
            <FluentButton Appearance="Appearance.Neutral" OnClick="@(()=>Next.InvokeAsync(Items))">Következő</FluentButton>
        }
    </div>
}
@code {
    [Parameter] public List<AnswerView> Answers { get; set; } = new();
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> Next { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> CallCheck { get; set; }
    bool first = true;
    string row = string.Empty;
    int maxLenght = 0;
    //void Send() => Next.InvokeAsync(QView);
    List<AnswerView> Items = new();
    protected override void OnParametersSet()
    {
        maxLenght = 10;
        foreach (var item in Answers)
        {
            if (maxLenght < item.Text.Length)
            {
                maxLenght = item.Text.Length;
            }
        }
        maxLenght = maxLenght * 15;
        base.OnParametersSet();
    }
    protected override void OnInitialized()
    {
        if (first)
        {
            //if (QView is not null)
            //{
            if (Answers is not null)
            {
                Answers.Shuffle();
                for (int i = 0; i < Answers.Count; i++)
                {
                    Answers[i].Sequence = i + 1;
                }
                Items = Answers;
            }
            //}
            first = false;
        }
        base.OnInitialized();
    }
    void Up(int id)
    {
        row = "Fel: " + id.ToString();
        if (id > 1)
        {
            Items[id - 1].Sequence = id - 1;
            Items[id - 2].Sequence = id;
            Items = Items.OrderBy(i => i.Sequence).ToList();
        }
        StateHasChanged();
    }
    void Down(int id)
    {
        row = "Le: " + id.ToString();
        if (id < Items.Count)
        {
            Items[id - 1].Sequence = id + 1;
            Items[id].Sequence = id;
            Items = Items.OrderBy(i => i.Sequence).ToList();
        }
        StateHasChanged();
    }
    void HandleDropEnd(string source, string target)
    {
        var forras = Items.Find(j => j.AnswerId == Convert.ToInt32(source));
        var cel = Items.Find(j => j.AnswerId == Convert.ToInt32(target));
        if (forras !=null && cel!=null)
        {
            var hely = forras.Sequence;
            forras.Sequence = cel.Sequence;
            cel.Sequence = hely;
        }
    }
