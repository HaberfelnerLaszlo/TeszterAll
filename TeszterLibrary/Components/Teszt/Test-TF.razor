
@if (Answers is not null)
{
    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Start">
        @foreach (var answer in Answers)
        {
            <FluentStack HorizontalAlignment="HorizontalAlignment.Start">

                <FluentCheckbox Label="@answer.Text" @bind-Value="answer.Sign" />
                @if (IsChecked)
                {
                    if (answer.Result)
                    {
                        <FluentIcon Value="@(new Icons.Regular.Size16.Checkmark())" />
                    }
                    else
                    {
                        <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Color="@Color.Error" />
                    }
                }
            </FluentStack>
        }
    </FluentStack>
    <div class="container text-center">
        @if (IsCheck)
        {
            <FluentButton Appearance="Appearance.Accent" OnClick="@(()=>CallCheck.InvokeAsync(Answers))">
                Ellenőrzés
            </FluentButton>
        }
        @if (Next.HasDelegate)
        {
            <FluentButton Appearance="Appearance.Neutral" OnClick="@(()=>Next.InvokeAsync(Answers))">
                Következő
            </FluentButton>
        }
    </div>
}

@code {
    [Parameter] public List<AnswerView> Answers { get; set; } = new();
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> Next { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> CallCheck { get; set; }
}
