@using TeszterLibrary.Extensions
@using System.Diagnostics
@inject TestUserServices tuService
@if (noError)
{
    @* Header *@
<FluentLayout Style="margin-top: 10px;">
    <FluentHeader>
        <FluentIcon Value="@(new Icons.Regular.Size24.WindowApps())" />
        <FluentSpacer />
        <FluentLabel Typo="Typography.PaneHeader">@Title</FluentLabel>
    </FluentHeader>
@if (actualq is not null && actualq.QuestionType!=QuestionType.All)
{
    <FluentStack Width="100%">
        <FluentBodyContent>
            <EditForm Model="@actualq">
                @if (actualq.QuestionType == QuestionType.Comp)
                {
                    <FluentLabel>Egészítsd ki a szöveget!</FluentLabel>
                }
                else
                {
                    <FluentLabel Typo="Typography.Subject">@((MarkupString)actualq.QuestionText)</FluentLabel>
                }

                @switch (actualq.QuestionType)
                {
                    case QuestionType.SC:
                        <Test_choise Type="@("radio")" Answers="actualq.Answers" IsCheck="true" IsChecked="IsChecked" CallCheck="Check" Next="Next" />
                        break;
                    case QuestionType.MC:
                        <Test_choise Type="@("checkbox")" Answers="actualq.Answers" IsCheck="true" IsChecked="IsChecked" CallCheck="Check" Next="Next" />
                        break;
                    case QuestionType.TF:
                        <Test_TF Answers="actualq.Answers" IsCheck="true" IsChecked="IsChecked" CallCheck="Check" Next="Next" />
                        break;
                    case QuestionType.Open:
                        <Test_open Answers="actualq.Answers" IsCheck="true" IsChecked="IsChecked" CallCheck="Check" Next="Next" />
                        break;
                    case QuestionType.Seq:
                        <Test_sequence Answers="actualq.Answers" IsCheck="true" IsChecked="IsChecked" CallCheck="Check" Next="Next"></Test_sequence>
                        break;
                    case QuestionType.Pair:
                        <Test_pair Answers="actualq.Answers" IsCheck="true" CallCheck="Check" IsChecked="IsChecked" Next="Next" />
                        break;
                    case QuestionType.Comp:
                        <Test_comp Answers="actualq.Answers" Texts="@actualq.QuestionText" IsCheck="true" IsChecked="IsChecked" CallCheck="Check" Next="Next" />
                        break;
                    default:
                        <p>Nem tudom mi történt! @actualq.QuestionType.ToAttributeValue()</p>
                        break;
                }
            </EditForm>
            <span>@time</span><span>   @actualq.Time</span>

        </FluentBodyContent>
    </FluentStack>

    @* Footer*@
    @if (IsTimer)
    {
        <FluentFooter Style="@("height: 40px; color: white; text-align: center;")">
            <FluentProgress Value="time" Min="0" Max="actualq.Time" Stroke="ProgressStroke.Large" Width="300px">
            <span>@time</span>
            </FluentProgress>
            @*<FluentStack Orientation="Orientation.Horizontal">
                    <FluentButton Appearance="Appearance.Accent" OnClick="@Check">Ellenőrzés</FluentButton>
                    <FluentSpacer />
                    <FluentButton Appearance="Appearance.Neutral" OnClick="@Next">@(questions.Count==1?"Teszt vége": "Következő")</FluentButton>
                </FluentStack>*@
        </FluentFooter>
    }
}
</FluentLayout>
}
else
{
    <p>@errorMessage</p>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public bool IsTimer { get; set; } = false;
    [Parameter] public bool IsShuffle { get; set; } = false;
    [Parameter] public bool IsCheck { get; set; } = false;
    [Parameter] public string Title { get; set; } = "A teszt címe";
    [Parameter] public EventCallback<List<QuestionView>> TestEnd { get; set; }
    List<QuestionView> questions = new();
    List<QuestionView> readyQuestions = new();
    QuestionView actualq =new();
    bool noError = true, testStart = false, IsChecked=false;
    string errorMessage = string.Empty;
    System.Timers.Timer timer = new();
    int time=0;
    protected override async Task OnParametersSetAsync()
    {
        questions = await tuService.GetTestQuestions(Id);
        if (questions is null)
        {
            noError = false;
            errorMessage = tuService.ErrorMessage;
            return;
        }
        if (IsShuffle)
        {
            questions.Shuffle();
        }
        actualq = questions.FirstOrDefault();
        if (actualq is null)
        {
            noError = false;
            errorMessage = "Nem határozható meg a kérdés.";
            return;
        }
        StateHasChanged();
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            TimerStart();
        }
        base.OnAfterRender(firstRender);
    }
    protected void TimerStart()
    {
        timer.Interval = 1000;
        time = 0;
        timer.Elapsed += async (s, e) =>
        {
            time++;
            if (IsTimer && time==actualq.Time)
            {
                await Next(actualq.Answers);
                return;
                //timer.Stop();
            }
            await InvokeAsync(StateHasChanged);
        };
        timer.Start();
    }

    async void Check(List<AnswerView> answers)
    {
        QuestionView question = new() { Answers = answers, QuestionType = actualq.QuestionType, QuestionText=actualq.QuestionText, Score=actualq.Score, TestQuestionId=actualq.TestQuestionId, Time=actualq.Time};
        var resp = await tuService.GetQuestionCheck(question, Id);
        if (resp==null)
        {
            noError = false;
            errorMessage = "A kérdés ellenőrzésekor hiba lépett fel.";
        }
        actualq = resp;
        IsChecked = true;
        StateHasChanged();
    }
    async Task Next(List<AnswerView> answers)
    {
        IsChecked = false;
        timer.Stop();
        QuestionView question = new() { Answers = answers, QuestionType = actualq.QuestionType, QuestionText = actualq.QuestionText, Score = actualq.Score, TestQuestionId = actualq.TestQuestionId, Time = time };
        var response= await tuService.GetQuestionResult(question,Id);
        if (response is null)
        {
            noError = false;
            errorMessage = "Nem határozható meg a kérdés eredménye.";
            return;
        }
        readyQuestions.Add(response);
        if (!questions.Remove(question))
            questions.RemoveAt(0);
        if (questions.Count > 0)
        {
            actualq = questions.FirstOrDefault(); 
        }
        else {
            timer.Dispose();
            
            await TestEnd.InvokeAsync(readyQuestions);
            return;
        }
        if (actualq is null)
        {
            noError = false;
            errorMessage = "Nem határozható meg a kérdés.";
            return;
        }
        time = 0;
        timer.Start();
        //StateHasChanged();
    }
}