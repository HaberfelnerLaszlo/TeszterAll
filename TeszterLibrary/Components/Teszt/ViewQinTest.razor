@using TeszterLibrary.Extensions
@using System.Diagnostics
@implements IDisposable
@inject TestUserServices tuService
@inject ILogger<ViewQinTest> _logger
@if (noError)
{
    <div class="quiz">
        @* Fejléc: teszt címe, haladás *@
        <div class="quiz__header">
            <FluentText As="TextTag.H1" Size="TextSize.Size600" Weight="TextWeight.Semibold">@Title</FluentText>
            @if (total > 0)
            {
                <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Brand" Content="@($"{Current}. / {total} kérdés")" />
            }
        </div>
        @if (total > 0)
        {
            <FluentProgressBar Min="0" Max="@total" Value="@(Current - 1)" Class="quiz__progress" />
        }

        @if (actualq is not null && actualq.QuestionType != QuestionType.All)
        {
            <FluentCard Class="quiz__card">
                <EditForm Model="@actualq">
                    <div class="quiz__question">
                        @if (actualq.QuestionType == QuestionType.Comp)
                        {
                            <FluentText Size="TextSize.Size500" Weight="TextWeight.Semibold">Egészítsd ki a szöveget!</FluentText>
                        }
                        else
                        {
                            <div class="quiz__question-text">@SafeHtml.Markup(actualq.QuestionText)</div>
                        }
                    </div>

                    @switch (actualq.QuestionType)
                    {
                        case QuestionType.SC:
                            <Test_choise Type="@("radio")" Answers="actualq.Answers" IsCheck="IsCheck" IsChecked="IsChecked" CallCheck="Check" Next="Next" />
                            break;
                        case QuestionType.MC:
                            <Test_choise Type="@("checkbox")" Answers="actualq.Answers" IsCheck="IsCheck" IsChecked="IsChecked" CallCheck="Check" Next="Next" />
                            break;
                        case QuestionType.TF:
                            <Test_TF Answers="actualq.Answers" IsCheck="IsCheck" IsChecked="IsChecked" CallCheck="Check" Next="Next" />
                            break;
                        case QuestionType.Open:
                            <Test_open Answers="actualq.Answers" IsCheck="IsCheck" IsChecked="IsChecked" CallCheck="Check" Next="Next" />
                            break;
                        case QuestionType.Seq:
                            <Test_sequence Answers="actualq.Answers" IsCheck="IsCheck" IsChecked="IsChecked" CallCheck="Check" Next="Next"></Test_sequence>
                            break;
                        case QuestionType.Pair:
                            <Test_pair Answers="actualq.Answers" IsCheck="IsCheck" CallCheck="Check" IsChecked="IsChecked" Next="Next" />
                            break;
                        case QuestionType.Comp:
                            <Test_comp Answers="actualq.Answers" Texts="@actualq.QuestionText" IsCheck="IsCheck" IsChecked="IsChecked" CallCheck="Check" Next="Next" />
                            break;
                        case QuestionType.Komp:
                            <Test_komp Answers="actualq.Answers" Texts="@actualq.QuestionText" IsCheck="IsCheck" IsChecked="IsChecked" CallCheck="Check" Next="Next" />
                            break;
                        default:
                            <FluentMessageBar Intent="MessageBarIntent.Error">Ismeretlen kérdéstípus: @actualq.QuestionType</FluentMessageBar>
                            break;
                    }
                </EditForm>
            </FluentCard>

            @* Idő: a kérdésre fordított idő, időkorlátnál sávval *@
            <div class="quiz__timer @(IsTimer && actualq.Time > 0 && actualq.Time - time <= 10 ? "is-urgent" : null)">
                <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Timer())" Color="Color.Neutral" />
                <span>@time.ToTime() / @actualq.Time.ToTime()</span>
                @if (IsTimer)
                {
                    <FluentProgressBar Value="time" Min="0" Max="actualq.Time" Width="240px" />
                }
            </div>
        }
    </div>
}
else
{
    <FluentMessageBar Intent="MessageBarIntent.Error">@errorMessage</FluentMessageBar>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public bool IsTimer { get; set; } = false;
    [Parameter] public bool IsShuffle { get; set; } = false;
    [Parameter] public bool IsCheck { get; set; } = false;
    [Parameter] public string Title { get; set; } = "A teszt címe";
    [Parameter] public EventCallback<List<QuestionView>> TestEnd { get; set; }
    List<QuestionView>? questions = new();
    List<QuestionView> readyQuestions = new();
    QuestionView? actualq = new();
    bool noError = true, IsChecked = false;//testStart = false
    string errorMessage = string.Empty;
    int time = 0;
    int total;                                           // a teszt kérdéseinek száma (a haladásjelzőhöz)
    int Current => questions is null ? 0 : total - questions.Count + 1;

    private System.Timers.Timer? _timer;                 // másodpercenként frissíti a kijelzőt és ellenőrzi az időkorlátot
    private readonly Stopwatch _stopwatch = new();       // a valós eltelt idő (a timer ketyegése csúszhat)
    private int _loadedId = int.MinValue;
    private bool _busy;                                  // egyszerre egy beküldés/ellenőrzés: a felhasználó és az időkorlát ne ütközhessen
    private bool _disposed;

    protected override async Task OnParametersSetAsync()
    {
        // A szülő újrarenderelése is meghívja; a tesztet csak új azonosítónál töltjük be, különben elölről indulna.
        if (Id == _loadedId) return;

        questions = await tuService.GetTestQuestions(Id);
        if (questions is null)
        {
            noError = false;
            errorMessage = tuService.ErrorMessage;
            return;
        }
        if (IsShuffle)
        {
            questions.Shuffle();
        }
        total = questions.Count;
        actualq = questions.FirstOrDefault();
        if (actualq is null)
        {
            noError = false;
            errorMessage = "Nem határozható meg a kérdés.";
            return;
        }
        _loadedId = Id;
        StartQuestionTimer();     // az adat megérkezése után indul (régen az első rendereléskor, amikor még nem volt kérdés)
    }

    private void StartQuestionTimer()
    {
        time = 0;
        _stopwatch.Restart();
        _timer ??= CreateTimer();
        _timer.Start();
    }

    private System.Timers.Timer CreateTimer()
    {
        var timer = new System.Timers.Timer(1000) { AutoReset = true };
        // Az Elapsed a szálkészleten fut: az állapothoz csak a renderer szinkron-kontextusán (InvokeAsync) nyúlunk.
        timer.Elapsed += (_, _) => { if (!_disposed) _ = InvokeAsync(OnTickAsync); };
        return timer;
    }

    // Egész másodperc, 0,1 s toleranciával: a System.Timers.Timer néha picit korábban ketyeg, és a csonkolás
    // ilyenkor 1 s-ot "veszítene", vagyis a lejárat a következő ketyegésre (+1 s) csúszna.
    private int ElapsedSeconds() => (int)(_stopwatch.Elapsed.TotalSeconds + 0.1);

    private async Task OnTickAsync()
    {
        if (_disposed || _busy || actualq is null) return;
        try
        {
            time = ElapsedSeconds();
            if (IsTimer && actualq.Time > 0 && time >= actualq.Time)
            {
                await Next(actualq.Answers ?? new List<AnswerView>());   // lejárt az idő: a jelenlegi válaszokkal továbblépünk
            }
            StateHasChanged();
        }
        catch (ObjectDisposedException)
        {
            // a komponens közben megszűnt
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Hiba a teszt időzítőjének léptetésekor.");
        }
    }

    async Task Check(List<AnswerView> answers)
    {
        if (_busy) return;
        if (actualq is null)
        {
            _logger.LogWarning("A actual kérdés null.");
            return;
        }
        _busy = true;
        try
        {
            QuestionView question = new() { Answers = answers, QuestionType = actualq.QuestionType, QuestionText = actualq.QuestionText, Score = actualq.Score, TestQuestionId = actualq.TestQuestionId, Time = actualq.Time };
            var resp = await tuService.GetQuestionCheck(question, Id);
            if (resp == null)
            {
                noError = false;
                errorMessage = "A kérdés ellenőrzésekor hiba lépett fel.";
                _logger.LogWarning(errorMessage);
                return;
            }
            actualq = resp;
            IsChecked = true;
        }
        finally
        {
            _busy = false;
        }
    }

    async Task Next(List<AnswerView> answers)
    {
        if (_busy) return;
        if (actualq is null)
        {
            _logger.LogWarning("A actual kérdés null.");
            return;
        }
        _busy = true;
        try
        {
            IsChecked = false;
            _timer?.Stop();
            var elapsed = ElapsedSeconds();
            if (IsTimer && actualq.Time > 0) elapsed = Math.Min(elapsed, actualq.Time);   // időkorláton túl nem számolunk
            QuestionView question = new() { Answers = answers, QuestionType = actualq.QuestionType, QuestionText = actualq.QuestionText, Score = actualq.Score, TestQuestionId = actualq.TestQuestionId, Time = elapsed };
            var response = await tuService.GetQuestionResult(question, Id);
            if (response is null)
            {
                noError = false;
                errorMessage = "Nem határozható meg a kérdés eredménye.";
                _logger.LogWarning(errorMessage);
                return;
            }
            readyQuestions.Add(response);
            if (questions is null)
            {
                noError = false;
                errorMessage = "A kérdések halmaza null.";
                _logger.LogWarning(errorMessage);
                return;
            }
            if (questions.Count > 0)
            {
                questions.RemoveAt(0);          // a mostani (mindig az első) kérdés kész
            }
            if (questions.Count == 0)
            {
                await TestEnd.InvokeAsync(readyQuestions);
                return;
            }
            actualq = questions[0];
            StartQuestionTimer();
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        if (_timer is not null)
        {
            _timer.Stop();
            _timer.Dispose();
        }
    }
}
