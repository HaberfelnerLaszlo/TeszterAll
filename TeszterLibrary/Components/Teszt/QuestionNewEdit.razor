@using Microsoft.FluentUI.AspNetCore.Components

@using Microsoft.JSInterop;
@using Plk.Blazor.DragDrop;
@inject IJSRuntime js
@inject IToastService toastService

<div class="question-editor">
    <Modal Accept="CloseModal" AcceptButtom="Rendben" Show="errorMessage!=string.Empty">
        <HeaderContent>
            <p>Figyelmeztetés!</p>
        </HeaderContent>
        <BodyContent>
            <FluentText>@errorMessage</FluentText>
        </BodyContent>
    </Modal>
    <FluentGrid>
        <FluentGridItem Xs="12" Sm="6">
            <FluentStack Orientation="Orientation.Vertical">
                @*A kérdés általános adatai*@
                <div class="editor-section">
                    <FluentText As="TextTag.H2" Size="TextSize.Size500" Weight="TextWeight.Semibold" Class="editor-section__title">@(New? "Új kérdés":"Kérdés módosítása")</FluentText>
                    <EditForm Model="@newQuestion">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="field">
                            <FluentSelect Id="qType" TOption="string" TValue="string" Value="@newQuestion.QType.ToString()" ValueChanged="@((string? t) => qTypeChanged(t ?? string.Empty))" Disabled=!New Placeholder="Válassza ki a kérdés fajtáját.." Label="Kérdés típusa:">
                                <FluentOption TValue="string" Value="@("SC")">Felelet választás</FluentOption>
                                <FluentOption TValue="string" Value="@("MC")">Több válaszos</FluentOption>
                                <FluentOption TValue="string" Value="@("TF")">Igaz-Hamis</FluentOption>
                                <FluentOption TValue="string" Value="@("Open")">Nyílt végű</FluentOption>
                                <FluentOption TValue="string" Value="@("Seq")">Sorbarendezés</FluentOption>
                                <FluentOption TValue="string" Value="@("Pair")">Párosítás</FluentOption>
                                <FluentOption TValue="string" Value="@("Comp")">Kiegészítő</FluentOption>
                            </FluentSelect>
                        </div>
                        @if (!hiddenForm)
                        {
                            <div>
                                @if (subjects.Count > 0)
                                {
                                    <FluentSelect Id="Subject" Items="subjects" TOption="Subject" TValue="string" @bind-Value="@newQuestion.Subject" Label="Tantárgy" OptionText="@(s => s?.Name ?? string.Empty)" OptionValue="@(s => s?.Name)">
                                    </FluentSelect>
                                }
                                <Modal Accept="SaveSubject" AcceptButtom="Tantárgy mentése" Cancel="CloseSubjectModal" CancelButtom="Mégsem" Show=showModal>
                                    <HeaderContent>
                                        <p>Új tantárgy felvétele</p>
                                    </HeaderContent>
                                    <BodyContent>
                                        <FluentTextInput @bind-Value="subjectName" Label="Tantárgy neve" Width="100%" />
                                    </BodyContent>
                                </Modal>
                                <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Add())" OnClick="@(()=>showModal=true)">Új tantárgy</FluentButton>
                                <div class="field">
                                    <FluentTextInput Id="title" @bind-Value="@newQuestion.Title" Label="Kérdés címe / témaköre" Required="true" Width="100%" />
                                </div>
                                <div class="field">
                                    <FluentTextInput Id="subtitle" @bind-Value="@newQuestion.Subtitle" Label="Kérdés alcím" Width="100%" />
                                </div>
                                <div class="field">
                                    <FluentTextArea Id="qText" @bind-Value="@newQuestion.Text" Style="width:100%" />
                                    <TeszterLibrary.Components.RichTextEditorWithImage @ref="textEditor" Context="@newQuestion.Text" />
                                    <div hidden="@(newQuestion.QType!=QuestionType.Comp)">
                                        <FluentText Size="TextSize.Size200" Class="hint">Kiegészítendő kérdés esetén {szám} jelöléssel lehet megadni a kiegészítés helyét.</FluentText>
                                        <FluentButton @onclick="Insert">{@k} beszúrása</FluentButton>
                                    </div>
                                </div>
                                <div class="field">
                                    <FluentGrid>
                                        <FluentGridItem Xs="12" Sm="6">
                                            <FluentNumberInput Name="score" @bind-Value="@newQuestion.Score" Label="Pontszám" />
                                        </FluentGridItem>
                                        <FluentGridItem Xs="12" Sm="6">
                                            <FluentNumberInput Name="time" class="ido-sec" @bind-Value="@newQuestion.Time" Label="Időtartam /másodperc/" />
                                        </FluentGridItem>
                                    </FluentGrid>
                                </div>
                                <div>
                                    <div class="grade-range">
                                        <FluentNumberInput Name="grade" @bind-Value="@newQuestion.MinGrade" Width="100px" @oninput="minGradeChange" min="1" max="12" Label="Évfolyamtól" />
                                        <span class="grade-range__dash">–</span>
                                        <FluentNumberInput Name="grade" @bind-Value="@newQuestion.MaxGrade" Width="100px" min="1" max="12" Label="Évfolyamig" />
                                    </div>
                                </div>
                            </div>
                        }
                    </EditForm>
                </div>
            </FluentStack>
        </FluentGridItem>
        <FluentGridItem Xs="12" Sm="6">
            <FluentStack Orientation="Orientation.Vertical">
                <div class="editor-section answers" hidden="@hiddenForm">
                    <FluentText As="TextTag.H2" Size="TextSize.Size500" Weight="TextWeight.Semibold" Class="editor-section__title">Válaszok</FluentText>
                    @switch (newQuestion.QType)
                    {
                        case QuestionType.SC:
                        case QuestionType.MC:
                        case QuestionType.Comp:
                            {
                                @foreach (var item in newAnswers)
                                {
                                    <NewAnswer newAnswer="item" questionType="newQuestion.QType" DeleteAnswer="@deleteAnswer"></NewAnswer>
                                }
                            }
                            break;
                        case QuestionType.TF:
                            {
                                <FluentMessageBar Intent="MessageBarIntent.Info">Írd le az eldöntendő állításokat, és jelöld, melyik igaz.</FluentMessageBar>
                                @foreach (var item in newAnswers)
                                {
                                    <NewAnswer newAnswer="item" questionType="newQuestion.QType" DeleteAnswer="@deleteAnswer"></NewAnswer>
                                }
                            }
                            break;
                        case QuestionType.Open:
                            {
                                foreach (var item in newAnswers)
                                {
                                    <NewAnswer newAnswer="item" questionType="newQuestion.QType" DeleteAnswer="@deleteAnswer"></NewAnswer>
                                }
                            }
                            break;
                        case QuestionType.Seq:
                            {
                                <FluentMessageBar Intent="MessageBarIntent.Info">Húzással állítsd a válaszokat a helyes sorrendbe.</FluentMessageBar>
                                <Dropzone Items="newAnswers" TItem="Answer" OnItemDrop="drop">
                                    <NewAnswer newAnswer="@context" questionType="newQuestion.QType" DeleteAnswer="@deleteAnswer"></NewAnswer>
                                </Dropzone>
                            }

                            break;
                        case QuestionType.Pair:
                            newAnswers[1].Sequence = 1;
                            newAnswers[1].Right = false;
                            for (int i = 0; i < newAnswers.Count; i = i + 2)
                            {
                                var pairIndex = i;
                                <div class="pair">
                                    <span class="pair__label">@(pairIndex/2+1). pár</span>
                                    <div class="pair__items">
                                        <NewAnswer newAnswer="newAnswers[pairIndex]" questionType="newQuestion.QType" DeleteAnswer="@deleteAnswer"></NewAnswer>
                                        <NewAnswer newAnswer="newAnswers[pairIndex+1]" questionType="newQuestion.QType" DeleteAnswer="@deleteAnswer"></NewAnswer>
                                    </div>
                                    <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Delete())" Title="Pár törlése" aria-label="Pár törlése" OnClick="()=>deletePairAnswers(pairIndex)" />
                                </div>
                            }
                            break;
                        default:
                            break;
                    }

                    <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Add())" OnClick="AddAnswer">@(newQuestion.QType == QuestionType.Pair ? "Új pár" : "Új válasz")</FluentButton>
                </div>
            </FluentStack>
        </FluentGridItem>
    </FluentGrid>
    <div class="editor-actions" hidden="@hiddenForm">
        <FluentButton Appearance="ButtonAppearance.Default" OnClick="@(async ()=>await Cancel.InvokeAsync())">Mégsem</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Save())" OnClick="SaveQuestion">Kérdés mentése</FluentButton>
    </div>
</div>
@code {
        [Parameter] public bool New { get; set; } = true;
        [Parameter] public Question newQuestion { get; set; } = new Question();
        [Parameter] public List<Subject> subjects { get; set; } = new List<Subject>();
        [Parameter] public EventCallback<Question> Save { get; set; }
        [Parameter] public EventCallback<string> SubjectsSave { get; set; }
        [Parameter] public EventCallback Cancel { get; set; }
        string errorMessage = string.Empty, subjectName = string.Empty;
        RichTextEditorWithImage textEditor = new();
        bool showModal = false, hiddenForm = true;
    public Answer newAnswer { get; set; } = new Answer();
    public List<Answer> newAnswers = new List<Answer>();

    int k = 1; //Kiegészító feladatnál hányadik beszúrás kerül be.

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            newAnswers.Add(new Answer() { Sequence = 1 });
            newAnswers.Add(new Answer() { Sequence = 2 });
        }
        return base.OnAfterRenderAsync(firstRender);
    }
    protected override void OnParametersSet()
    {
        if (!New)
        {
            hiddenForm = false;
        }
        if (subjects != null && subjects.Count > 0 && newQuestion.Subject.Equals(string.Empty))
        {
            newQuestion.Subject = subjects.First().Name;
        }
        if (newQuestion.Answers != null)
        {
            newAnswers.Clear();
            foreach (var item in newQuestion.Answers)
            {
                newAnswers.Add(new Answer() { Right = item.Right, Sequence = item.Sequence, Text = item.Text });
            }
            if (newQuestion.QType == QuestionType.Pair)
            {
                // Párosításnál a pár első tagja Right = true, a második false. A régebben hibásan mentett
                // (mindkét tag azonos jelölésű) párokat itt helyrerakjuk, így újramentéskor javul az adat.
                foreach (var pair in newAnswers.GroupBy(a => a.Sequence))
                {
                    var i = 0;
                    foreach (var answer in pair) answer.Right = i++ == 0;
                }
            }
        }
    }
    private async Task Insert()
    {
        string text = " {" + k + "}";
        var select = await js.InvokeAsync<string>("addToTextArea", text);
        if (!string.IsNullOrEmpty(select))
        {
            if (newAnswers.Count>=k)
            {
                newAnswers[k - 1].Text = select;
            }
            else
            {
                newAnswers.Add(new() { Sequence = k, Right = false, Text = select });
            }
        }
        StateHasChanged();
        k++;
    }
    private void deletePairAnswers(int j)
    {
        newAnswers.RemoveRange(j, 2);

        for (int i = 0; i < newAnswers.Count; i = i + 2)
        {
            newAnswers[i].Sequence = i / 2 + 1;
            newAnswers[i + 1].Sequence = i / 2 + 1;
        }
        StateHasChanged();
    }
    private void deleteAnswer(Answer answer)
    {
        int j = answer.Sequence;
        char[] vs = { '{', Convert.ToChar(j), '}' };
        if (newQuestion.Text.Length > 0) j = newQuestion.Text.IndexOfAny(vs);
        newAnswers.Remove(answer);
        for (int i = 0; i < newAnswers.Count; i++) //A sequece újra írása.
        {
            newAnswers[i].Sequence = i + 1;
        }
    }
    private async Task SaveQuestion()
    {
        if (newQuestion.QType == 0)
        {
            errorMessage = "Kérem állítson be egy kérdés típust!";
            return;
        }
        await textEditor.SaveContent();
        if (string.IsNullOrEmpty(textEditor.Context))
        {
            toastService.ShowWarning("A kérdés mező nem lehet üres!");
            return;
        }
        else
        {
            newQuestion.Text = textEditor.Context;
        }
        var valasz = IsValidAnswer(newQuestion.QType);
        if (string.IsNullOrEmpty(valasz))
        {
            newQuestion.Answers = newAnswers.ToList();
            await Save.InvokeAsync(newQuestion);
            return;
        }
        else errorMessage = valasz;
        //newAnswers.Clear();
        //await AddNewQuestion();
    }
    private void minGradeChange()
    {
        if (newQuestion.MaxGrade < newQuestion.MinGrade)
        {
            var v = newQuestion.MaxGrade;
            newQuestion.MaxGrade = newQuestion.MinGrade;// + 1;
            newQuestion.MinGrade = v;
            StateHasChanged();
        }
    }
    private string IsValidAnswer(QuestionType type)
    {
        int i = 0;
        switch (type)
        {
            case QuestionType.SC:
                {
                    foreach (var item in newAnswers)
                    {
                        if (item.Right)
                        {
                            i++;
                        }
                        if (item.Text == null)
                        {
                            errorMessage = errorMessage + "A " + item.Sequence.ToString() + " válasz nem lehet üres! ";
                        }
                    }
                    if (i == 0 || i > 1)
                    {
                        errorMessage = errorMessage + "Pontosan egy helyes megoldás lehet! ";
                    }
                }
                break;
            case QuestionType.MC:
                {
                    foreach (var item in newAnswers)
                    {
                        if (item.Right)
                        {
                            i++;
                        }
                        if (item.Text == null)
                        {
                            errorMessage = errorMessage + "A " + item.Sequence.ToString() + " válasz nem lehet üres! ";
                        }
                    }
                    if (i == 0)
                    {
                        errorMessage = "Legalább egy helyes válasz kell!";
                    }
                    break;
                }
            case QuestionType.TF:
                break;
            case QuestionType.Open:
                foreach (var item in newAnswers)
                {
                    if (item.Text == null)
                    {
                        errorMessage = errorMessage + "A " + item.Sequence.ToString() + " válasz nem lehet üres! ";
                    }
                }
                break;
            case QuestionType.Seq:
                foreach (var item in newAnswers)
                {
                    if (item.Text == null)
                    {
                        errorMessage = errorMessage + "A " + item.Sequence.ToString() + " válasz nem lehet üres! ";
                    }
                }
                break;
            case QuestionType.Pair:
                break;
            default:
                break;
        }
        return errorMessage;
    }
    private void AddAnswer()
    {
        var i = newAnswers.Last().Sequence;
        if (newQuestion.QType == QuestionType.Pair)
        {
            newAnswers.Add(new Answer() { Sequence = i + 1, Right = true });    // a pár első tagja
            newAnswers.Add(new Answer() { Sequence = i + 1, Right = false });   // a pár második tagja
        }
        else
        {
            newAnswers.Add(new Answer() { Sequence = i + 1 });
        }
        StateHasChanged();
    }
    private void qTypeChanged(string type)
    {
        QuestionType qt;
        if (Enum.TryParse<QuestionType>(type, out qt))
        {
            newQuestion.QType = qt;
            hiddenForm = false;
            //StateHasChanged();
        }
        if (newQuestion.QType == QuestionType.Pair)
        {
            newAnswers.Clear();
            newAnswers.Add(new Answer() { Sequence = 1, Right = true });
            newAnswers.Add(new Answer() { Sequence = 1, Right = false });
        }
        else if (newQuestion.QType == QuestionType.Comp)
        {
            newAnswers.Clear();
            newAnswers.Add(new Answer() { Sequence = 1 });
            newAnswers.Add(new Answer() { Sequence = 2 });
        }
        else
        {
            newAnswers.Clear();
            newAnswers.Add(new Answer() { Sequence = 1 });
        }
    }
    private void drop()
    {
        foreach (var a in newAnswers)
        {
            a.Sequence = newAnswers.IndexOf(a) + 1;
        }
    }
    private void CloseModal() => errorMessage = string.Empty;
    private async Task SaveSubject()
    {
        showModal = false;
        await SubjectsSave.InvokeAsync(subjectName);
    }
    void CloseSubjectModal() => showModal = false;
}
