@using Microsoft.FluentUI.AspNetCore.Components

@using Microsoft.JSInterop;
@using Plk.Blazor.DragDrop;
@inject IJSRuntime js
@inject IToastService toastService

<div class="row m-3">
    <Modal Accept="CloseModal" AcceptButtom="Rendben" Show="errorMessage!=string.Empty">
        <HeaderContent>
            <p>Figyelmeztetés!</p>
        </HeaderContent>
        <BodyContent>
            <h4>@errorMessage</h4>
        </BodyContent>
    </Modal>
    <FluentGrid>
        <FluentGridItem xs="12" sm="6">
            <FluentStack Orientation="Orientation.Vertical">
                @*A kérdés általános adatai*@
                <div class="col bg-light m-2 justify-content-start">
                    <div class="p-3 mb-3 bg-primary text-white text-center">@(New? "Új kérdés":"Kérdés módosítása")</div>
                    <EditForm Model="@newQuestion">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div style="margin:10px 0px">
                            <label for="qType">Kérdés típusa: </label>
                            <FluentSelect Id="qType" TOption="QuestionType" Value="newQuestion.QType" ValueChanged=qTypeChanged Disabled=!New Placeholder="Válassza ki a kérdés fajtáját..,">
                                <FluentOption Value="SC" Selected=@(QuestionType.SC==newQuestion.QType)>Felelet választás</FluentOption>
                                <FluentOption Value="MC" Selected=@(QuestionType.MC==newQuestion.QType)>Több válaszos</FluentOption>
                                <FluentOption Value="TF" Selected=@(QuestionType.TF==newQuestion.QType)>Igaz-Hamis</FluentOption>
                                <FluentOption Value="Open" selected="@(QuestionType.Open==newQuestion.QType)">Nyílt végű</FluentOption>
                                <FluentOption Value="Seq" selected="@(QuestionType.Seq==newQuestion.QType)">Sorbarendezés</FluentOption>
                                <FluentOption Value="Pair" selected="@(QuestionType.Pair==newQuestion.QType)">Párosítás</FluentOption>
                                <FluentOption Value="Comp" selected="@(QuestionType.Comp==newQuestion.QType)">Kiegészítő</FluentOption>
                            </FluentSelect>
                        </div>
                        <div hidden="@hiddenForm">
                            @if (subjects.Count > 0)
                            {
                                <FluentSelect Id="Subject" Items="subjects" TOption="Subject" @bind-Value="@newQuestion.Subject" Label="Tantárgy" OptionText="@(s=>s.Name)" OptionValue="@(s=>s.Name)">
                                </FluentSelect>
                            }
                            <Modal Accept="SaveSubject" AcceptButtom="Tantárgy mentése" Cancel="CloseSubjectModal" CancelButtom="Mégsem" Show=showModal>
                                <HeaderContent>
                                    <p>Új tantárgy felvétele</p>
                                </HeaderContent>
                                <BodyContent>
                                    <label for="Name">Tantárgy neve: </label>
                                    <input type="text" id="Name" @bind-value="subjectName" />
                                </BodyContent>
                            </Modal>
                            <FluentButton Appearance="Appearance.Accent" @onclick="()=>showModal=true">Új tantárgy</FluentButton>
                            <div style="margin:10px 0px">
                                <label for="title">Kérdés címe / témaköre</label>
                                <input type="text" id="title" class="form-control" @bind-value="@newQuestion.Title" required />
                            </div>
                            <div style="margin:10px 0px">
                                <label for="subtitle">Kérdés alcím</label>
                                <input type="text" id="subtitle" class="form-control" @bind-value="@newQuestion.Subtitle" />
                            </div>
                            <div style="margin:10px 0px">
                                <FluentTextArea Id="qText" @bind-Value="@newQuestion.Text" Style="width:100%" />
                                <div hidden="@(newQuestion.QType!=QuestionType.Comp)">
                                    <p>Kiegészitendő kérdés esetén {szám} jelöléssel lehet megadni a kiegészítés helyét.</p>
                                    <FluentButton @onclick="Insert">{@k} beszúrása</FluentButton>
                                </div>
                            </div>
                            <div style="margin:10px 0px">
                                <FluentGrid>
                                    <FluentGridItem xs="12" sm="6">
                                        <FluentNumberField Name="score" @bind-Value="@newQuestion.Score" Label="Pontszám" />
                                    </FluentGridItem>
                                    <FluentGridItem xs="12" sm="6">
                                        <FluentNumberField Name="time" class="ido-sec" @bind-Value="@newQuestion.Time" Label="Időtartam /másodperc/" />
                                    </FluentGridItem>
                                </FluentGrid>
                                @*<div class="row">
                                <div class="col">
                                    <label for="score">Pontszám</label>
                                </div>
                                <div class="col">
                                    <label for="time"></label>
                                </div>
                            </div>*@
                            </div>
                            <div>
                                @*<label for="grade"></label>*@
                                <div class="input-group">
                                    <FluentNumberField Name="grade" @bind-Value="@newQuestion.MinGrade" style="width:100px; margin:0px" @oninput="minGradeChange" min="1" max="12" Label="Évfolyam" />
                                    <span> -  </span>
                                    <FluentNumberField Name="grade" @bind-Value="@newQuestion.MaxGrade" style="width:100px; margin:0px" min="1" max="12" />
                                </div>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </FluentStack>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6">
            <FluentStack Orientation="Orientation.Vertical">
                <div class="col bg-light m-2 justify-content-start" hidden="@hiddenForm">
                    <div class="p-3 mb-3 bg-primary text-white text-center">Válaszok</div>
                    @switch (newQuestion.QType)
                    {
                        case QuestionType.SC:
                        case QuestionType.MC:
                        case QuestionType.Comp:
                            {
                                @foreach (var item in newAnswers)
                                {
                                    <NewAnswer newAnswer="item" questionType="newQuestion.QType" DeleteAnswer="@deleteAnswer"></NewAnswer>
                                }
                            }
                            break;
                        case QuestionType.TF:
                            {
                                <p class="bg-info text-center">Az eldöntendő állításokat írja le.</p>
                                @foreach (var item in newAnswers)
                                {
                                    <NewAnswer newAnswer="item" questionType="newQuestion.QType" DeleteAnswer="@deleteAnswer"></NewAnswer>
                                }
                            }
                            break;
                        case QuestionType.Open:
                            {
                                foreach (var item in newAnswers)
                                {
                                    <NewAnswer newAnswer="item" questionType="newQuestion.QType" DeleteAnswer="@deleteAnswer"></NewAnswer>
                                }
                            }
                            break;
                        case QuestionType.Seq:
                            {
                                <p class="bg-info text-center">A válaszokat a helyes sorrendbe állítsa be.</p>
                                <Dropzone Items="newAnswers" TItem="Answer" OnItemDrop="drop">
                                    <NewAnswer newAnswer="@context" questionType="newQuestion.QType" DeleteAnswer="@deleteAnswer"></NewAnswer>
                                </Dropzone>
                            }

                            break;
                        case QuestionType.Pair:
                            newAnswers[1].Sequence = 1;
                            newAnswers[1].Right = false;
                            for (int i = 0; i < newAnswers.Count; i = i + 2)
                            {
                                <label>@(i/2+1). pár:</label>
                                <div class="row">
                                    <div class="col">
                                        <NewAnswer newAnswer="newAnswers[i]" questionType="newQuestion.QType" DeleteAnswer="@deleteAnswer"></NewAnswer>
                                    </div>
                                    <div class="col">
                                        <NewAnswer newAnswer="newAnswers[i+1]" questionType="newQuestion.QType" DeleteAnswer="@deleteAnswer"></NewAnswer>
                                    </div>
                                    <div class="col-1">
                                        <button class="btn btn-danger" @onclick="()=>deletePairAnswers(i)"><FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Delete())" Color="Color.Error" /></button>
                                    </div>
                                </div>
                            }
                            break;
                        default:
                            break;
                    }

                    <button class="m-3" @onclick="AddAnswer" type="button"><FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Add())" Color="Color.Info" /></button>
                </div>
            </FluentStack>
        </FluentGridItem>
    </FluentGrid>
    <div class="text-center p-3 mb-3" hidden="@hiddenForm">
        <button type="submit" class="btn btn-info" @onclick="SaveQuestion">Kérdés mentése</button>
        @*<button class="btn btn-info" @onclick="SaveNewQuestion">Kérdés mentése + új</button>*@
        <button class="btn" @onclick="@(async ()=>await Cancel.InvokeAsync())" type="button">Mégsem</button>
    </div>
</div>
@code {
    [Parameter] public bool New { get; set; } = true;
    [Parameter] public Question newQuestion { get; set; } = new Question();
    [Parameter] public List<Subject> subjects { get; set; } = new List<Subject>();
    [Parameter] public EventCallback<Question> Save { get; set; }
    [Parameter] public EventCallback<string> SubjectsSave { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    string errorMessage = string.Empty, subjectName = string.Empty;
    bool showModal = false, hiddenForm = true;
    // private Dictionary<string, object> editorConf = new Dictionary<string, object>{
    //{ "menubar", true },
    //{ "plugins", "link image" },
    //{ "toolbar", "undo redo | styleselect | forecolor | bold italic | alignleft aligncenter alignright alignjustify | outdent indent | link image" }};
    public Answer newAnswer { get; set; } = new Answer();
    public List<Answer> newAnswers = new List<Answer>();

    int k = 1; //Kiegészító feladatnál hányadik beszúrás kerül be.

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            newAnswers.Add(new Answer() { Sequence = 1 });
            newAnswers.Add(new Answer() { Sequence = 2 });
        }
        return base.OnAfterRenderAsync(firstRender);
    }
    protected override void OnParametersSet()
    {
        if (!New)
        {
            hiddenForm = false;
        }
        if (subjects != null && subjects.Count > 0 && newQuestion.Subject.Equals(string.Empty))
        {
            newQuestion.Subject = subjects.First().Name;
        }
        if (newQuestion.Answers != null)
        {
            newAnswers.Clear();
            foreach (var item in newQuestion.Answers)
            {
                newAnswers.Add(new Answer() { Right = item.Right, Sequence = item.Sequence, Text = item.Text });
            }
        }
    }
    private async Task Insert()
    {
        string text = " {" + k + "}";
        var select = await js.InvokeAsync<string>("addToTextArea", text);
        if (!string.IsNullOrEmpty(select))
        {
            if (newAnswers.Count>=k)
            {
                newAnswers[k - 1].Text = select;
            }
            else
            {
                newAnswers.Add(new() { Sequence = k, Right = false, Text = select });
            }
        }
        StateHasChanged();
        k++;
    }
    private void deletePairAnswers(int j)
    {
        newAnswers.RemoveRange(j, 2);

        for (int i = 0; i < newAnswers.Count; i = i + 2)
        {
            newAnswers[i].Sequence = i / 2 + 1;
            newAnswers[i + 1].Sequence = i / 2 + 1;
        }
        StateHasChanged();
    }
    private void deleteAnswer(Answer answer)
    {
        int j = answer.Sequence;
        char[] vs = { '{', Convert.ToChar(j), '}' };
        if (newQuestion.Text.Length > 0) j = newQuestion.Text.IndexOfAny(vs);
        newAnswers.Remove(answer);
        for (int i = 0; i < newAnswers.Count; i++) //A sequece újra írása.
        {
            newAnswers[i].Sequence = i + 1;
        }
    }
    private async Task SaveQuestion()
    {
        if (newQuestion.QType == 0)
        {
            errorMessage = "Kérem állítson be egy kérdés típust!";
        }
        var valasz = IsValidAnswer(newQuestion.QType);
        if (string.IsNullOrEmpty(valasz))
        {
            newQuestion.Answers = newAnswers.ToList();
            await Save.InvokeAsync(newQuestion);
            return;
        }
        else errorMessage = valasz;
        //newAnswers.Clear();
        //await AddNewQuestion();
    }
    private void minGradeChange()
    {
        if (newQuestion.MaxGrade < newQuestion.MinGrade)
        {
            var v = newQuestion.MaxGrade;
            newQuestion.MaxGrade = newQuestion.MinGrade;// + 1;
            newQuestion.MinGrade = v;
            StateHasChanged();
        }
    }
    private string IsValidAnswer(QuestionType type)
    {
        int i = 0;
        switch (type)
        {
            case QuestionType.SC:
                {
                    foreach (var item in newAnswers)
                    {
                        if (item.Right)
                        {
                            i++;
                        }
                        if (item.Text == null)
                        {
                            errorMessage = errorMessage + "A " + item.Sequence.ToString() + " válasz nem lehet üres! ";
                        }
                    }
                    if (i == 0 || i > 1)
                    {
                        errorMessage = errorMessage + "Pontosan egy helyes megoldás lehet! ";
                    }
                }
                break;
            case QuestionType.MC:
                {
                    foreach (var item in newAnswers)
                    {
                        if (item.Right)
                        {
                            i++;
                        }
                        if (item.Text == null)
                        {
                            errorMessage = errorMessage + "A " + item.Sequence.ToString() + " válasz nem lehet üres! ";
                        }
                    }
                    if (i == 0)
                    {
                        errorMessage = "Legalább egy helyes válasz kell!";
                    }
                    break;
                }
            case QuestionType.TF:
                break;
            case QuestionType.Open:
                foreach (var item in newAnswers)
                {
                    if (item.Text == null)
                    {
                        errorMessage = errorMessage + "A " + item.Sequence.ToString() + " válasz nem lehet üres! ";
                    }
                }
                break;
            case QuestionType.Seq:
                foreach (var item in newAnswers)
                {
                    if (item.Text == null)
                    {
                        errorMessage = errorMessage + "A " + item.Sequence.ToString() + " válasz nem lehet üres! ";
                    }
                }
                break;
            case QuestionType.Pair:
                break;
            default:
                break;
        }
        return errorMessage;
    }
    private void AddAnswer()
    {
        var i = newAnswers.Last().Sequence;
        newAnswers.Add(new Answer() { Sequence = i + 1 });
        if (newQuestion.QType == QuestionType.Pair)
        {
            newAnswers.Add(new Answer() { Sequence = i + 1 , Right=false});
        }
        StateHasChanged();
    }
    private void qTypeChanged(string type)
    {
        QuestionType qt;
        if (Enum.TryParse<QuestionType>(type, out qt))
        {
            newQuestion.QType = qt;
            hiddenForm = false;
            StateHasChanged();
        }
        if (newQuestion.QType == QuestionType.Comp || newQuestion.QType==QuestionType.Pair)
        {
            newAnswers.Clear();
            newAnswers.Add(new Answer() { Sequence = 1 });
            newAnswers.Add(new Answer() { Sequence = 2 });
        }
        else
        {
            newAnswers.Clear();
            newAnswers.Add(new Answer() { Sequence = 1 });
        }
    }
    private void drop()
    {
        foreach (var a in newAnswers)
        {
            a.Sequence = newAnswers.IndexOf(a) + 1;
        }
    }
    private void CloseModal() => errorMessage = string.Empty;
    private void SaveSubject()
    {
        showModal = false;
        SubjectsSave.InvokeAsync(subjectName);
    }
    void CloseSubjectModal() => showModal = false;
}
