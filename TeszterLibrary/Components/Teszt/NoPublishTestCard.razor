@* Piszkozat (még nem közzétett) teszt kártyája (tanár). *@
@using Ic16 = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16
@using Ic20 = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20
@if (TestItem is not null)
{
    <TestCardShell Title="@TestItem.Title" Subject="@TestItem.Subject">
        <Details>
            <TestMeta Label="Kérdések" Value="@($"{TestItem.TestQuestions.Count} db")" Icon="@(new Ic16.QuestionCircle())" />
            <TestMeta Label="Pontszám" Value="@($"{TestItem.Summa} pont")" Icon="@(new Ic16.Trophy())" />
            <TestMeta Label="Időtartam" Value="@TestItem.Time.ToTime()" Icon="@(new Ic16.Timer())" />
        </Details>
        <Actions>
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Ic20.Send())" OnClick="@(() => Publish.InvokeAsync(TestItem))">Közzététel</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Default" IconStart="@(new Ic20.Edit())" OnClick="@(() => Edit.InvokeAsync(TestItem))">Szerkesztés</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Ic20.Delete())" Title="Teszt törlése" OnClick="@(() => Delete.InvokeAsync(TestItem))">Törlés</FluentButton>
        </Actions>
    </TestCardShell>
}
@code {
    [Parameter] public Test TestItem { get; set; } = new();
    [Parameter] public EventCallback<Test> Publish { get; set; }
    [Parameter] public EventCallback<Test> Edit { get; set; }
    [Parameter] public EventCallback<Test> Delete { get; set; }
}
