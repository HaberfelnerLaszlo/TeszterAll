@* Egy- (radio) és többválaszos (checkbox) kérdés: nagy, érintésbarát válaszkártyák. *@
@if (Answers is not null)
{
    var multiple = Type.Equals("checkbox");
    <div class="answer-list" role="@(multiple ? "group" : "radiogroup")">
        @foreach (var a in Answers)
        {
            var answer = a;
            // Egyválaszosnál csak a megjelölt válasz eredményét mutatjuk (mint eddig), többválaszosnál mindet.
            bool? result = IsChecked && (multiple || answer.Sign) ? answer.Result : null;
            <AnswerOption Multiple="multiple" Selected="answer.Sign" Disabled="IsChecked" Result="result"
                          OnClick="@(() => Toggle(answer, multiple))">@answer.Text</AnswerOption>
        }
    </div>
    <QuestionActions ShowCheck="IsCheck" OnCheck="@(() => CallCheck.InvokeAsync(Answers))" OnNext="@(Next.HasDelegate ? EventCallback.Factory.Create(this, () => Next.InvokeAsync(Answers)) : default)" />
}
@code {
    [Parameter] public string Type { get; set; } = "checkbox";
    [Parameter] public List<AnswerView> Answers { get; set; } = new();
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> Next { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> CallCheck { get; set; }
    private void Toggle(AnswerView answer, bool multiple)
    {
        if (IsChecked) return;
        if (multiple)
        {
            answer.Sign = !answer.Sign;
            return;
        }
        // Egyválaszos: csak a kiválasztott marad megjelölve.
        foreach (var item in Answers)
        {
            item.Sign = item.AnswerId == answer.AnswerId;
        }
    }
}
