@if (QView is not null)
{
    <FluentLabel Typo="Typography.Subject">@((MarkupString)QView.QuestionText)</FluentLabel>
    <hr />
    @if (QView.Answers is not null)
    {

        @if (Type.Equals("checkbox"))
        {
            <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center">
                <FluentStack HorizontalAlignment="HorizontalAlignment.Center">
                    @foreach (var answer in QView.Answers)
                    {
                        <FluentCheckbox Label="@answer.Text" @bind-Value="@answer.Sign"></FluentCheckbox>
                        @if (IsChecked)
                        {
                            if (answer.Result)
                            {
                                <FluentIcon Value="@(new Icons.Regular.Size16.Checkmark())" />
                            }
                            else
                            {
                                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Color="@Color.Error" />
                            }
                        }
                    }
                </FluentStack>
            </FluentStack>}
                else
                {
                <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center">
                    <ul class="list-group" style="list-style-type:none">

                        @foreach (var a in QView.Answers)
                        {
                            if (a.Sign)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center" style="background-color:@bgColor" @onclick="() => selected(a.AnswerId)">
                                    @a.Text
                                    @if (IsChecked)
                                    {
                                        if (a.Result)
                                        {
                                            <FluentIcon Value="@(new Icons.Regular.Size16.Checkmark())" />
                                        }
                                        else
                                        {
                                            <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Color="@Color.Error" />
                                        }
                                    }
                                </li>
                            }
                            else
                            {
                                <li class="list-group-item" @onclick="()=>selected(a.AnswerId)">
                                    @a.Text
                                </li>
                            }
                        }
                    </ul>
                </FluentStack>}

                
                }
                <div class="container text-center">
                    @if (IsCheck)
                    {
                        <FluentButton Appearance="Appearance.Accent" OnClick="@(()=>CallCheck.InvokeAsync(QView))">
                            Ellenőrzés
                        </FluentButton>
                    }
                    @if (Next.HasDelegate)
                    {
                        <FluentButton Appearance="Appearance.Filled" OnClick="@(()=>Next.InvokeAsync(QView))">
                            Következő
                        </FluentButton>
                    }
                </div>
                }
                @code {
                    [Parameter] public string Type { get; set; } = "checkbox";
                    [Parameter] public QuestionView? QView { get; set; }
                    [Parameter] public bool IsCheck { get; set; }
                    [Parameter] public bool IsChecked { get; set; }
                    [Parameter] public EventCallback<QuestionView> Next { get; set; }
                    [Parameter] public EventCallback<QuestionView> CallCheck { get; set; }
private string bgColor = System.Drawing.Color.GreenYellow.Name;

        private void selected(int ID)
        {
            IsChecked = false;
            if (bgColor != System.Drawing.Color.GreenYellow.Name)
            {
                bgColor = System.Drawing.Color.GreenYellow.Name;
            }
            foreach (var item in QView.Answers!)
            {
                if (item.AnswerId == ID)
                {
                    item.Sign = true;
                }
                else item.Sign = false;
            }
        }
                }
