@if (Answers is not null)
{
    @if (Type.Equals("checkbox"))
    {
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center" Wrap="true">
                @foreach (var answer in Answers)
                {
                    <FluentCheckbox @bind-Value="@answer.Sign" ReadOnly="IsChecked"><span> @answer.Text</span></FluentCheckbox>
                    @if (IsChecked)
                    {
                        if (answer.Result)
                        {
                            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Checkmark())" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Dismiss())" Color="@Color.Error" />
                        }
                    }
                }
        </FluentStack>}
        else
        {
<FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center" Wrap="true">
    @foreach (var a in Answers)
    {
        if (a.Sign)
        {
            @if (IsChecked)
            {
                <p class="answer" style="min-width:@(maxLenght)px; width:@(width)%;background-color:@bgColor; text-align:center; font-size:2vw">@a.Text</p>
                @if (a.Result)
                {
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Checkmark())" />
                }
                else
                {
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Dismiss())" Color="@Color.Error" />
                }
            }
            else
            {
                <p class="answer" style="min-width:@(maxLenght)px; width:@(width)%;background-color:@bgColor; text-align:center; font-size:2vw" @onclick="() => selected(a.AnswerId)">@a.Text</p>
            }
        }
        else
        {
            @if (IsChecked)
            {
                <p class="answer" style="min-width:@(maxLenght)px; width:@(width)%;text-align:center; font-size:2vw">@a.Text</p>
            }
            else
            {
            <p class="answer" style=" min-width:@(maxLenght)px; width:@(width)%;text-align:center; font-size:2vw " @onclick="() => selected(a.AnswerId)">@a.Text</p>
             }
        }
    }
</FluentStack>
        }
<FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center" Style="margin:10px">
    @if (IsCheck)
    {
        <FluentButton Appearance="Appearance.Outline" OnClick="@(()=>CallCheck.InvokeAsync(Answers))">
            Ellenőrzés
        </FluentButton>
    }
    @if (Next.HasDelegate)
    {
        <FluentButton Appearance="Appearance.Accent" OnClick="@(()=>Next.InvokeAsync(Answers))">
            Következő
        </FluentButton>
    }
</FluentStack>
}
@code {
    [Parameter] public string Type { get; set; } = "checkbox";
    [Parameter] public List<AnswerView> Answers { get; set; } = new();
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> Next { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> CallCheck { get; set; }
    private string bgColor = System.Drawing.Color.GreenYellow.Name;
    int maxLenght = 0, width=0;

    protected override void OnParametersSet()
    {
        maxLenght = 0;
        foreach (var item in Answers)
        {
            if (item.Text.Length > maxLenght)
            {
                maxLenght = item.Text.Length;
            }
        }
        maxLenght = maxLenght * 10;
        width = (100 / Answers.Count)-5;
        base.OnParametersSet();
    }
    private void selected(int ID)
    {
        IsChecked = false;
        if (bgColor != System.Drawing.Color.GreenYellow.Name)
        {
            bgColor = System.Drawing.Color.GreenYellow.Name;
        }
        foreach (var item in Answers!)
        {
            if (item.AnswerId == ID)
            {
                item.Sign = true;
            }
            else item.Sign = false;
        }
    }
}
