@if (Answers is not null)
{
    @if (Type.Equals("checkbox"))
    {
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center">
                @foreach (var answer in Answers)
                {
                    <FluentCheckbox Label="@answer.Text" @bind-Value="@answer.Sign" ReadOnly="IsChecked"></FluentCheckbox>
                    @if (IsChecked)
                    {
                        if (answer.Result)
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size16.Checkmark())" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Color="@Color.Error" />
                        }
                    }
                }
        </FluentStack>}
        else
        {
<FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center" Wrap="true">
    @foreach (var a in Answers)
    {
        if (a.Sign)
        {
            @if (IsChecked)
            {
                <p style="margin:5px;padding:5px;border:2px solid blue; border-radius:10px;background-color:@bgColor">@a.Text</p>
                @if (a.Result)
                {
                    <FluentIcon Value="@(new Icons.Regular.Size16.Checkmark())" />
                }
                else
                {
                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Color="@Color.Error" />
                }
            }
            else
            {
                <p style="margin:5px;padding:5px;border:2px solid blue; border-radius:10px;background-color:@bgColor" @onclick="() => selected(a.AnswerId)">@a.Text</p>
            }
        }
        else
        {
            @if (IsChecked)
            {
                <p style="margin:5px;padding:5px;border:2px solid blue; border-radius:10px;">@a.Text</p>
            }
            else
            {
            <p style="margin:5px;padding:5px;border:2px solid blue; border-radius:10px;" @onclick="() => selected(a.AnswerId)">@a.Text</p>
             }
        }
    }
</FluentStack>
        }
<FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center">
    @if (IsCheck)
    {
        <FluentButton Appearance="Appearance.Outline" OnClick="@(()=>CallCheck.InvokeAsync(Answers))">
            Ellenőrzés
        </FluentButton>
    }
    @if (Next.HasDelegate)
    {
        <FluentButton Appearance="Appearance.Accent" OnClick="@(()=>Next.InvokeAsync(Answers))">
            Következő
        </FluentButton>
    }
</FluentStack>
}
@code {
    [Parameter] public string Type { get; set; } = "checkbox";
    [Parameter] public List<AnswerView> Answers { get; set; } = new();
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> Next { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> CallCheck { get; set; }
    private string bgColor = System.Drawing.Color.GreenYellow.Name;

    private void selected(int ID)
    {
        IsChecked = false;
        if (bgColor != System.Drawing.Color.GreenYellow.Name)
        {
            bgColor = System.Drawing.Color.GreenYellow.Name;
        }
        foreach (var item in Answers!)
        {
            if (item.AnswerId == ID)
            {
                item.Sign = true;
            }
            else item.Sign = false;
        }
    }
}
