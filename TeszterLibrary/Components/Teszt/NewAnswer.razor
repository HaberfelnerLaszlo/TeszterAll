@* Egy válasz szerkesztő sora a kérdésszerkesztőben. A kérdés típusától függ, van-e helyes/igaz jelölő,
   sorszám-előtag és törlés gomb. Az Answer objektumot közvetlenül szerkeszti (a szülő ugyanazt a példányt látja). *@
<div class="answer-row">
    @if (Prefix is not null)
    {
        <span class="answer-row__prefix">@Prefix</span>
    }
    <FluentTextInput @bind-Value="newAnswer.Text" @bind-Value:after="NotifyChanged" Class="answer-row__text" Width="100%"
                     Placeholder="@Placeholder" aria-label="@Placeholder" />
    @if (CheckLabel is not null)
    {
        <FluentCheckbox @bind-Value="newAnswer.Right" @bind-Value:after="NotifyChanged" Label="@CheckLabel" />
    }
    @if (CanDelete)
    {
        <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Delete())"
                      Title="Válasz törlése" aria-label="Válasz törlése" OnClick="OnDeleteAnswer" />
    }
</div>

@code {
    [Parameter]
    public Answer newAnswer { get; set; } = new();
    [Parameter]
    public EventCallback<Answer> newAnswerChanged { get; set; }
    [Parameter]
    public QuestionType questionType { get; set; }
    [Parameter]
    public EventCallback<Answer> DeleteAnswer { get; set; }

    private string? Prefix => questionType switch
    {
        QuestionType.Seq => $"{newAnswer.Sequence}.",
        QuestionType.Comp => $"{{{newAnswer.Sequence}}}",
        _ => null,
    };

    private string Placeholder => questionType switch
    {
        QuestionType.TF => "Állítás",
        QuestionType.Open => "Elfogadható válasz",
        QuestionType.Comp => "A helyre kerülő szó",
        QuestionType.Pair => "A pár egyik eleme",
        _ => "Válasz",
    };

    private string? CheckLabel => questionType switch
    {
        QuestionType.SC or QuestionType.MC => "Helyes",
        QuestionType.TF => "Igaz",
        _ => null,
    };

    // Sorbarendezésnél és párosításnál a törlést a szülő kezeli (sorrend/pár), ezért ott nincs gomb – mint eddig.
    private bool CanDelete => questionType is not (QuestionType.Seq or QuestionType.Pair);

    private Task NotifyChanged() => newAnswerChanged.InvokeAsync(newAnswer);

    private Task OnDeleteAnswer() => DeleteAnswer.InvokeAsync(newAnswer);
}
