@*using Microsoft.JSInterop;*@
@using Plk.Blazor.DragDrop
@using System.Numerics;
@using System.Text.RegularExpressions
@*@inject IJSRuntime _js*@
<div style="position:relative; margin:5px 0">
    <FluentCard>
        <FluentStack>
            <FluentNumberField style="width:60px" @bind-Value="question.Score">Pontszám:</FluentNumberField>
            <FluentNumberField style="width:70px" @bind-Value="question.Time" Step="5">Idő:</FluentNumberField>
            <FluentButton IconEnd="@(new Icons.Regular.Size20.Delete())"
                          Title="Törlés"
                          OnClick="@(OnDelete)"
                          Style="position:absolute; top:5px; right:5px;" />
        </FluentStack>
        @switch (question.QType)
        {
            case QuestionType.SC:
                <Test_choise Type="@("radio")" QView="questionView" IsCheck="true" IsChecked="IsChecking" CallCheck="Check" />
                break;
            case QuestionType.MC:
                <Test_choise Type="@("checkbox")" QView="questionView" IsCheck="true" IsChecked="IsChecking" CallCheck="Check" />
                break;
            case QuestionType.TF:
                <Test_TF QView="questionView" IsCheck="true" IsChecked="IsChecking" CallCheck="Check" />
                break;
            case QuestionType.Open:
                <Test_open QView="questionView" IsCheck="true" IsChecked="IsChecking" CallCheck="Check" />
                break;
            case QuestionType.Seq:
                <Test_sequence QView="questionView" IsCheck="true" IsChecked="IsChecking" CallCheck="Check"></Test_sequence>
                break;
            case QuestionType.Pair:
                <Test_pair Question="questionView" IsCheck="true" CallCheck="Check" IsChecked="IsChecking" />
                break;
            case QuestionType.Comp:
                <Test_comp QView="questionView" IsCheck="true" IsChecked="IsChecking" CallCheck="Check" />
                break;
            default:
                <p>Nem tudom mi történt!</p>
                break;
        }
    </FluentCard>
</div>
    @code {
        [Parameter]
        public Question question { get; set; } = new Question();
        [Parameter]
        public EventCallback<Question> questionChanged { get; set; }
        [Parameter]
        public EventCallback<Question> Delete { get; set; }
        private List<AnswerView> answers = new List<AnswerView>();
        private bool IsChecking = false;
        QuestionView questionView = new() { Answers = new(), QuestionText = string.Empty };

        protected override Task OnInitializedAsync()
        {
            questionView.QuestionText = question.Text;

            if (question.QType == QuestionType.Pair)
            {
                foreach (var item in question.Answers)
                {
                    if (!item.Right)
                    {
                        questionView.Answers!.Add(new()
                        {
                            AnswerId = item.Id,
                            Result = false,
                            Sequence = -1,
                            Sign = false,
                            Text = item.Text
                        });
                    }
                    else
                        questionView.Answers!.Add(new()
                        {
                            AnswerId = item.Id,
                            Result = false,
                            Sequence = item.Sequence,
                            Sign = true,
                            Text = item.Text
                        });
                }
            }
            else
            {
                foreach (var item in question.Answers)
                {
                    questionView.Answers!.Add(new() { AnswerId = item.Id, Result = false, Sequence = item.Sequence, Sign = false, Text = item.Text });
                }
            }
            //else
            //{
            //    foreach (var item in question.Answers)
            //    {
            //        questionView.Answers!.Add(new() { AnswerId = item.Id, Result = false, Sequence = item.Sequence, Sign = false, Text = item.Text });
            //    }
            //}
            return base.OnInitializedAsync();
        }
        private void Check(QuestionView? questionView)
        {
            if (questionView != null && questionView.Answers != null)
            {
                answers = questionView.Answers;
            }
            IsChecking = true;
            switch (question.QType)
            {
                case QuestionType.SC:
                    foreach (var item in answers)
                    {
                        item.Result = (item.Sign == question.Answers.FirstOrDefault(a => a.Id == item.AnswerId)!.Right) ? true : false;
                    }
                    break;
                case QuestionType.MC:
                    {
                        foreach (var item in answers)
                        {
                            item.Result = (item.Sign == question.Answers.FirstOrDefault(a => a.Id == item.AnswerId)!.Right) ? true : false;
                        }
                    }
                    break;
                case QuestionType.TF:
                    {
                        foreach (var item in answers)
                        {
                            item.Result = (item.Sign == question.Answers.FirstOrDefault(a => a.Id == item.AnswerId)!.Right) ? true : false;
                        }
                    }
                    break;
                case QuestionType.Open:
                    {
                        foreach (var item in answers)
                        {
                            if (item.Text.Equals(question.Answers.FirstOrDefault(a => a.Id == item.AnswerId)!.Text))
                            { item.Result = true; }
                        }
                    }
                    break;
                case QuestionType.Seq:
                    {
                        foreach (var item in answers)
                        {
                            if (item.Sequence == question.Answers.FirstOrDefault(a => a.Id == item.AnswerId).Sequence)
                            { item.Result = true; }
                        }
                    }
                    break;
                case QuestionType.Pair:
                    foreach (var item in answers)
                    {
                        item.Result = question.Answers.FirstOrDefault(a => a.Id == item.AnswerId).Sequence == item.Sequence ? true : false;
                    }
                    break;
                case QuestionType.Comp:
                    {
                        foreach (var item in answers)
                        {
                            if (item.Text.Equals(question.Answers.FirstOrDefault(a => a.Id == item.AnswerId).Text))
                            {
                                item.Result = true;
                            }
                        }
                    }
                    break;
                default:
                    break;
            }
        }
        private Task OnDelete()
        {
            return Delete.InvokeAsync(question);
        }
    }
