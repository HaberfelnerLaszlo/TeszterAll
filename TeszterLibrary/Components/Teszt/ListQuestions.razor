<Modal AcceptButtom="Igen" Accept="DeleteQ" CancelButtom="Nem" Cancel="CloseModal" Show=showDelete>
	<HeaderContent>
		<p>Kérdés törlésére figyelmeztetés!</p>
	</HeaderContent>
	<BodyContent>
		<h4>A következő kérdés törlésre kerül!</h4>
		<p>@TempQuestion.Text</p>
	</BodyContent>
</Modal>
@if (Questions is null)
{
	<Waiting/>
}
else{
<div hidden="@(!newOrEdit)">
    <FluentAccordion>
        <FluentAccordionItem Heading="Szűrő">
            <QuestionFilter @bind-Questions="Questions"/>
        </FluentAccordionItem>
    </FluentAccordion>
    <TestQuestions UserId=@Guid.Parse(UserId) questions="Questions" Delete="DeleteQuestion" Update="Update" AddTest="AddTestQ"></TestQuestions>
    <button class="btn btn-outline-primary" @onclick="@(()=>NewQuestion())" type="button">Új kérdés</button>
	<UploadQuestion UserId="@UserId"/>
    </div>
}
<div class="container" hidden="@newOrEdit">
	<QuestionNewEdit newQuestion="TempQuestion" subjects="Subjects" New=isNew Save="Save" SubjectsSave="SaveSubject" Cancel="()=>newOrEdit=true" />
</div>
@if (TestQuestion.Count>0)
{
	<div class="fixed-bottom newtest-message">
		<span>A tesztben @TestQuestion.Count db kérdés van.</span>
		<button class="btn" @onclick=@(()=>CreateTest.InvokeAsync(TestQuestion))>Teszt létrehozása</button>
		<button class="btn" @onclick=@(()=>TestQuestion.Clear())>Mégsem</button>
	</div>
}

