@if (Answers is not null)
{
    <div class="container">
        @if (texts is not null)
        {
            @foreach (string t in texts)
            {
                if (t.All(char.IsNumber))
                {
                    int Number = Convert.ToInt32(t) - 1;
                    <FluentTextField Appearance="FluentInputAppearance.Filled" Placeholder="@(t+". válasz")" @bind-Value="@Answers[Number].Text" />
                    @if (IsChecked)
                    {
                        if (Answers[Number].Result)
                        {
                            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Checkmark())" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Dismiss())" Color="@Color.Error" />
                        }
                    }
                }
                else
                { <span>@t</span>}
            }
        }
    </div>
    <div class="container text-center">
        @if (IsCheck)
        {
            <FluentButton Appearance="Appearance.Accent" OnClick="@(()=>CallCheck.InvokeAsync(Answers))">
                Ellenőrzés
            </FluentButton>
        }
        @if (Next.HasDelegate)
        {
            <FluentButton OnClick="@(()=>Next.InvokeAsync(Answers))">
                    Következő
            </FluentButton>
        }
    </div>
}
@code {
    [Parameter] public List<AnswerView> Answers { get; set; } = new();
    [Parameter] public string Texts { get; set; } = string.Empty;
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> Next { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> CallCheck { get; set; }
    string[] texts = [];
    protected override void OnInitialized()
    {
        texts = Texts.Split('{', '}');

        base.OnInitialized();
    }
}
