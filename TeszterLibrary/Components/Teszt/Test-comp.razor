@if (Answers is not null)
{
    <div class="comp-text">
        @if (texts is not null)
        {
            @foreach (string t in texts)
            {
                // "[3]"-szerű helyőrző: csak létező válaszra hivatkozó szám (régen az üres szöveg és a túl nagy szám is kivételt dobott).
                if (t.Length > 0 && t.All(char.IsAsciiDigit) && t.ToIntOrNull() is int position && position >= 1 && position <= Answers.Count)
                {
                    int Number = position - 1;
                    <span class="comp-gap">
                        <FluentTextInput Placeholder="@(t+". válasz")" @bind-Value="@Answers[Number].Text" Width="140px" aria-label="@(t+". hiányzó szó")" />
                        @if (IsChecked)
                        {
                            <AnswerResult Correct="Answers[Number].Result" />
                        }
                    </span>
                }
                else
                { <span>@t</span>}
            }
        }
    </div>
    <QuestionActions ShowCheck="IsCheck" OnCheck="@(() => CallCheck.InvokeAsync(Answers))" OnNext="@(Next.HasDelegate ? EventCallback.Factory.Create(this, () => Next.InvokeAsync(Answers)) : default)" />
}
@code {
    [Parameter] public List<AnswerView> Answers { get; set; } = new();
    [Parameter] public string Texts { get; set; } = string.Empty;
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> Next { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> CallCheck { get; set; }
    string[] texts = [];
    protected override void OnInitialized()
    {
        texts = Texts.Split('{', '}');

        base.OnInitialized();
    }
}
