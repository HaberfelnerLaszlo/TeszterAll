@if (QView is not null)
{
    <FluentLabel>Egészítsd ki a szöveget!</FluentLabel>
    <hr />
    <div class="container">
        @if (texts is not null)
        {
            @foreach (string t in texts)
            {
                if (t.All(char.IsNumber))
                {
                    int Number = Convert.ToInt32(t) - 1;
                    <FluentTextField Appearance="FluentInputAppearance.Filled" Placeholder="@(t+". válasz")" @bind-Value="@QView.Answers[Number].Text" />
                    @if (IsChecked)
                    {
                        if (QView.Answers[Number].Result)
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size16.Checkmark())" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Color="@Color.Error" />
                        }
                    }
                }
                else
                { <span>@t</span>}
            }
        }
    </div>
    <div class="container text-center">
        @if (IsCheck)
        {
            <FluentButton Appearance="Appearance.Accent" OnClick="@(()=>CallCheck.InvokeAsync(QView))">
                Ellenőrzés
            </FluentButton>
        }
        @if (Next.HasDelegate)
        {
            <FluentButton OnClick="@(()=>Next.InvokeAsync(QView))">
                    Következő
            </FluentButton>
        }
    </div>
}
@code {
    [Parameter] public QuestionView? QView { get; set; }
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<QuestionView> Next { get; set; }
    [Parameter] public EventCallback<QuestionView> CallCheck { get; set; }
    string[] texts;
    //string[] ans = new string[10];

    //void Send() => Next.InvokeAsync(QView);
    protected override void OnInitialized()
    {
        texts = QView.QuestionText.Split('{', '}');

        base.OnInitialized();
    }
}
