@* Lezárt teszt kártyája (tanár). *@
@using TeszterLibrary.Extensions
@using Ic16 = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16
@using Ic20 = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20
@if (TestItem is not null)
{
    <TestCardShell Title="@TestItem.Title" Subject="@TestItem.Subject">
        <Flags>
            <TestFlags IsCheck="TestItem.IsCheck" IsPractice="TestItem.IsPractice" IsTimer="TestItem.IsTimer" Replays="TestItem.TestReplaceNumber" />
        </Flags>
        <Status>
            @if (TestItem.HasNoDecided)
            {
                <FluentMessageBar Intent="MessageBarIntent.Warning">Néhány kérdés pontozása beavatkozást igényel.</FluentMessageBar>
            }
        </Status>
        <Details>
            <TestMeta Label="Kezdés" Value="@TestItem.StartTime.ToString("d")" Icon="@(new Ic16.CalendarLtr())" />
            <TestMeta Label="Lezárás" Value="@TestItem.EndTime.ToString("d")" Icon="@(new Ic16.CalendarCheckmark())" />
            <TestMeta Label="Kitöltötte" Value="@($"{TestItem.ReadyNumber} / {TestItem.UserNumber} fő")" Icon="@(new Ic16.People())" />
            <TestMeta Label="Időtartam (min / max)" Value="@($"{TestItem.MinTime.ToTime()} / {TestItem.MaxTime.ToTime()}")" Icon="@(new Ic16.Timer())" />
        </Details>
        <Actions>
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Ic20.ChartMultiple())" OnClick="@(() => Result.InvokeAsync(TestItem))">Eredmények</FluentButton>
        </Actions>
    </TestCardShell>
}

@code{
    [Parameter]
    public TestResultToTeacher? TestItem { get; set; }
    [Parameter]
    public EventCallback<TestResultToTeacher> Result { get; set; }
}
