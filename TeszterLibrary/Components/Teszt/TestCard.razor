@* Aktív teszt kártyája (tanár). *@
@using Ic16 = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16
@using Ic20 = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20
@if (TestItem is not null)
{
    <TestCardShell Title="@TestItem.Title" Subject="@TestItem.Subject">
        <Flags>
            <TestFlags IsCheck="TestItem.IsCheck" IsPractice="TestItem.IsPractice" IsTimer="TestItem.IsTimer" Shuffle="TestItem.ShuffleQuestion" Replays="TestItem.ReplaceNumber" />
        </Flags>
        <Details>
            <TestMeta Label="Kezdés" Value="@TestItem.StartTime.ToString("d")" Icon="@(new Ic16.CalendarLtr())" />
            <TestMeta Label="Lezárás" Value="@TestItem.EndTime.ToString("d")" Icon="@(new Ic16.CalendarCheckmark())" />
            <TestMeta Label="Pontszám" Value="@($"{TestItem.Summa} pont")" Icon="@(new Ic16.Trophy())" />
            <TestMeta Label="Időtartam" Value="@TestItem.Time.ToTime()" Icon="@(new Ic16.Timer())" />
        </Details>
        <Progress>
            <div class="test-progress">
                <div class="test-progress__label">
                    <span>Kitöltötte: <strong>@TestItem.Ready / @TestItem.All</strong> fő</span>
                    @if (TestItem.NotActive > 0)
                    {
                        <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Warning" Content="@($"{TestItem.NotActive} nem kezdte el")" />
                    }
                </div>
                <FluentProgressBar Min="0" Max="@Math.Max(TestItem.All, 1)" Value="@TestItem.Ready" />
            </div>
        </Progress>
        <Actions>
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Ic20.ChartMultiple())" OnClick="@(() => Result.InvokeAsync(TestItem))">Eredmények</FluentButton>
        </Actions>
    </TestCardShell>
}

@code{
    [Parameter]
    public ActiveTestView? TestItem { get; set; }
    [Parameter]
    public EventCallback<Test> Result { get; set; }
}
