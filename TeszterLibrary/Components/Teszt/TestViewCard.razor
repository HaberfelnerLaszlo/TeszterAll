@* Kitölthető teszt kártyája (diák). *@
@using Ic16 = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16
@using Ic20 = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20
@if (TestItem is not null)
{
    <TestCardShell Title="@TestItem.Title" Subject="@TestItem.Subject">
        <Flags>
            <TestFlags IsCheck="TestItem.IsCheck" IsPractice="TestItem.IsPractice" IsTimer="TestItem.IsTimer" Shuffle="TestItem.ShuffleQuestion" />
        </Flags>
        <Details>
            <TestMeta Label="Határidő" Value="@TestItem.EndTime.ToString("d")" Icon="@(new Ic16.CalendarCheckmark())" />
            <TestMeta Label="Kitöltések" Value="@($"{TestItem.UserReplaceNumber} / {TestItem.TestReplaceNumber}")" Icon="@(new Ic16.ArrowRepeatAll())" />
            <TestMeta Label="Pontszám" Value="@($"{TestItem.Summa} pont")" Icon="@(new Ic16.Trophy())" />
            <TestMeta Label="Időtartam" Value="@TestItem.Time.ToTime()" Icon="@(new Ic16.Timer())" />
        </Details>
        <Actions>
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Ic20.Play())" OnClick="@(() => Start.InvokeAsync(TestItem))">Teszt indítása</FluentButton>
            @if (TestItem.UserReplaceNumber > 0)
            {
                <FluentButton Appearance="ButtonAppearance.Default" IconStart="@(new Ic20.DataBarVertical())" OnClick="@(() => Results.InvokeAsync(TestItem.TestUserId.ToString()))">Eredmények</FluentButton>
            }
        </Actions>
    </TestCardShell>
}
@code {
    [Parameter] public TestView TestItem { get; set; } = new();
    [Parameter] public EventCallback<TestView> Start { get; set; }
    [Parameter] public EventCallback<string> Results { get; set; }
}
