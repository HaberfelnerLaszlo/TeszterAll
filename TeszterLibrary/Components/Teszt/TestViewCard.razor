<div class="testcard">
	<div class="row">
		<p>@Test.Title</p>
		<div class="col">
			<p>@Test.Subject tantárgy</p>
			<p>Indulás: @Test.StartTime.ToShortDateString() </p>
			<p>Vége: @Test.EndTime.ToShortDateString() </p>
		</div>
		<div class="col">
			<p>Ismételhető: @Test.ReplaceNumber</p>
			<p>@Test.Summa pont</p>
			<p>@TimeSpan.FromSeconds(Test.Time) @Test.Time mp</p>
		</div>
		<div class="testsign">
            <img src="_content/TeszterLibrary/images/recycle.svg" height="15px" hidden="@(!Test.ShuffleQuestion)" title="Kevert kérdések"/>
            <img src="_content/TeszterLibrary/images/fa-user-clock.svg" height="15px" hidden="@(!Test.IsTimer)" title="Idő korlátos" />
			<i class="oi oi-check-double text-primary" data-bs-toggle="tooltip" data-bss-tooltip="" data-bs-placement="bottom" id="check" title="Ellenőrizhető" hidden="@(!Test.IsCheck)"></i>
			@* <span hidden="@(!Test.IsCheck)">el</span> *@
			<i class="oi oi-pecil answer  text-success" data-bs-toggle="tooltip" data-bss-tooltip="" data-bs-placement="bottom" id="practice" title="Gyakorlás" hidden="@(!Test.IsPractice)"></i><span hidden="@(!Test.IsPractice)"></span>
			@* <span hidden="@(!Test.IsPublished)">pu</span> *@
		
		
		</div>
	</div>
	<div class="row" style="justify-content:space-around">
        <button class="btn btn-primary" style="width:45%" @onclick=@(()=>Edit.InvokeAsync(Test))>@BtnText</button>
    </div>
</div>
@code {
	[Parameter] public Test Test { get; set; } = new();
	[Parameter] public string BtnText { get; set; } = "Gond van";
	[Parameter] public EventCallback<Test> Edit { get; set; }

}
