@inject TestServices tservice
<h3>TestView</h3>
@if (tests.Count>0)
{
    <button class="btn btn-primary" @onclick=PublishTest>Próba</button>
}
@foreach (var item in tests)
{
    <NoPublishTestCard TestItem="item"></NoPublishTestCard>
}

@code {
    
    [Parameter] public string UserId { get; set; }
    private List<Test> tests = new();
    private Test test = new();
    bool ispublish = false;
    protected override async Task OnParametersSetAsync()
    {
        //tests = await tservice.GetTests();
        tests=await tservice.GetNoPublished(Guid.Parse(UserId));
        test = tests.FirstOrDefault();
        //return await base.OnParametersSetAsync().ConfigureAwait(false);
    }
    private void PublishTest()
    {
        test = tests.FirstOrDefault();
        ispublish = true;
        StateHasChanged();
    }
}
