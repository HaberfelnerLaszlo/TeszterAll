@* Lezárt teszt eredménye (diák). *@
@using Ic16 = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16
@using Ic20 = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20
<TestCardShell Title="@TestResult.Title" Subject="@TestResult.Subject">
    <Flags>
        <TestFlags IsPractice="TestResult.IsPractice" IsTimer="TestResult.IsTimer" />
    </Flags>
    <Details>
        <TestMeta Label="Lezárult" Value="@TestResult.EndTime.ToString("d")" Icon="@(new Ic16.CalendarCheckmark())" />
        <TestMeta Label="Pontszám" Value="@($"{TestResult.Score} / {TestResult.Summa}")" Icon="@(new Ic16.Trophy())" />
        <TestMeta Label="Ráfordított idő" Value="@TestResult.Time.ToTime()" Icon="@(new Ic16.Timer())" />
        <TestMeta Label="Próbálkozások" Value="@($"{TestResult.UserReplaceNumber} / {TestResult.TestReplaceNumber}")" Icon="@(new Ic16.ArrowRepeatAll())" />
    </Details>
    <Progress>
        <FluentProgressBar Min="0" Max="@Math.Max(TestResult.Summa, 1)" Value="@TestResult.Score" />
    </Progress>
    <Actions>
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Ic20.Eye())" OnClick="@(()=>Open.InvokeAsync(TestResult.TestUserId))">Megtekintés</FluentButton>
    </Actions>
</TestCardShell>
@code {
    [Parameter] public TestResultToStudent TestResult { get; set; }= new TestResultToStudent();
    [Parameter] public EventCallback<int> Open { get; set; }
}
