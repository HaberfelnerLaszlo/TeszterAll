@if (Answers is not null)
{
    <div class="container">
            @foreach (var answer in Answers)
            {
                <FluentTextField Appearance="FluentInputAppearance.Filled" Placeholder="@("Válasz helye...")" Value="@answer.Text" ReadOnly="@(!Next.HasDelegate)" ValueChanged="@((e)=>answer.Text=e)" />
                @if (IsChecked)
                {
                    if (answer.Result)
                    {
                        <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Checkmark())" />
                    }
                    else
                    {
                        <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Dismiss())" Color="@Color.Error" />
                    }
                }
            }
    </div>
    <div class="container text-center">
        @if (IsCheck)
        {
            <FluentButton Appearance="Appearance.Accent" OnClick="@(() => CallCheck.InvokeAsync(Answers))">
                Ellenőrzés
            </FluentButton>
        }
        @if (Next.HasDelegate)
        {
            <FluentButton Appearance="Appearance.Neutral" OnClick="@(()=>Next.InvokeAsync(Answers))">
                Következő
            </FluentButton>
        }
    </div>
}
@code {
    [Parameter] public List<AnswerView> Answers { get; set; } = new();
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> Next { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> CallCheck { get; set; }
    string answerText = string.Empty;
    protected override void OnParametersSet()
    {
        answerText = Answers[0].Text;
        base.OnParametersSet();
    }
}
