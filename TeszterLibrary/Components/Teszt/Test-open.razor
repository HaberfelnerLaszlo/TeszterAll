@* Nyílt végű kérdés: egy (vagy több) szöveges válaszmező. *@
@if (Answers is not null)
{
    <div class="answer-list">
        @foreach (var a in Answers)
        {
            var answer = a;
            <div class="answer-input">
                <FluentTextInput Placeholder="Írd ide a válaszod..." Value="@answer.Text" ReadOnly="@(!Next.HasDelegate)" ValueChanged="@((string e) => answer.Text = e)" Width="100%" aria-label="Válasz" />
                @if (IsChecked)
                {
                    <AnswerResult Correct="answer.Result" />
                }
            </div>
        }
    </div>
    <QuestionActions ShowCheck="IsCheck" OnCheck="@(() => CallCheck.InvokeAsync(Answers))" OnNext="@(Next.HasDelegate ? EventCallback.Factory.Create(this, () => Next.InvokeAsync(Answers)) : default)" />
}
@code {
    [Parameter] public List<AnswerView> Answers { get; set; } = new();
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsChecked { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> Next { get; set; }
    [Parameter] public EventCallback<List<AnswerView>> CallCheck { get; set; }
    string answerText = string.Empty;
    protected override void OnParametersSet()
    {
        answerText = Answers[0].Text;
        base.OnParametersSet();
    }
}
