@using TeszterLibrary.Services;
@using Microsoft.Graph;
@using Microsoft.Kiota.Abstractions.Authentication;

@inject TestServices tService

<Modal Show=showQDetail Accept="CloseModal" AcceptButtom="Bezár">
	<HeaderContent>
		A kérdés részletei
	</HeaderContent>
	<BodyContent>
		<QAView question="detailQuestion"/>
	</BodyContent>
</Modal>
@* @if (publishing)
{
<PublicTest Test="newTest"></PublicTest>
}
else{ 
<FluentAccordion>
	<FluentAccordionItem Heading="Szűrő">
		<QuestionFilter @bind-Questions="questions" Subject=@newTest.Subject/>
	</FluentAccordionItem>
</FluentAccordion>*@
<label for="title">Teszt címe: </label>
<input id="title" @bind-value="newTest.Title" placeholder="Teszt címe" />
<select id="Subject" @onchange="SelectedSubject" class="mx-3">
	@if (subjects.Count > 0)
	{
		<option value="0">Tantárgyak ...</option>
		foreach (var item in subjects)
		{
			<option value="@item.Name">@item.Name</option>
		}
	}
</select>
<button class="btn btn-success btn-sm" @onclick=TestAdd>Mentés</button>
<div class="row">
	<div id="Test" class="col border border-secondary overflow-auto" style="max-height:800px;">
		@if (TesztQ.Count != 0)
		{
			foreach (var tq in TesztQ)
			{
				<QAView question="tq" Delete="DeleteQ"></QAView>
			}
		}
	</div>
	<div id="Questions" class="col-sm-4 bg-light overflow-auto" style="max-height:800px; min-width:200px">
		@foreach (var question in questions)
		{
			<div style="position:relative; margin:10px 0">
			<Qview question="question"></Qview>
				<div style="position:absolute; top:-10px; right:-15px">
					<button class="btn btn-primary btn-sm m-1" @onclick="() => AddQuestion(question)"><i class="oi oi-plus"/></button>
					<br>
					<button class="btn btn-info btn-sm m-1" @onclick="(()=>ModalOpen(question))"><i class="oi oi-eye"/></button>
				</div>
			</div>
		}
	</div>
</div>
}
@code {
	[Parameter] public List<Question> questions { get; set; } = new();
	[Parameter] public List<Subject> subjects { get; set; } = new();
	[Parameter] public List<Question> TesztQ { get; set; } = new();
	[Parameter] public string UserId { get; set; } = string.Empty;
	[Parameter] public EventCallback<Test> Publish { get; set; }

	private Test newTest = new();
	private bool showQDetail = false;
	private Question detailQuestion = new();
	bool isSaved = false;
	bool publishing = false;
	private List<Question> allQuestions = new();
	protected override void OnParametersSet()
	{
		if (questions.Count == 0 && allQuestions.Count > 0)
		{
			questions = allQuestions;
		}
		else if (questions.Count > 0 && allQuestions.Count == 0)
		{
			allQuestions = questions;
		}
		base.OnParametersSet();
	}

	private void ModalOpen(Question q)
	{
		detailQuestion = q;
		showQDetail = true;
	}
	private void CloseModal()
	{
		showQDetail = false;
	}
	private void AddQuestion(Question q)
	{
		questions.Remove(q);
		TesztQ.Add(q);
	}

	private async Task DeleteQ(Question question)
	{
		//var index = testQuestions.FindIndex(t => t.QuestionId == question.Id);
		//if (index != -1)
		//{
		//    testQuestions.RemoveAt(index);
		//    if (IsSaved)
		//    {
		//        await tqservice.DeleteTestQuestionAsync(question.Id, newTest.Id);
		//    }
		//}
		TesztQ.Remove(question);
		questions.Add(question);
	}
	private async Task SelectedSubject(ChangeEventArgs e)
	{

		if (e.Value != null)
		{
			newTest.Subject = e.Value.ToString()??string.Empty;
		}
	}
	private async Task TestAdd()
	{
		try
		{
			newTest.CreatedBy = Guid.Parse(UserId);
			newTest.Id = 10;
			if (newTest.TestQuestions is null)
			{
				newTest.TestQuestions = new();
			}
			else
			{
				newTest.TestQuestions.Clear();
			}
			foreach (var item in TesztQ)
			{
				newTest.TestQuestions.Add(new() { QuestionId = item.Id, Score = item.Score, Time = item.Time });
			}
			if (isSaved)
			{
				var responde = await tService.UpdateTestAsync(newTest);
			}
			else
			{
				newTest = await tService.AddTest(newTest);
				isSaved = true;
			}
			TesztQ.Clear();
			await Publish.InvokeAsync(newTest);
			// publishing = true;
			// StateHasChanged();
		}
		catch (Exception ex)
		{
			Console.WriteLine(ex.Message);
			throw;
		}
	}
}
