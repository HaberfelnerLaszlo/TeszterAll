
<div class="card bg-transparent rounded" style="border-color:@bgColor; border-width:medium">
    <div class="card-header">
        <div class="row">
            <div class="col col-7"><b>@question.Subject <br/> @question.Title</b> </div>
            <div class="col">
                <p class="float-right" style="margin:0">@qType</p> <br/>

                <span class="badge text-bg-primary"><b>@question.Time mp</b></span>
               <FluentBadge><b>@question.Score pont</b></FluentBadge>
            </div>
        </div>
    </div>
    <div>
        <p class="p-1">@((MarkupString)question.Text)</p>
    </div>
</div>

@code {
    [Parameter]
    public Question question { get; set; } = new Question();
    private ConsoleColor bgColor = ConsoleColor.Cyan;
    private string qType;

    protected override void OnParametersSet()
    {
        switch (question.QType)
        {
            case QuestionType.SC:
                qType = "Feleletválasztó";
                bgColor = ConsoleColor.Green;
                break;
            case QuestionType.MC:
                qType = "Többválasztásos";
                bgColor = ConsoleColor.DarkCyan;
                break;
            case QuestionType.TF:
                qType = "Igaz-Hamis";
                bgColor = ConsoleColor.Magenta;
                break;
            case QuestionType.Open:
                qType = "Nyíltvégű";
                bgColor = ConsoleColor.Yellow;
                break;
            case QuestionType.Seq:
                qType = "Sorbarendezó";
                bgColor = ConsoleColor.Red;
                break;
            case QuestionType.Pair:
                qType = "Párválasztó";
                bgColor = ConsoleColor.Blue;
                break;
            default:
                qType = "Nem tudom";
                bgColor = ConsoleColor.Black;
                break;
        }
    }
}
