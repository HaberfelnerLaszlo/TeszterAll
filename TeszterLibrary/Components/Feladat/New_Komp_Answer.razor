<FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical">
    <div style="padding: 10px; border: 1px solid #ccc;margin: 10px;">
        @SafeHtml.Markup(NewAnswer.Text)
    </div>
    <FluentTextInput Placeholder="Helyes válasz" Label="Helyes válasz" Style="width:300px;min-width:100px" @bind-Value="NewAnswer.RightAnswer"/>
    <FluentNumberInput Label="Pontszám" TValue="int" @bind-Value="NewAnswer.Score" Min="0" Max="100" Style="width:100px"/>
</FluentStack>
@code {
    [Parameter]
    public Answer NewAnswer { get; set; } = new Answer();
}
