<FluentStack Orientation="Microsoft.FluentUI.AspNetCore.Components.Orientation.Vertical">
    <div style="padding: 10px; border: 1px solid #ccc;margin: 10px;">
        @((MarkupString)NewAnswer.Text)
    </div>
    <FluentTextField Placeholder="Helyes válasz" Label="Helyes válasz" Style="width:300px;min-width:100px" @bind-Value="NewAnswer.RightAnswer"/>
    <FluentNumberField Label="Pontszám" TValue="int" @bind-Value="NewAnswer.Score" Min="0" Max="100" Style="width:100px"/>
</FluentStack>
@code {
    [Parameter]
    public Answer NewAnswer { get; set; } = new Answer();
}
