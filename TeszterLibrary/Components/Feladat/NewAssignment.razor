            //     }
            // }
            // answerRefs = newRefs;
            AnswerCount = newAnswers.Count;
            if (newAnswers.Count > 0) activeTabId = $"tab-{newAnswers.First().Sequence}";
           // toRemoveSequences = null; 
            await InvokeAsync(StateHasChanged);
        }
