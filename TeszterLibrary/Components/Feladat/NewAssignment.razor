@using System.Linq
@inject QuestionServices qServices
@inject IToastService toastService
<FluentGrid >
@*általános rész*@
    <FluentGridItem>
        <DefaultDataAssignment NewQuestion="@newQuestion" />
        <FluentButton Appearance="Appearance.Accent" @onclick="async () => await SaveQuestion()">Kérdés mentése</FluentButton>
    </FluentGridItem>
    @*feladat rész*@
    <FluentGridItem xs="12" sm="6">
        <RichTextEditorWithImage @ref="richTEWI" Context="@newQuestion.Text" ContextChanged="@((value) => newQuestion.Text = value)" DirtyChanged="@OnEditorDirtyChanged" />
    </FluentGridItem>
    @*válasz rész*@
    @if(IsSavedQuestion)
    {
    <FluentGridItem xs="12" sm="6">
        <FluentButton Appearance="Appearance.Accent" @onclick="async () => await AddAnswer()">Új válasz hozzáadása</FluentButton>
            @if (newAnswers.Count > 0)
            {
            <FluentTabs ActiveTabId="@activeTabId" OnTabClose="@ClosedTab" ShowClose="true">
                @foreach (var answer in newAnswers) 
                {
                    var seq = answer.Sequence;
                    <FluentTab @key="seq" Label="@($"{seq}. feladat")" Id="@($"tab-{seq}")" Data="answer" Visible="@(!toRemoveSequences?.Contains(seq)??true)">
                            <New_Komp_Answer @key="seq" @ref="answerRefs[seq]" NewAnswer="answer"/>
                    </FluentTab>
                }
                </FluentTabs>
            }
        </FluentGridItem>
    }
    else{
    <FluentGridItem>
        <FluentLabel>Válaszok szerkesztéséhez menteni kell a kérdést!</FluentLabel>
    </FluentGridItem>
    }
    @if (editorIsDirty)
    {
        <div class="warning">Változások nem mentve</div>
@*         <FluentButton @onclick="SaveAll">Mentés</FluentButton>

        <FluentButton @onclick="DiscardChanges">Elvetés</FluentButton>
 *@    }
</FluentGrid>
