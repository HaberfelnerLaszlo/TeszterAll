    private async Task SaveQuestion()
    {//Mentés logika
        await richTEWI.SaveContent();
        await Task.Delay(100); //Várakozás, hogy a rich text editor befejezze a mentést
        foreach(var kvp in answerRefs.OrderBy(k => k.Key))
        {
            if (kvp.Value != null) 
            {
                //await kvp.Value.SaveAnswer();
                await Task.Delay(100); //Várakozás, hogy a rich text editor befejezze a mentést
            }
        }
        if(string.IsNullOrWhiteSpace(newQuestion.Text))
        {
            toastService.ShowWarning("A kérdés szövege nem lehet üres.");
            return;
        }
        if(string.IsNullOrWhiteSpace(newQuestion.Title))
        {
            toastService.ShowWarning("A kérdés címe nem lehet üres.");
            return;
        }
        if(newAnswers.Count == 0 && IsSavedQuestion)
        {
            toastService.ShowWarning("Legalább egy választ hozzá kell adni a kérdéshez.");
            await AddAnswer();
            return;
        }
        else
        {
            newQuestion.Answers = newAnswers;
        }
        // if (IsSavedQuestion)
        // {
        //     var r = await qServices.UpdateQuestionAsync(newQuestion);
        //     if(r is null)
        //     {
        //         toastService.ShowError("Hiba történt a kérdés mentése során.");
        //         return;
        //     }
        //     toastService.ShowSuccess("Kérdés sikeresen frissítve.");
        //     return;
        // }
        // else{
        //     var r = await qServices.AddQuestionAsync(newQuestion);
        //     if(r is null)
        //     {
        //         toastService.ShowError("Hiba történt a kérdés mentése során.");
        //         return;
        //     }
        //     toastService.ShowSuccess("Kérdés sikeresen mentve.");
        //     newQuestion = r;
        //     AddAnswer();
        //     IsSavedQuestion = true;
        // }
        IsSavedQuestion = true;
        StateHasChanged();
        await Save.InvokeAsync(newQuestion);
    }
    private async Task AddAnswer()
    {
        AnswerCount++;
        try
        {
            if (answerRefs.Count > 0){
                //Ellenőrzés, hogy az előző válasz ki lett-e töltve
                var lastRef = answerRefs.OrderBy(k => k.Key).Last().Value;
                if (lastRef != null) {
                    //await lastRef.SaveAnswer();
                    if (string.IsNullOrWhiteSpace(lastRef.NewAnswer.Text) || string.IsNullOrWhiteSpace(lastRef.NewAnswer.RightAnswer))
                    {
                        toastService.ShowWarning("Az előző választ ki kell tölteni, mielőtt új választ adna hozzá.");
                        return;
                    }
                }
            }

            var seq = newAnswers.Count + 1; 
            newAnswer = new Answer() { Sequence = seq, QuestionId = newQuestion.Id };
            newAnswers.Add(newAnswer);
            answerRefs[seq] = null;
            AnswerCount = newAnswers.Count;
            activeTabId = $"tab-{seq}"; 
            await InvokeAsync(StateHasChanged);

        }
        catch (Exception ex)
        {
            toastService.ShowError($"Hiba történt: {ex.Message}");
            AnswerCount = newAnswers.Count;
        }
    }
    async Task ClosedTab(FluentTab tab)
    {
        if (newAnswers.Count <= 1) return;
        var removedAnswer = (Answer)tab.Data!;
        if (toRemoveSequences is null) toRemoveSequences = new[] { removedAnswer.Sequence };
        else toRemoveSequences.Append(removedAnswer.Sequence);
        await InvokeAsync(StateHasChanged);
    }
