<div class="testcard row">
	<p>@Test.Title</p>
	<div class="col">
		<span>@Test.Subject tantárgy</span>
		<span>@Test.StartTime.ToShortDateString() Indulás</span>
		<span>@Test.EndTime.ToShortDateString() Vége</span>
	</div>
	<div class="col">
		<span>@Test.ReplaceNumber</span>hányszor?
		<span>@Test.Summa pont</span>
		<span>@Test.Time mp</span>idő
	</div>
	<div class="testsign">
		<span hidden="@(!Test.ShuffleQuestion)">ke</span>
		<span hidden="@(!Test.IsTimer)">id</span>
		<span hidden="@(!Test.IsCheck)">el</span>
		<span hidden="@(!Test.IsPractice)">gy</span>
		<span hidden="@(!Test.IsPublished)">pu</span>
	</div>
</div>

@code {
	[Parameter] public Test Test { get; set; } = new();
}
