@inject IToastService toastService
@* Oldalsó panel (drawer) a teszt szekcióinak szerkesztéséhez.
   Fluent UI v5-ben párbeszédablak nem nyitható párbeszédablakból, ezért a felvétel/szerkesztés/törlés
   a panelen belül, beágyazott szerkesztősávként jelenik meg (v4-ben külön FluentDialog-ok voltak). *@
<FluentDialogBody>
    <TitleTemplate>
        @Dialog?.Options.Header.Title
    </TitleTemplate>
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
            <FluentStack Orientation="Orientation.Horizontal">
                <FluentButton OnClick="OnOpenAdd" IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Add())" Title="Új szekció" />
                <FluentButton OnClick="OnOpenEdit" IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Pen())" Disabled="@(selectSection is null)" Title="Szerkesztés" />
                <FluentButton OnClick="OnOpenDelete" IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.SlideEraser())" Color="red" Disabled="@(selectSection is null)" Title="Törlés" />
            </FluentStack>
            <FluentListbox TOption="Section" TValue="Section" Items="Content" OptionText="@(s => s?.Name ?? string.Empty)" Value="@selectSection" ValueChanged="@((Section? s) => ListboxValueChanged(s))" />

            @if (mode == EditMode.Edit)
            {
                <FluentTextInput @bind-Value="sectionName" Label="Szekció neve:" Autofocus="true" />
                <FluentStack Orientation="Orientation.Horizontal">
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="OnClose">Mentés</FluentButton>
                    <FluentButton OnClick="@(() => mode = EditMode.None)">Mégsem</FluentButton>
                </FluentStack>
            }
            else if (mode == EditMode.Delete)
            {
                <FluentText Weight="TextWeight.Semibold" Block="true">Biztosan törli a következő szekciót?</FluentText>
                <FluentText Block="true">Törlendő szekció neve: @selectSection?.Name</FluentText>
                <FluentStack Orientation="Orientation.Horizontal">
                    <FluentButton Appearance="ButtonAppearance.Primary" BackgroundColor="red" OnClick="DeleteSection">Törlés</FluentButton>
                    <FluentButton OnClick="@(() => mode = EditMode.None)">Mégsem</FluentButton>
                </FluentStack>
            }
        </FluentStack>
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => Dialog!.CloseAsync(Content))">Mentés</FluentButton>
        <FluentButton OnClick="@(() => Dialog!.CancelAsync())">Mégsem</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    private enum EditMode { None, Edit, Delete }

    [CascadingParameter] public IDialogInstance? Dialog { get; set; }
    [Parameter] public List<Section> Content { get; set; } = default!;
    private Section? selectSection, oldSection;
    private string sectionName = string.Empty;
    private EditMode mode = EditMode.None;

    private void ListboxValueChanged(Section? section)
    {
        if (section is null) return;
        selectSection = section;
        sectionName = section.Name;
    }
    private void OnOpenAdd()
    {
        oldSection = null;
        sectionName = "üres";
        mode = EditMode.Edit;
    }
    private void OnOpenEdit()
    {
        if (selectSection is null) return;
        oldSection = selectSection;
        sectionName = selectSection.Name;
        mode = EditMode.Edit;
    }
    private void OnOpenDelete()
    {
        if (selectSection is null) return;
        mode = EditMode.Delete;
    }
    private void OnClose()
    {
        if (!string.IsNullOrEmpty(sectionName))
        {
            if (oldSection is not null)
            {
                oldSection.Name = sectionName;
                selectSection = oldSection;
            }
            else
            {
                selectSection = new Section { Name = sectionName };
                Content.Add(selectSection);
            }
        }
        mode = EditMode.None;
    }

    protected override void OnInitialized()
    {
        if (Content is not null)
        {
            Content.Add(new Section() { Name = "Elmélet" });
            Content.Add(new Section() { Name = "Gyakorlat" });
            selectSection = Content.FirstOrDefault();
        }
        else
        {
            toastService.ShowWarning("A szekciók lista null értéket vett fel");
            return;
        }

        base.OnInitialized();
    }
    private void DeleteSection()
    {
        if (selectSection is not null) Content.Remove(selectSection);
        selectSection = Content.FirstOrDefault();
        mode = EditMode.None;
    }
}
