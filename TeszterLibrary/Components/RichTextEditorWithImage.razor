@using Blazored.TextEditor
@using Microsoft.AspNetCore.Hosting
@using Microsoft.JSInterop

@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment Environment
@inject GraphService graphService
@inject FolderData folderData
@inject IToastService toastService
@* @if(!hide)
{ *@
<div id="@wrapperId">
  <BlazoredTextEditor @ref="textEditor" DebugLevel="warn" EditorCssStyle="width:100%">
    <ToolbarContent>
        <span class="ql-formats">
            <button class="ql-bold"></button>
            <button class="ql-italic"></button>
            <button class="ql-underline"></button>
            <button class="ql-image"></button>
        </span>
    </ToolbarContent>
    <EditorContent>
        @((MarkupString)htmlContent)
    </EditorContent>
  </BlazoredTextEditor>
</div>
@* } *@
<button @onclick="SaveContent">Mentés</button>
@* <p>htmlContent: @htmlContent</p>
<hr/>
<p>Context: @Context</p> *@
@code {
    [Parameter] public string Context { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ContextChanged { get; set; }
    [Parameter] public EventCallback<bool> DirtyChanged { get; set; }
    private BlazoredTextEditor textEditor=new();
    private string htmlContent=string.Empty, driveId=string.Empty, folderId=string.Empty;
    bool hide = false, isModified = false;
    private string wrapperId = $"rte-{Guid.NewGuid():N}";
    private DotNetObjectReference<RichTextEditorWithImage>? dotNetRef;
    private bool isDirty = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if(string.IsNullOrEmpty(folderData.ImageFolderId))
            {
                folderData.AddFolderIds();
            }
            driveId = folderData.MyDriveId;
            folderId = folderData.ImageFolderId;
            htmlContent = Context;
            StateHasChanged();
            //await this.textEditor.LoadHTMLContent(htmlContent);
            // dotNetRef = DotNetObjectReference.Create(this);
            // await JSRuntime.InvokeVoidAsync("rteInterop.registerChangeHandler", wrapperId, dotNetRef);
        }
    }
    public async Task SaveContent()
    {
        try
        {
            // Mentés előtt dolgozd fel a képeket
            htmlContent = await textEditor.GetHTML();
            htmlContent = await ProcessImages(htmlContent);
            //hide = !hide;
            if(isModified)
            {
                await textEditor.LoadHTMLContent(htmlContent);
                isModified = false;
            }
            // Itt mentheted az htmlContent változó tartalmát az adatbázisba vagy más tárolóba
            Context = htmlContent;
            await ContextChanged.InvokeAsync(Context);
            await InvokeAsync(StateHasChanged);
            //hide = !hide;
            isDirty = false;
            // if (DirtyChanged.HasDelegate) await DirtyChanged.InvokeAsync(false);
            // await JSRuntime.InvokeVoidAsync("rteInterop.setBeforeUnload", false);
            //Console.WriteLine(htmlContent);
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Hiba történt: {ex.Message}");
        }
    }

    private async Task<string> ProcessImages(string html)
    {
        var doc = new HtmlAgilityPack.HtmlDocument();
        doc.LoadHtml(html);
        var images = doc.DocumentNode.SelectNodes("//img");

        if (images != null)
        {
            foreach (var img in images)
            {
                var base64Data = img.GetAttributeValue("src", string.Empty);// Ellenőrizd, hogy a src attribútum tartalmaz-e base64 adatot. null volt!!!
                if (base64Data.StartsWith("data:image"))
                {
                    isModified = true;
                    var filePath = await SaveImage(base64Data);
                    img.SetAttributeValue("src", filePath);
                }
            }
        }

        return doc.DocumentNode.OuterHtml;
    }

    private async Task<string> SaveImage(string base64Data)
    {
        string filePath=string.Empty;
        try
        {
            var base64 = base64Data.Substring(base64Data.IndexOf(",") + 1);
            var bytes = Convert.FromBase64String(base64);
            var fileName = Guid.NewGuid().ToString() + ".png";
            if (!String.IsNullOrEmpty(folderId))
            {
                filePath = await graphService.UploadFileToFolder(bytes, fileName, folderId, driveId);
                toastService.ShowSuccess("Kép sikeresen feltöltve a Onedrive-ba!");
            }
            else
            {
                toastService.ShowError("Hiba a képfeltöltés során!");
                filePath = Path.Combine(Environment.WebRootPath, "uploads", fileName);
                await File.WriteAllBytesAsync(filePath, bytes);
                toastService.ShowSuccess("Kép sikeresen feltöltve a szerverre!");
            }
            var image = new Image
                {
                    FilePath = filePath,
                    FileName = fileName,
                    UploadDate = DateTime.Now
                };
            return filePath;
        }
        catch (Exception)
        {
            toastService.ShowError("Hiba a kép mentése során!");
            return string.Empty;
        }
    }

    [JSInvokable]
    public async Task NotifyEditorChanged()
    {
        try
        {

            // ne hívjuk a SaveContent-et itt; csak jelöljük, hogy van mentetlen változás 
            if (!isDirty)
            {
                isDirty = true; 
                if (DirtyChanged.HasDelegate) await DirtyChanged.InvokeAsync(true); await JSRuntime.InvokeVoidAsync("rteInterop.setBeforeUnload", true);
            }
            // ha szeretnéd automatikusan menteni:
            //var current = await textEditor.GetHTML();
            //Context = current;
            await ContextChanged.InvokeAsync(Context);

            // ha a SaveContent() további képfeldolgozást csinál, hívhatod azt is, de gondolj aszinkron és költséges műveletekre:
            // await SaveContent(); // csak ha biztonságos és nem túl költséges minden billentyűre
        }
        catch (Exception ex)
        {
            toastService?.ShowError($"Editor callback error: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (dotNetRef != null)
        {
            await JSRuntime.InvokeVoidAsync("rteInterop.unregisterChangeHandler", wrapperId);
            dotNetRef.Dispose();
            dotNetRef = null;
        }
        await JSRuntime.InvokeVoidAsync("rteInterop.setBeforeUnload", false);
    }
}