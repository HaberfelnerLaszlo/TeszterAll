@foreach (var item in studentViews)
{
	<div class="row" style="@((item.TaskType==1)?"background:linear-gradient(90deg,#ff4d4d 25%,#fff 100%)":"background:linear-gradient(90deg,#00b700 25%,#fff 100%)");margin:2px" @onclick="()=>Open(item.CompletTaskId)">
		<div class="col">
			<span class="float-start d-sm-flex justify-content-sm-start align-items-sm-center NameTxt"
				  id="Name">@item.TaskName</span>
		</div>
		<div class="col-3 col-sm-4">
			<div class="row d-flex justify-content-end">
				<span class="badge bg-success float-end d-sm-flex justify-content-sm-end ScoreBadge" id="Complet">@item.Right</span>
				<span class="badge bg-danger d-inline-flex float-end d-sm-flex justify-content-sm-end ScoreBadge" id="Wrong">@item.Wrong</span>
				<span class="badge bg-info text-end d-flex float-end d-sm-flex justify-content-sm-end ScoreBadge" id="NoComplet">@item.AvgTime mp</span>
			</div>
			<div class="row d-flex justify-content-end">
				<span class="activeDate" id="ActiveDate" style="margin: 5px 10px;margin-bottom: 4px;margin-top: 6px;margin-right: 10px;padding-top: 0px;">Befejezte: @item.Date.ToString("yyyy.MM.dd hh:mm")</span>
			</div>
		</div>
	</div>
}
@code {
	[Parameter] public List<ResultStudentView> studentViews { get; set; } = new();
	[Parameter] public EventCallback<int> Click { get; set; }
	private async Task Open(int id) => await Click.InvokeAsync(id);
}
