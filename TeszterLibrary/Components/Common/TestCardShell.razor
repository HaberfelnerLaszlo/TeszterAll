@* Egységes tesztkártya-váz: fejléc (cím, tantárgy, jellemzők), állapotsáv, adatok, haladás, akciók.
   A konkrét kártyák (TestCard, ClosedTestCard, NoPublishTestCard, TestViewCard, TestResultToStudentCard) ezt töltik ki. *@
<FluentCard Class="test-card">
    <div class="test-card__inner">
        <div class="test-card__head">
            <div class="test-card__title">
                <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold">@Title</FluentText>
                @if (!string.IsNullOrEmpty(Subject))
                {
                    <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Brand" Content="@Subject" />
                }
            </div>
            @Flags
        </div>
        @Status
        <dl class="test-card__meta">
            @Details
        </dl>
        @Progress
        @if (Actions is not null)
        {
            <div class="test-card__actions">@Actions</div>
        }
    </div>
</FluentCard>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subject { get; set; }
    /// <summary>Jellemző-ikonok (általában <see cref="TestFlags"/>).</summary>
    [Parameter] public RenderFragment? Flags { get; set; }
    /// <summary>Figyelmeztetés / állapot (pl. FluentMessageBar).</summary>
    [Parameter] public RenderFragment? Status { get; set; }
    /// <summary><see cref="TestMeta"/> elemek.</summary>
    [Parameter] public RenderFragment? Details { get; set; }
    [Parameter] public RenderFragment? Progress { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
