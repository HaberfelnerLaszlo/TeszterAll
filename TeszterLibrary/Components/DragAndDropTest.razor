<h3>DragAndDropTest</h3>
<FluentDragContainer TItem="string"
                     OnDropEnd="@(e => HandleDropEnd(e.Source.Id,e.Target.Id))">
    <FluentStack Orientation="Orientation.Horizontal">
        <FluentStack Orientation="Orientation.Vertical">
            @foreach (var item in lists)
            {
                <FluentDropZone Id="@item.Id.ToString()" Draggable="false" Droppable="true" >
                    @((MarkupString)item.Text)
                </FluentDropZone>
            }
        </FluentStack>
        <FluentStack Orientation="Orientation.Vertical">
            @foreach (var item in valaszok)
            {
                <FluentDropZone Id="@item.Id.ToString()" Draggable="true" Droppable="false">
                    @((MarkupString)item.Text)
                </FluentDropZone>
            }
        </FluentStack>
    </FluentStack>
</FluentDragContainer>
<FluentLabel >@text</FluentLabel>
@code {
    string text = string.Empty;
    List<DataList> lists = new() {
        new() { Id=1, Text="első"},
        new() { Id=3, Text="második"},
        new() { Id=5, Text="harmadik"}
    };
    List<DataList> valaszok = new() {
        new() { Id = 2, Text = "első v" },
        new() { Id = 4, Text = "második v" },
        new() { Id = 6, Text = "harmadik v" }
};
    void HandleDropEnd(string source, string target)
    {
        var masol = valaszok.Find(j => j.Id == Convert.ToUInt32(source)).Text;
        lists.Find(i => i.Id == Convert.ToUInt32(target)).Text = masol;
    }
    private record DataList()
    {
        public int Id { get; set; }
        public string Text { get; set; } = string.Empty;
    }
        }
