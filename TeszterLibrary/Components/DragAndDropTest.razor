<h3>DragAndDropTest</h3>
<DragDropToList TItem="DataList" SourceList="lists" TargetList="valaszok" Context="source">
    <SourceContent>@source.Text</SourceContent>
    <TargetContent>@source.Text</TargetContent>
</DragDropToList>
<FluentLabel >@text</FluentLabel>
@code {
    string text = string.Empty;
    DataList sourceItem = new();
    DataList SelectedValasz = new();
    List<DataList> lists = new() {
        new() { Id=1, Text="első"},
        new() { Id=3, Text="második"},
        new() { Id=5, Text="harmadik"}
    };
    List<DataList> valaszok = new() {
        new() { Id = 2, Text = "első v" },
        new() { Id = 4, Text = "második v" },
        new() { Id = 6, Text = "harmadik v" }
};
    void HandleDropEnd(FluentDropZone<DataList> source, FluentDropZone<DataList> target)
    {
        if (source.Id=="lista")
        {
            valaszok.Add((DataList)source.Data);
            lists.Remove((DataList)source.Data);
        }
        else
        {
            lists.Add((DataList)source.Data);
            valaszok.Remove((DataList)source.Data);
        }
    }
    private record DataList()
    {
        public int Id { get; set; }
        public string Text { get; set; } = string.Empty;
    }
        }
