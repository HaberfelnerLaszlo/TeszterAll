@using TeszterLibrary.ViewModel;
<form style="width:300px;margin:5px auto;">
	@if (assignments.Count>0)
	{
		<table>
		@foreach (var a in assignments)
		{
			<tr>
				<td style="text-align:end">
					@((MarkupString)a.First)
				</td>
				<td>
					<input class="valasz" type="text" value="@a.Result" @onchange="@((e)=>Result(a,e))"/>
				</td>
				<td>
					@((MarkupString)a.Last)
				</td>
				@if (Recives.Count>0 && IsChecked)
				{
					<td>
						@if (a.IsCorrect)
						{
						<i id="right" class="oi oi-circle-check text-success d-inline-flex box"></i>
						}
						else
						{
						<i id="wrong" class="oi oi-circle-x text-end text-danger d-inline-flex box"></i>
						}
					</td>
				}
			</tr>
		}
		</table>
	}
	else
	{
		<p>Az osztálynak még nem adtak mértékegység átváltás feladatot.</p>
	}
</form>
<div style="text-align:center">
@if (Send.HasDelegate)
{
	<button type="submit" class="btn btn-success send" @onclick="()=>Sending()">Ellenőrzés</button>

}
<button type="submit" class="btn btn-primary next" @onclick="@(()=>Next.InvokeAsync())">Következő</button>
</div>
@code{
	[Parameter] public TaskView TaskView { get; set; } = new();
	[Parameter] public List<ClassRecive> Recives { get; set; } = new();
	[Parameter] public bool IsChecked { get; set; }
	[Parameter] public EventCallback<List<ClassRecive>> Send { get; set; }
	[Parameter] public EventCallback Next { get; set; }
	List<ClassAssignment> assignments = new();
	protected override void OnParametersSet()
	{
		assignments.Clear();
		foreach (var item in TaskView.Operations)
		{
			var s = item.Sequence.Split("Ł");
			if (Recives.Count>0)
			{
				var a = Recives.FirstOrDefault(r => r.OperationId == item.OperationId);
				assignments.Add(new ClassAssignment(s[0]+" = ",a.Result??=string.Empty,s.Last(),a.IsTipp));
			}
			else
			{
			}
		}
		base.OnParametersSet();
	}
	private void Result(ClassAssignment assignment, ChangeEventArgs args) => assignment.Result = args.Value.ToString();
	private async Task Sending()
	{
		for (int i = 0; i < Recives.Count; i++)
		{
			Recives[i].Result = assignments[i].Result;
		}
		await Send.InvokeAsync(Recives);
	}
}
