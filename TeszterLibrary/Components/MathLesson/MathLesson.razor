@using Microsoft.AspNetCore.Components.Web;
@using TeszterLibrary.ViewModel

<div class="feladat">
	@if (errorMessage.Length>0)
	{
		<h3 id="error">@errorMessage</h3><hr />
	}
	<form>@foreach (var item in s)
	{
		if (item.Contains(" = "))
		{
			<span>@((MarkupString)item) </span> 
			@if (IsFraction)
			{
			<div class="fraction">
				<input class="valasz" type="number" @bind-value="@szamlalo" autofocus @onkeyup="(e)=>Leutes(e)" />
					<svg height="5" width="100">
						<line x1="0" y1="0" x2="100" y2="0" style="stroke:rgb(0,0,0);stroke-width:3" />
					</svg>
				<input class="valasz" type="number" @bind-value="@nevezo" @onkeyup="(e)=>Leutes(e)" />
				</div>
			}
			else
			{
				<input class="valasz" type="text" @bind-value="@Assignment.Result" autofocus @onkeyup="(e)=>Leutes(e)" />
			}
		}
		else
		{
			@((MarkupString)item)
		}
	}
	@if (IsChecked)
	{
		if (IsCorrect)
		{
			<i id="right" class="oi oi-circle-check text-success d-inline-flex box"></i>
		}
		else
		{
			<i id="wrong" class="oi oi-circle-x text-end text-danger d-inline-flex box"></i>
		}
	}
	</form>
</div>
<button class="btn btn-success send" @onclick="@(()=>Sending())">Küldés</button>

@code
{
	[Parameter] public OperationView Assignment { get; set; } = new();
	[Parameter] public bool IsChecked { get; set; }
	[Parameter] public bool IsCorrect { get; set; }
	[Parameter] public bool IsFraction { get; set; }
	[Parameter] public EventCallback<OperationView> Send { get; set; }
	string[] s;
	string errorMessage = string.Empty;
	int szamlalo, nevezo;
	protected override void OnParametersSet()
	{
		s = Assignment.Sequence.Split('Ł');
	}
	private async Task Leutes(KeyboardEventArgs e)
	{
		if (e.Key=="Enter")
		{
			await Sending();
		}
	}
	private async Task Sending()
	{
			if (IsFraction)
			{
				if (nevezo != 0)
				{
					var result = $"{szamlalo}/{nevezo}";
					Assignment.Result = result;
				}
				else errorMessage = "Nevező nem lehet nulla!";
			}
			if (Assignment.Result.Length > 0)
			{
				await Send.InvokeAsync(Assignment);
			}
			else errorMessage = "Ne hagyd üresen a válasz mezőt!";
		
	}
}
