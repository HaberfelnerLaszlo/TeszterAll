@using Microsoft.AspNetCore.Components.Web;
@using TeszterLibrary.ViewModel

<div class="feladat">
	@if (errorMessage.Length>0)
	{
		<h3 id="error">@errorMessage</h3><hr />
	}
@* Enterre a böngésző az egymezős űrlapot natívan elküldené (oldal-újratöltés → új feladat): ezt letiltjuk, a küldést a
   keydown-kezelő (Leutes) végzi. A mezők minden leütésre frissülnek (oninput), így Enterkor már a beírt érték megy el;
   régen csak change-re frissültek, és az Enter hamarabb ért a szerverre, mint a beírt válasz. *@
<form @onsubmit:preventDefault="true">
    @foreach (var item in s)
    {
        if (item.Contains(" = "))
        {
            <span>@SafeHtml.MarkupWithSvg(item) </span>
            @if (Fraction)
            {
                <div class="fraction">
                    <input class="valasz" type="number" @bind-value="@szamlalo" @bind-value:event="oninput" autofocus @onkeydown="(e)=>Leutes(e)" />
                    <svg height="5" width="100">
                        <line x1="0" y1="0" x2="100" y2="0" style="stroke:rgb(0,0,0);stroke-width:3" />
                    </svg>
                    <input class="valasz" type="number" @bind-value="@nevezo" @bind-value:event="oninput" @onkeydown="(e)=>Leutes(e)" />
                </div>
            }
            else
            {
                <input class="valasz" type="text" @bind-value="@Assignment.Result" @bind-value:event="oninput" autofocus @onkeydown="(e)=>Leutes(e)" />
            }
        }
        else
        {
            @SafeHtml.MarkupWithSvg(item)
        }
    }
    @if (IsChecked)
    {
        if (IsCorrect)
        {
            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Checkmark())" Color="@Color.Success" />
        }
        else
        {
            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.DismissCircle())" Color="@Color.Error" />
        }
    }
</form>
</div>
<FluentButton Appearance="ButtonAppearance.Primary" Size="ButtonSize.Large" Class="send" IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Send())" Disabled="@(sending || IsChecked)" Loading="sending" OnClick="@(()=>Sending())">Küldés</FluentButton>

@code
{
	[Parameter] public OperationView Assignment { get; set; } = new();
	[Parameter] public bool IsChecked { get; set; }
	[Parameter] public bool IsCorrect { get; set; }
	[Parameter] public bool IsFraction { get; set; }
	[Parameter] public EventCallback<OperationView> Send { get; set; }
	string[] s = [];
	string errorMessage = string.Empty;
	int szamlalo, nevezo;
	int shownOperationId;
	bool sending;
	/// <summary>Törtes válasz kell: a lecke egésze (IsFraction) vagy csak ez a feladat (gyakorló tesztben vegyesen).</summary>
	bool Fraction => IsFraction || Assignment.IsFraction;
	protected override void OnParametersSet()
	{
		s = Assignment.Sequence.Split('Ł');
		if (Assignment.OperationId != shownOperationId)
		{
			// Új feladat: régen a törtmezők az előző válasszal maradtak kitöltve.
			shownOperationId = Assignment.OperationId;
			szamlalo = 0;
			nevezo = 0;
			errorMessage = string.Empty;
		}
	}
	private async Task Leutes(KeyboardEventArgs e)
	{
		if (e.Code=="Enter" || e.Code == "NumpadEnter")
		{
			await Sending();
		}
	}
	private async Task Sending()
	{
		// Ellenőrzés alatt (IsChecked) vagy küldés közben nem küld újra: régen Enterrel/gombbal duplán is ment.
		if (sending || IsChecked) return;
		if (Fraction)
		{
			if (nevezo == 0)
			{
				errorMessage = "Nevező nem lehet nulla!";
				return;
			}
			Assignment.Result = $"{szamlalo}/{nevezo}";
		}
		if (string.IsNullOrWhiteSpace(Assignment.Result))
		{
			errorMessage = "Ne hagyd üresen a válasz mezőt!";
			return;
		}
		errorMessage = string.Empty;
		sending = true;
		try
		{
			await Send.InvokeAsync(Assignment);
		}
		finally
		{
			sending = false;
		}
	}
}
