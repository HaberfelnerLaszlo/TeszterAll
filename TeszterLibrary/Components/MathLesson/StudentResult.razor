@* Egy tanuló feladatai: soronként a feladat, állapotsáv és eredmények. *@
<div class="result-list">
    @foreach (var item in studentViews)
    {
        var row = item;
        <button type="button" class="result-row status-@StatusKey(row.Status)" @onclick="() => Open(row.CompletTaskId)">
            <span class="result-row__main">
                <span class="result-row__name">@row.TaskName</span>
                <span class="result-row__sub">@StatusText(row.Status)@(row.Date > DateTime.MinValue ? ": " + row.Date.ToString("yyyy.MM.dd HH:mm") : "")</span>
            </span>
            <span class="result-row__meta">
                <span class="result-row__badges">
                    <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Success" Content="@($"Helyes: {row.Right}")" />
                    <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Danger" Content="@($"Hibás: {row.Wrong}")" />
                    <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Informative" Content="@($"Átlag: {row.AvgTime} mp")" />
                </span>
            </span>
        </button>
    }
</div>
@code {
	[Parameter] public List<ResultStudentView> studentViews { get; set; } = new();
	[Parameter] public EventCallback<int> Click { get; set; }
	private async Task Open(int id) => await Click.InvokeAsync(id);

	// Status: 0 folyamatban, 1 teljesítve, 2 visszalépett, 3 félbehagyta. Régen a félbehagyott is zöld (sikeres) volt.
	// Az állapot színét a CSS adja (status-progress / -done / -failed / -other).
	private static string StatusKey(byte status) => status switch
	{
		0 => "progress",
		1 => "done",
		2 => "failed",
		_ => "other",
	};
	private static string StatusText(byte status) => status switch
	{
		0 => "Folyamatban",
		1 => "Teljesítette",
		2 => "Visszalépett",
		_ => "Félbehagyta",
	};
}
