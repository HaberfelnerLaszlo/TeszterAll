@* Osztály eredménylista: tanulónként egy kattintható sor, bal oldalt állapotsávval. *@
<div class="result-list">
    @foreach (var item in classViews)
    {
        var row = item;
        <button type="button" class="result-row @RowClass(row)" @onclick="() => Open(row.StudentId)">
            <span class="result-row__main">
                <span class="result-row__name">@row.StudentName</span>
                <span class="result-row__sub">
                    @if (row.Total == 0)
                    {
                        <span>Nincs kiadott feladatsora</span>
                    }
                    else if (row.Position == 0)
                    {
                        <span>Minden leckét teljesített (@row.Total)</span>
                    }
                    else
                    {
                        <span>@row.Position. / @row.Total: @row.CurrentLesson @(row.InProgress ? "– épp oldja" : "")</span>
                    }
                </span>
            </span>
            <span class="result-row__meta">
                <span class="result-row__badges">
                    <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Success" Content="@($"Befejezve: {row.Complet}")" />
                    <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Danger" Content="@($"Visszalépés: {row.Back}")" />
                    <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Informative" Content="@($"Hátra: {row.NoComplet}")" />
                    @if (row.Abandoned > 0)
                    {
                        <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Subtle" Content="@($"Félbehagyva: {row.Abandoned}")" />
                    }
                </span>
                <span class="result-row__date">@ActiveText(row)</span>
            </span>
        </button>
    }
</div>
@code {
	[Parameter] public List<ResultClassView> classViews { get; set; } = new();
	[Parameter] public EventCallback<Guid> Click { get; set; }
	private async Task Open(Guid id)
	{
		await Click.InvokeAsync(id);
	}
	private static string ActiveText(ResultClassView item) => item.LastActive switch
	{
		null => "Még nem kezdte el",
		0 => "Ma aktív volt",
		var d => $"Aktív volt {d} napja",
	};
	/// <summary>Nincs feladatsora / még nem kezdte: szürke; kész: alap zöld.</summary>
	private static string RowClass(ResultClassView item) =>
		item.Total == 0 || item.LastActive is null ? "notStarted" : string.Empty;
}
