@* Osztály gyakorló feladatainak összeállítása: témakör (sor) × mértékegység-fajta (oszlop) mátrix.
   A feladat-azonosító: 62 + oszlop * 11 + sor (ugyanaz, mint a korábbi, kézzel kiírt táblázatban). *@
<div class="lesson-matrix">
    <div class="lesson-matrix__summary">
        <FluentText>Kiválasztott feladatok összesen:</FluentText>
        <FluentBadge Appearance="BadgeAppearance.Filled" Color="@(sum > 0 ? BadgeColor.Brand : BadgeColor.Subtle)" Content="@($"{sum} db")" />
    </div>

    <div class="lesson-matrix__scroll">
        <table class="lesson-matrix__table">
            <thead>
                <tr>
                    <th scope="col">Témakör</th>
                    @foreach (var col in Columns)
                    {
                        <th scope="col">@col</th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int r = 0; r < Rows.Length; r++)
                {
                    var row = r;
                    <tr>
                        <th scope="row">@Rows[row]</th>
                        @for (int c = 0; c < Columns.Length; c++)
                        {
                            var index = c * Rows.Length + row;
                            <td class="@(taskIds[index] > 0 ? "has-value" : null)">
                                <FluentNumberInput TValue="int" Value="@taskIds[index]" ValueChanged="@(v => SetCount(index, v))"
                                                   Min="0" Max="10" Width="72px"
                                                   aria-label="@($"{Rows[row]} – {Columns[c]}")" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="lesson-matrix__actions">
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Save())" OnClick="Save">Mentés</FluentButton>
    </div>
</div>

@code {
    [Parameter] public EventCallback<List<Model.ClassLesson>> SaveTask { get; set; }
    [Parameter] public List<Model.ClassLesson> Lessons { get; set; } = new();
    [Parameter] public Guid ClassId { get; set; }

    private const int FirstTaskId = 62;
    private const int MaxPerTask = 10;

    private static readonly string[] Rows =
    [
        "10 hatványaival egész",
        "Egész számokkal",
        "Egész számokkal 2 tag",
        "Egész számokkal valós eredmény",
        "Egész számokkal 2 tag valós eredmény",
        "Egész számokkal 3 tag valós eredmény",
        "10 hatványai valós eredmény",
        "10 hatványai 2 tag valós eredmény",
        "Tizedestört",
        "Tizedestört 2 tag",
        "Tizedestört 3 tag",
    ];

    private static readonly string[] Columns = ["Hosszúság", "Tömeg", "Űrmérték", "Terület", "Térfogat", "Térfogat, űr"];

    private readonly int[] taskIds = new int[Rows.Length * Columns.Length];
    private int sum;

    protected override void OnParametersSet()
    {
        Array.Clear(taskIds);
        if (Lessons is not null)
        {
            foreach (var item in Lessons)
            {
                var index = item.TaskId - FirstTaskId;
                if (index >= 0 && index < taskIds.Length)
                {
                    taskIds[index] = item.TaskCount;
                }
            }
        }
        sum = taskIds.Sum();
    }

    private void SetCount(int index, int value)
    {
        taskIds[index] = Math.Clamp(value, 0, MaxPerTask);
        sum = taskIds.Sum();
    }

    private async Task Save()
    {
        for (int i = 0; i < taskIds.Length; i++)
        {
            var lesson = Lessons.FirstOrDefault(l => l.TaskId == i + FirstTaskId);
            if (lesson != null)
            {
                lesson.TaskCount = (byte)taskIds[i];
            }
            else if (taskIds[i] > 0)
            {
                Lessons.Add(new() { TaskId = i + FirstTaskId, TaskCount = (byte)taskIds[i], ClassId = ClassId });
            }
        }
        await SaveTask.InvokeAsync(Lessons);
    }
}
