<table class="data-table">
	<thead>
	<tr>
		<th>Időpont</th>
		<th>Feladat</th>
		<th>Ráfordított idő</th>
		<th>Válasz</th>
		<th>Helyes?</th>
		<th>Választotta?</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in taskViews)
		{
		<tr>
			<td>@item.TimeStamp</td>
			<td>@item.Sequence.Replace('#',' ')</td>
			<td>@item.Time mp</td>
			<td>@item.Answer @if (!item.IsCorrect)
					{
						<span>/ @item.Outcome</span>
					}
			</td>
			<td>
			@if (item.IsCorrect)
			{
				<FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.CheckmarkCircle())" Color="Color.Success" Title="Helyes" />
			}
			else
			{
				<FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.DismissCircle())" Color="Color.Error" Title="Hibás" />
			}
			</td>
			<td>@(item.IsTipp? "Igen": "Nem")</td>
		</tr>
		}
	</tbody>
</table>
@code {
	[Parameter] public List<ResultTaskView> taskViews { get; set; } = new();
}
