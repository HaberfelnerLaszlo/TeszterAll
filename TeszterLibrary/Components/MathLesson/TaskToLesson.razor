@using TeszterLibrary.Model;
@using TeszterLibrary.Components;
@inject IDialogService dialogService
@inject IToastService toastService
@if (lessons.Count > 0)
{
    <button class="btn btn-primary" @onclick="()=>SaveLesson.InvokeAsync(Lessons)">@Name feladatlistájának mentése</button>
}
else
{
    <p>@Name feladatlistájának szerkesztése</p>
}
<hr />
<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="20">
    <FluentStack Orientation="Orientation.Vertical">
        <FluentSelect Items="topics" TOption="string" Title="Kategóriák: " SelectedOptionChanged="(e)=>Select(e)" />

        <h5>Feladatok listája</h5>
        <FluentSortableList Id="sharedTask1" Class="darker" Group="sharedTaskLists" OnUpdate="@SortList1" OnRemove="@List1Remove" Items="@filteredTasks" Context="topic" Style="height:400px; overflow-y:auto;">
            <ItemTemplate>@topic.Description</ItemTemplate>
        </FluentSortableList>
    </FluentStack>
    <FluentStack Orientation="Orientation.Vertical">
        <h5>A tanuló feladatai:</h5>
        @if (completLessons.Count > 0)
        {
            <FluentListbox Items="completLessons" />
        }
        <FluentSortableList Id="sharedTask2" Group="sharedTaskLists" OnUpdate="@SortList2" OnRemove="@List2Remove" Items="@lessons" Context="lesson" Drop="IsLessonSave">
            <ItemTemplate>@lesson.Description</ItemTemplate>
        </FluentSortableList>
    </FluentStack>
</FluentStack>

@code {
    [Parameter] public List<TaskList> TaskList { get; set; } = new();
    [Parameter] public List<Lesson> Lessons { get; set; } = new();
    [Parameter] public Guid StudentId { get; set; }
    [Parameter] public string Name { get; set; } = "Tanuló";
    [Parameter] public EventCallback<List<Lesson>> SaveLesson { get; set; }
    private List<ListTask> listTasks = new();
    private List<ListTask> filteredTasks = new();
    private List<ListTask> lessons = new();
    private List<ListTask> completLessons = new();
    private ListTask lastdropped { get; set; } = new();
    private Sablon sablon = new();
    private bool IsLessonSave = true;
    private List<string> topics = new();
    private bool tipp = false;
    protected override void OnParametersSet()
    {
        lessons.Clear();
        completLessons.Clear();
        if (!listTasks.Any())
        {
            foreach (var item in TaskList)
            {
                listTasks.Add(new() { Id = item.Id, Description = item.Description, Sablon = item.Sablon, Topic = item.Topic, HasCompleted = false });
                if (!topics.Contains(item.Topic)) topics.Add(item.Topic);
            }
            filteredTasks = listTasks.Where(t => t.Topic == topics.First()).ToList();
        }
        if (Lessons != null && Lessons.Count > 0)
        {
            foreach (var item in Lessons)
            {
                var t = TaskList.First(l => l.Id == item.TaskId);
                if (t is not null && t.Sablon != null)
                {
                    if (item.IsCompleted)
                    {
                        completLessons.Add(new() { Id = t.Id, Description = t.Description, HasCompleted = item.IsCompleted, Sablon = t.Sablon, Topic = t.Topic });
                    }
                    else
                    {
                        lessons.Add(new() { Id = t.Id, Description = t.Description, HasCompleted = item.IsCompleted, Sablon = t.Sablon, Topic = t.Topic });
                    }
                }
            }
        }
    }
    private bool AcceptTask(ListTask task)
    {
        return !task.HasCompleted;
    }
    private void Save()
    {
        if (Guid.Empty==StudentId || lastdropped.Id<=0 )
        {
            toastService.ShowError("Nem sikerült a mentés,mert az utolsó elem nem lett mentve.");
            return;
        }
        Lesson lesson = new() { IsTipp = tipp, MaxCount = Convert.ToByte(sablon.MaxCount), MinCount = Convert.ToByte(sablon.MinCount), StudentId = StudentId, TaskId = lastdropped.Id, Time = sablon.Time, WrongCount = Convert.ToByte(sablon.WrongCount), WrongPercent = Convert.ToByte(sablon.WrongPercent) };
        Lessons.Add(lesson);
        toastService.ShowSuccess("A feladat sikeresen hozzáadva.");
        IsLessonSave = true;
    }
    private bool Select(string e)
    {
        if (!string.IsNullOrEmpty(e))
        {
            filteredTasks = listTasks.Where(t => t.Topic == e).ToList();
            StateHasChanged();
            return true;
        }
        return false;
    }
    private record ListTask()
    {
        public int Id { get; set; }
        public string Description { get; set; } = string.Empty;
        public bool HasCompleted { get; set; }
        public string Topic { get; set; } = string.Empty;
        public Sablon Sablon = new();
    }
    private async void List1Remove(FluentSortableListEventArgs args)
    {
        if (args is null)
        {
            return;
        }

        // get the item at the old index in list 1
        var item = filteredTasks[args.OldIndex];

        sablon = item.Sablon;
        IsLessonSave = false;
        var dialog = await dialogService.ShowDialogAsync<SetTaskSablonDialog>(sablon, new DialogParameters()
        {
            //Height = "340px",
            Title = $"{item.Topic} beállítása",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
        });
        lastdropped = item;

        var result = await dialog.Result;
        if (!result.Cancelled && result.Data != null)
        {
            sablon = (Sablon)result.Data;
            Save();
        }
        else if (result.Cancelled || result.Data is null)
        {
            toastService.ShowWarning("Nem sikerült a feladat áthelyezése.");
            return;
        }
        // add it to the new index in list 2
        lessons.Insert(args.NewIndex, item);
        // remove the item from the old index in list 1
        filteredTasks.Remove(filteredTasks[args.OldIndex]);
        StateHasChanged();
    }

    private void List2Remove(FluentSortableListEventArgs args)
    {
        if (args is null)
        {
            return;
        }
        // get the item at the old index in list 2
        var item = lessons[args.OldIndex];
        var lesson = Lessons.First(l => l.TaskId == item.Id);
        if (lesson is null)
        {
            toastService.ShowError("Hiba történt nem található a feladat.");
            return;
        }
        Lessons.Remove(lesson);
        // add it to the new index in list 1
        filteredTasks.Insert(args.NewIndex, item);

        // remove the item from the old index in list 2
        lessons.Remove(lessons[args.OldIndex]);
    }
    private void SortList1(FluentSortableListEventArgs args)
    {
        if (args is null || args.OldIndex == args.NewIndex)
        {
            return;
        }

        var oldIndex = args.OldIndex;
        var newIndex = args.NewIndex;

        var items = this.filteredTasks;
        var itemToMove = items[oldIndex];
        items.RemoveAt(oldIndex);

        if (newIndex < items.Count)
        {
            items.Insert(newIndex, itemToMove);
        }
        else
        {
            items.Add(itemToMove);
        }
    }

    private void SortList2(FluentSortableListEventArgs args)
    {
        if (args is null || args.OldIndex == args.NewIndex)
        {
            return;
        }

        var oldIndex = args.OldIndex;
        var newIndex = args.NewIndex;

        var items = this.lessons;
        var itemToMove = items[oldIndex];
        items.RemoveAt(oldIndex);

        if (newIndex < items.Count)
        {
            items.Insert(newIndex, itemToMove);
        }
        else
        {
            items.Add(itemToMove);
        }
    }

}
