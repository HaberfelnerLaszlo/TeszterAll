<button type="button" class="btn btn-success text-center" @onclick="Save">Mentés</button>
@code {
	[Parameter] public EventCallback<List<Lesson>> SaveTask { get; set; }
	[Parameter] public List<Lesson> Lessons { get; set; } = new();
	[Parameter] public Guid ClassId { get; set; }
	byte[] taskIds = new byte[100];
	byte sum = 0;
	protected override void OnParametersSet()
	{
		for (int i = 0; i < taskIds.Length; i++)
		{
			taskIds[i] = 0;
		}
		sum = 0;
		if (Lessons is not null)
		{
			foreach (var item in Lessons) //TODO null ellenőrzés
			{
				taskIds[item.TaskId - 62] = item.MaxCount;
				sum += item.MaxCount;
			}
		}
	}
	private void Save()
	{
		for (int i = 0; i < taskIds.Length; i++)
		{
			var lesson = Lessons.FirstOrDefault(l => l.TaskId == i + 62);
			if (lesson != null)
			{
				if (taskIds[i] == 0)
				{
					lesson.MaxCount = 0;
					lesson.IsCompleted = true;
				}
				else
				{
					lesson.MaxCount = taskIds[i];
					lesson.IsCompleted = false;
				}
			}
			else if (taskIds[i]>0)
			{
				Lessons.Add(new() { TaskId = i + 62, MaxCount = taskIds[i], StudentId=ClassId });
			}
		}
		SaveTask.InvokeAsync(Lessons);
	}
	void InputChange(int index)
	{
		sum = 0;
		for (int i = 0; i < taskIds.Length; i++)
		{
			if (taskIds[i]!=0)
			{
				sum += taskIds[i];
			}
		}
	}
	private string StyleForNumber(byte n)
	{
		if (n > 0) return "background:lightgreen";
		return "";
	}
}
