    private async Task<string> SaveImage(string base64Data)
    {
        string filePath = string.Empty;
        try
        {
            var base64 = base64Data.Substring(base64Data.IndexOf(",") + 1);
            var bytes = Convert.FromBase64String(base64);
            var fileName = Guid.NewGuid().ToString() + ".png";
            if (!String.IsNullOrEmpty(folderId))
            {
                filePath = await graphService.UploadFileToFolder(bytes, fileName, folderId, driveId);
                toastService.ShowSuccess("Kép sikeresen feltöltve a Onedrive-ba!");
            }
            else
            {
                toastService.ShowError("Hiba a képfeltöltés során!");
                filePath = Path.Combine(Environment.WebRootPath, "uploads", fileName);
                await File.WriteAllBytesAsync(filePath, bytes);
                toastService.ShowSuccess("Kép sikeresen feltöltve a szerverre!");
            }
            var image = new Image
            {
                FilePath = filePath,
                FileName = fileName,
                UploadDate = DateTime.Now
            };
            return filePath;
        }
        catch (Exception)
        {
            toastService.ShowError("Hiba a kép mentése során!");
            return string.Empty;
        }
    }

    private async Task CancelAsync()
    {
        await Dialog.CancelAsync();
    }
