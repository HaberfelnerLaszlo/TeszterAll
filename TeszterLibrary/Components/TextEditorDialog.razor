@using Blazored.TextEditor
@using TeszterLibrary.Services.Images
@inject IImageStorage ImageStorage
@inject IToastService toastService

<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentText As="TextTag.H3" Size="TextSize.Size600" Weight="TextWeight.Semibold">
                @Dialog.Options.Header.Title
            </FluentText>
        </FluentStack>
    </TitleTemplate>
    <ChildContent>
        @if (!hide)
        {
            <BlazoredTextEditor @ref="textEditor" DebugLevel="warn" EditorCssStyle="width:100%; height:auto;">
            <ToolbarContent>
                <span class="ql-formats">
                    <button class="ql-bold"></button>
                    <button class="ql-italic"></button>
                    <button class="ql-underline"></button>
                    <button class="ql-image"></button>
                </span>
            </ToolbarContent>
            <EditorContent>
               @SafeHtml.Markup(Content)
            </EditorContent>
            </BlazoredTextEditor>
        }
    </ChildContent>
    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@SaveAsync">Mentés</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Default" OnClick="@CancelAsync">Mégsem</FluentButton>
    </ActionTemplate>
</FluentDialogBody>

@code {
    [Parameter]
    public string Content { get; set; } = default!;

    [CascadingParameter]
    public IDialogInstance Dialog { get; set; } = default!;
    private BlazoredTextEditor textEditor = new();
    bool hide = false;

    private async Task SaveAsync()
    {
        try
        {
            var html = await textEditor.GetHTML();
            // A szerver megtisztítja a HTML-t, a beillesztett képeket ellenőrzi és fájlba menti.
            var result = await ImageStorage.ProcessEditorHtmlAsync(html);
            foreach (var warning in result.Warnings.Take(3)) toastService.ShowError(warning);
            if (result.IsRejected) return;          // a párbeszéd nyitva marad, a felhasználó javíthat

            Content = result.Html;
            await Dialog.CloseAsync(Content);
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Hiba történt: {ex.Message}");
        }
    }

    private async Task CancelAsync()
    {
        await Dialog.CancelAsync();
    }
}
